}

func utf16Filter(parts ...string) []uint16 {
	out := make([]uint16, 0, 128)
	for _, part := range parts {
		u, _ := syscall.UTF16FromString(part)
		out = append(out, u...)
	}
	// OPENFILENAME filters end with an extra NUL.
	out = append(out, 0)
	return out
}

func browseForFile(title string, filter []uint16, defExt, current string) (string, bool) {
	buf := make([]uint16, 32768)
	cur := strings.Trim(strings.TrimSpace(current), `"`)
	if cur != "" {
		u, _ := syscall.UTF16FromString(cur)
		if len(u) < len(buf) {
			copy(buf, u)
		}
	}
	of := openFileNameW{
		HwndOwner: hwndMain,
		LpstrFile: &buf[0],
		NMaxFile:  uint32(len(buf)),
		Flags:     OFN_PATHMUSTEXIST | OFN_FILEMUSTEXIST | OFN_EXPLORER,
	}
	of.LStructSize = uint32(unsafe.Sizeof(of))
	if len(filter) > 0 {
		of.LpstrFilter = &filter[0]
	}
	if title != "" {
		of.LpstrTitle = utf16(title)
	}
	if defExt != "" {
		of.LpstrDefExt = utf16(defExt)
	}
	r, _, _ := procGetOpenFileNameW.Call(uintptr(unsafe.Pointer(&of)))
	if r == 0 {
		return "", false
	}
	return syscall.UTF16ToString(buf), true
}

func browseQemu() {
	filter := utf16Filter("QEMU executable (*.exe)", "*.exe", "All files (*.*)", "*.*")
	if p, ok := browseForFile("Select qemu-system-arm.exe", filter, "exe", getText(edtQemu)); ok {
		setText(edtQemu, p)
		scrollEditToEnd(edtQemu)
		setText(lblRunState, "State    QEMU path selected")
