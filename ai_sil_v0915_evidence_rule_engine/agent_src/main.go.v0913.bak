type testCase struct {
	Target string `json:"target"`
	Pin    string `json:"pin"`
	Fault  string `json:"fault"`
}

// aiTestPlan is the only object the LLM is allowed to produce for execution.
// The Workbench validates every field before compiling it into fixed MSH commands.
type aiTestPlan struct {
	Version             string       `json:"version"`
	Route               string       `json:"route"`
	RequestedDriver     string       `json:"requested_driver"`
	RequestedCapability string       `json:"requested_capability"`
	Reason              string       `json:"reason"`
	Driver              string       `json:"driver"`
	Target              string       `json:"target"`
	Cases               []aiPlanCase `json:"cases"`
}

type aiPlanCase struct {
	ID          string `json:"id"`
	Fault       string `json:"fault"`
	Expected    string `json:"expected"`
	Description string `json:"description"`
}

type aiPlanRunRow struct {
	Case          aiPlanCase `json:"case"`
	Result        gpioResult `json:"result"`
	Timeout       bool       `json:"timeout"`
	ProtocolError string     `json:"protocol_error,omitempty"`
}

type matrixViewRow struct {
	CaseID     string
	Fault      string
	Observed   string
	Expected   string
	Detection  string
	CaseResult string
	Headline   string
	Detail     string
}

type aiDiagnosis struct {
	Summary           string   `json:"summary"`
	Evidence          []string `json:"evidence"`
	SuspectedLayer    string   `json:"suspected_layer"`
	PossibleCauses    []string `json:"possible_causes"`
	RecommendedChecks []string `json:"recommended_checks"`
}

// aiSILCodeBundle is a constrained code-generation package produced by the
// connected AI provider. The Workbench never lets the model choose arbitrary
// destination paths: file names are validated and materialized only under
// applications/ plus a source-of-truth copy in .ai_sil/generated/.
type aiSILGeneratedFile struct {
	Name    string `json:"name"`
	Content string `json:"content"`
}

type aiSILCodeBundle struct {
	Version      string               `json:"version"`
	Driver       string               `json:"driver"`
	Capability   string               `json:"capability"`
	Summary      string               `json:"summary"`
	TestCommand  string               `json:"test_command"`
	SmokeCommand string               `json:"smoke_command"`
	Scenarios    []string             `json:"scenarios"`
	Files        []aiSILGeneratedFile `json:"files"`
}

