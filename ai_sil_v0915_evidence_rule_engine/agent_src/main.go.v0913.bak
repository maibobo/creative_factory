	if mcu == "" || mcu == "unknown" {
		mcu = "STM32F407"
	}
	tmpl := `#include <rtthread.h>
#include <finsh.h>
#include "ai_sil_gpio_backend.h"

static int sil_ping(int argc, char **argv)
{
