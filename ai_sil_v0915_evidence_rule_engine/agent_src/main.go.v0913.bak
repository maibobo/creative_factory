func main() {
	// Win32 windows and their message queues are owned by the OS thread that creates them.
	// Keep the Go main goroutine permanently pinned to one OS thread for the entire GUI lifetime.
	runtime.LockOSThread()
	defer runtime.UnlockOSThread()
	hInst, _, _ := procGetModuleHandleW.Call(0)
	cur, _, _ := procLoadCursorW.Call(0, IDC_ARROW)
	hBrushBg, _, _ = procCreateSolidBrush.Call(uintptr(colorRef(244, 247, 251)))
	hBrushWhite, _, _ = procCreateSolidBrush.Call(uintptr(colorRef(255, 255, 255)))
	hBrushSidebar, _, _ = procCreateSolidBrush.Call(uintptr(colorRef(17, 39, 65)))
	hBrushSidebarActive, _, _ = procCreateSolidBrush.Call(uintptr(colorRef(31, 65, 96)))
	hBrushSoft, _, _ = procCreateSolidBrush.Call(uintptr(colorRef(239, 244, 251)))
	hBrushSuccess, _, _ = procCreateSolidBrush.Call(uintptr(colorRef(229, 248, 239)))
	hBrushWarn, _, _ = procCreateSolidBrush.Call(uintptr(colorRef(255, 246, 231)))
	hBrushConsole, _, _ = procCreateSolidBrush.Call(uintptr(colorRef(17, 24, 39)))
	hBrushField, _, _ = procCreateSolidBrush.Call(uintptr(colorRef(255, 255, 255)))
	hBrushAccentSoft, _, _ = procCreateSolidBrush.Call(uintptr(colorRef(239, 245, 255)))
	hBrushDangerSoft, _, _ = procCreateSolidBrush.Call(uintptr(colorRef(255, 245, 245)))
	cls := utf16(className)
	wc := wndClassEx{CbSize: uint32(unsafe.Sizeof(wndClassEx{})), LpfnWndProc: syscall.NewCallback(wndProc), HInstance: syscall.Handle(hInst), HCursor: syscall.Handle(cur), HbrBackground: syscall.Handle(hBrushBg), LpszClassName: cls}
	if r, _, _ := procRegisterClassExW.Call(uintptr(unsafe.Pointer(&wc))); r == 0 {
		return
	}
	settingsCls := utf16(settingsClassName)
	settingsWC := wndClassEx{CbSize: uint32(unsafe.Sizeof(wndClassEx{})), LpfnWndProc: syscall.NewCallback(settingsWndProc), HInstance: syscall.Handle(hInst), HCursor: syscall.Handle(cur), HbrBackground: syscall.Handle(hBrushWhite), LpszClassName: settingsCls}
	if r, _, _ := procRegisterClassExW.Call(uintptr(unsafe.Pointer(&settingsWC))); r == 0 {
		return
	}
	fontHeight := int32(-15)
	titleHeight := int32(-29)
	sectionHeight := int32(-18)
	smallHeight := int32(-13)
	monoHeight := int32(-14)
	hFont, _, _ = procCreateFontW.Call(uintptr(uint32(fontHeight)), 0, 0, 0, 400, 0, 0, 0, 1, 0, 0, 0, 0, uintptr(unsafe.Pointer(utf16("Microsoft YaHei UI"))))
	hFontTitle, _, _ = procCreateFontW.Call(uintptr(uint32(titleHeight)), 0, 0, 0, 600, 0, 0, 0, 1, 0, 0, 0, 0, uintptr(unsafe.Pointer(utf16("Microsoft YaHei UI"))))
	hFontSection, _, _ = procCreateFontW.Call(uintptr(uint32(sectionHeight)), 0, 0, 0, 600, 0, 0, 0, 1, 0, 0, 0, 0, uintptr(unsafe.Pointer(utf16("Microsoft YaHei UI"))))
	hFontSmall, _, _ = procCreateFontW.Call(uintptr(uint32(smallHeight)), 0, 0, 0, 400, 0, 0, 0, 1, 0, 0, 0, 0, uintptr(unsafe.Pointer(utf16("Microsoft YaHei UI"))))
	hFontMono, _, _ = procCreateFontW.Call(uintptr(uint32(monoHeight)), 0, 0, 0, 400, 0, 0, 0, 1, 0, 0, 0, 0, uintptr(unsafe.Pointer(utf16("Cascadia Mono"))))
	style := uintptr(WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME)
	hwnd, _, _ := procCreateWindowExW.Call(0, uintptr(unsafe.Pointer(cls)), uintptr(unsafe.Pointer(utf16(appTitle))), style, CW_USEDEFAULT, CW_USEDEFAULT, 1495, 990, 0, 0, hInst, 0)
	if hwnd == 0 {
		return
	}
	hwndMain = hwnd
	buildUI()
	layoutReady = true
	procShowWindow.Call(hwndMain, SW_SHOW)
	procUpdateWindow.Call(hwndMain)
	var m msg
	for {
		r, _, _ := procGetMessageW.Call(uintptr(unsafe.Pointer(&m)), 0, 0, 0)
		if int32(r) <= 0 {
			break
		}
		procTranslateMessage.Call(uintptr(unsafe.Pointer(&m)))
		procDispatchMessageW.Call(uintptr(unsafe.Pointer(&m)))
	}
}
