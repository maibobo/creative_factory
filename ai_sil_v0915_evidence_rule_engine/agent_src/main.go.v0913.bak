func utf16(s string) *uint16  { p, _ := syscall.UTF16PtrFromString(s); return p }
func loword(v uintptr) uint16 { return uint16(v & 0xffff) }
func hiword(v uintptr) uint16 { return uint16((v >> 16) & 0xffff) }

func colorRef(r, g, b byte) uint32 { return uint32(r) | uint32(g)<<8 | uint32(b)<<16 }

type controlTheme struct {
	fg    uint32
	bg    uint32
	brush uintptr
}

var controlThemes = map[uintptr]controlTheme{}

func themeControl(hwnd uintptr, fg, bg uint32, brush uintptr) uintptr {
	if hwnd != 0 {
		controlThemes[hwnd] = controlTheme{fg: fg, bg: bg, brush: brush}
	}
	return hwnd
}

func roundControl(hwnd uintptr, w, h, radius int32) {
	if hwnd == 0 || w <= 0 || h <= 0 || radius <= 0 {
		return
	}
	rgn, _, _ := procCreateRoundRectRgn.Call(0, 0, uintptr(w+1), uintptr(h+1), uintptr(radius), uintptr(radius))
	if rgn != 0 {
		procSetWindowRgn.Call(hwnd, rgn, 1)
	}
}

func rememberRounded(hwnd uintptr, w, h, radius int32) {
	if hwnd == 0 {
		return
	}
	roundedControls[hwnd] = radius
	roundControl(hwnd, w, h, radius)
}

func modernizeNativeControl(hwnd uintptr, kind string, w, h int32) {
	if hwnd == 0 {
		return
	}
	// Explorer theme removes much of the legacy beveling while retaining native DPI/input behavior.
	procSetWindowTheme.Call(hwnd, uintptr(unsafe.Pointer(utf16("Explorer"))), 0)
	switch kind {
	case "edit":
		procSendMessageW.Call(hwnd, EM_SETMARGINS, EC_LEFTMARGIN|EC_RIGHTMARGIN, uintptr(8|(8<<16)))
		rememberRounded(hwnd, w, h, 8)
	case "list":
		rememberRounded(hwnd, w, h, 8)
	case "combo":
		rememberRounded(hwnd, w, 28, 7)
	}
}

func panel(x, y, w, h int32, bg uint32, brush uintptr) uintptr {
	ctl := createControl("STATIC", "", SS_LEFT, x, y, w, h, 0)
	ctl = themeControl(ctl, bg, bg, brush)
	// White workspace surfaces are cards. The navigation rail remains square.
	if x >= layoutContentLeft && bg == colorRef(255, 255, 255) {
		rememberRounded(ctl, w, h, 12)
	}
	return ctl
}

func themedLabel(text string, x, y, w, h int32, fg, bg uint32, brush uintptr) uintptr {
	ctl := label(text, x, y, w, h)
	return themeControl(ctl, fg, bg, brush)
}

func themedSmallLabel(text string, x, y, w, h int32, fg, bg uint32, brush uintptr) uintptr {
	ctl := smallLabel(text, x, y, w, h)
	return themeControl(ctl, fg, bg, brush)
}

func createControl(class, text string, style uint32, x, y, w, h int32, id int) uintptr {
	hwnd, _, _ := procCreateWindowExW.Call(0,
		uintptr(unsafe.Pointer(utf16(class))), uintptr(unsafe.Pointer(utf16(text))),
		uintptr(style|WS_CHILD|WS_VISIBLE), uintptr(x), uintptr(y), uintptr(w), uintptr(h),
		hwndMain, uintptr(id), 0, 0)
	if hFont != 0 {
		procSendMessageW.Call(hwnd, WM_SETFONT, hFont, 1)
	}
	if hwnd != 0 {
		layoutMu.Lock()
		layoutItems = append(layoutItems, layoutItem{hwnd: hwnd, x: x, y: y, w: w, h: h})
		layoutMu.Unlock()
	}
	return hwnd
}

func createControlOn(parent uintptr, class, text string, style uint32, x, y, w, h int32, id int) uintptr {
	hwnd, _, _ := procCreateWindowExW.Call(0,
		uintptr(unsafe.Pointer(utf16(class))), uintptr(unsafe.Pointer(utf16(text))),
		uintptr(style|WS_CHILD|WS_VISIBLE), uintptr(x), uintptr(y), uintptr(w), uintptr(h),
		parent, uintptr(id), 0, 0)
	if hFont != 0 {
		procSendMessageW.Call(hwnd, WM_SETFONT, hFont, 1)
	}
	return hwnd
}

func settingsLabel(parent uintptr, text string, x, y, w, h int32, small bool) uintptr {
	ctl := createControlOn(parent, "STATIC", text, SS_LEFT, x, y, w, h, 0)
	if small {
		setControlFont(ctl, hFontSmall)
	}
	return themeControl(ctl, colorRef(21, 34, 54), colorRef(255, 255, 255), hBrushWhite)
}

func settingsEdit(parent uintptr, text string, x, y, w, h int32, password bool) uintptr {
	style := uint32(WS_BORDER | ES_LEFT | ES_AUTOHSCROLL)
	if password {
		style |= ES_PASSWORD
	}
	ctl := createControlOn(parent, "EDIT", text, style, x, y, w, h, 0)
	themeControl(ctl, colorRef(25, 39, 62), colorRef(255, 255, 255), hBrushField)
	modernizeNativeControl(ctl, "edit", w, h)
	return ctl
}

