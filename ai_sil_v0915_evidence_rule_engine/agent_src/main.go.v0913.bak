func drawModernButton(dis *drawItemStruct) uintptr {
	if dis == nil || dis.HwndItem == 0 {
		return 0
	}
	v := buttonVisuals[dis.HwndItem]
	bg := colorRef(255, 255, 255)
	border := colorRef(215, 222, 232)
	fg := colorRef(45, 58, 78)
	switch v.Kind {
	case "primary":
		bg, border, fg = colorRef(37, 99, 235), colorRef(37, 99, 235), colorRef(255, 255, 255)
	case "danger":
		bg, border, fg = colorRef(255, 245, 245), colorRef(244, 201, 201), colorRef(190, 45, 45)
	case "tab-active":
		bg, border, fg = colorRef(238, 244, 255), colorRef(187, 207, 248), colorRef(37, 99, 235)
	case "ghost":
		bg, border, fg = colorRef(248, 250, 253), colorRef(230, 234, 241), colorRef(78, 92, 112)
	}
	if dis.ItemState&ODS_DISABLED != 0 {
		bg, border, fg = colorRef(245, 247, 250), colorRef(231, 235, 241), colorRef(155, 164, 177)
	} else if dis.ItemState&ODS_SELECTED != 0 {
		if v.Kind == "primary" {
			bg = colorRef(29, 78, 216)
		} else {
			bg = colorRef(238, 242, 247)
		}
	}
	brush, _, _ := procCreateSolidBrush.Call(uintptr(bg))
	pen, _, _ := procCreatePen.Call(PS_SOLID, 1, uintptr(border))
	oldBrush, _, _ := procSelectObject.Call(dis.HDC, brush)
	oldPen, _, _ := procSelectObject.Call(dis.HDC, pen)
	procRoundRect.Call(dis.HDC, uintptr(dis.RcItem.Left), uintptr(dis.RcItem.Top), uintptr(dis.RcItem.Right), uintptr(dis.RcItem.Bottom), 12, 12)
	procSelectObject.Call(dis.HDC, oldBrush)
	procSelectObject.Call(dis.HDC, oldPen)
	procDeleteObject.Call(brush)
	procDeleteObject.Call(pen)
	procSetBkMode.Call(dis.HDC, TRANSPARENT)
	procSetTextColor.Call(dis.HDC, uintptr(fg))
	if hFont != 0 {
		old, _, _ := procSelectObject.Call(dis.HDC, hFont)
		defer procSelectObject.Call(dis.HDC, old)
	}
	text := utf16(getText(dis.HwndItem))
	rc := dis.RcItem
	procDrawTextW.Call(dis.HDC, uintptr(unsafe.Pointer(text)), ^uintptr(0), uintptr(unsafe.Pointer(&rc)), DT_CENTER|DT_VCENTER|DT_SINGLELINE)
	return 1
}
