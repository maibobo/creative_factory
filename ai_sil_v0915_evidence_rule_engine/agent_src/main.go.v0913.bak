func browseForFolder(title string) (string, bool) {
	// BIF_RETURNONLYFSDIRS | BIF_NEWDIALOGSTYLE
	const flags = 0x00000001 | 0x00000040
	display := make([]uint16, 260)
	bi := browseInfoW{
		HwndOwner:      hwndMain,
		PszDisplayName: &display[0],
		LpszTitle:      utf16(title),
		UlFlags:        flags,
	}
	pidl, _, _ := procSHBrowseForFolderW.Call(uintptr(unsafe.Pointer(&bi)))
	if pidl == 0 {
		return "", false
	}
	defer procCoTaskMemFree.Call(pidl)
	pathBuf := make([]uint16, 32768)
	ok, _, _ := procSHGetPathFromIDListW.Call(pidl, uintptr(unsafe.Pointer(&pathBuf[0])))
	if ok == 0 {
		return "", false
	}
	return syscall.UTF16ToString(pathBuf), true
}

func browseProject() {
	if p, ok := browseForFolder("Select RT-Thread Project Folder"); ok {
		root := p
		if r, found := findProjectRoot(root); found {
			root = r
		}
		setText(edtProject, root)
		scrollEditToEnd(edtProject)
		setText(lblRunState, "State    Project folder selected")
	}
}

func fileText(path string) string {
	b, err := os.ReadFile(path)
	if err != nil {
		return ""
	}
	return string(b)
}

func fileExists(path string) bool {
	st, err := os.Stat(path)
	return err == nil && !st.IsDir()
}

func dirExists(path string) bool {
	st, err := os.Stat(path)
	return err == nil && st.IsDir()
}

func findProjectRoot(input string) (string, bool) {
	p := strings.TrimSpace(strings.Trim(input, `"`))
	if p == "" {
		return "", false
	}
	if st, err := os.Stat(p); err == nil && !st.IsDir() {
		p = filepath.Dir(p)
	}
	abs, err := filepath.Abs(p)
	if err == nil {
		p = abs
	}
	for i := 0; i < 7; i++ {
		if fileExists(filepath.Join(p, "rtconfig.h")) && (fileExists(filepath.Join(p, "SConstruct")) || fileExists(filepath.Join(p, ".project"))) {
			return p, true
		}
		next := filepath.Dir(p)
		if next == p {
			break
		}
		p = next
	}
	return "", false
}

func uniqueStrings(in []string) []string {
	seen := map[string]bool{}
	out := []string{}
	for _, v := range in {
		if v != "" && !seen[v] {
			seen[v] = true
			out = append(out, v)
		}
	}
	return out
}

func detectProject(root string) (projectContext, error) {
	root, ok := findProjectRoot(root)
	if !ok {
		return projectContext{}, fmt.Errorf("not an RT-Thread project: rtconfig.h + SConstruct/.project were not found")
	}
	ctx := projectContext{Root: root, ProjectName: filepath.Base(root), MCU: "unknown", RTThread: "unknown", QemuMachine: "stm32f407-atk-explorer"}

	projcfg := fileText(filepath.Join(root, ".settings", "projcfg.ini"))
	for _, line := range strings.Split(projcfg, "\n") {
		line = strings.TrimSpace(line)
		if strings.HasPrefix(line, "chip_name=") {
			ctx.MCU = strings.TrimSpace(strings.TrimPrefix(line, "chip_name="))
		}
		if strings.HasPrefix(line, "selected_rtt_version=") {
			ctx.RTThread = strings.TrimSpace(strings.TrimPrefix(line, "selected_rtt_version="))
		}
		if strings.HasPrefix(line, "qemu_supported_board=") {
			ctx.QemuMachine = strings.TrimSpace(strings.TrimPrefix(line, "qemu_supported_board="))
		}
		if strings.HasPrefix(line, "project_name=") {
			ctx.ProjectName = strings.TrimSpace(strings.TrimPrefix(line, "project_name="))
		}
	}

	if ctx.MCU == "unknown" {
		cp := fileText(filepath.Join(root, ".cproject"))
		re := regexp.MustCompile(`STM32F407[A-Za-z0-9_]*`)
		if m := re.FindString(cp); m != "" {
			ctx.MCU = strings.TrimSuffix(m, "xx")
		}
	}

	rtcfg := fileText(filepath.Join(root, "rtconfig.h"))
	ctx.MSHEnabled = strings.Contains(rtcfg, "#define RT_USING_FINSH") && strings.Contains(rtcfg, "#define FINSH_USING_MSH")
	ctx.PinEnabled = strings.Contains(rtcfg, "#define RT_USING_PIN")
	ctx.UtestEnabled = strings.Contains(rtcfg, "#define RT_USING_UTEST")

	gpioPath := filepath.Join(root, "drivers", "drv_gpio.c")
	ctx.HasGPIODriver = fileExists(gpioPath)
	if ctx.HasGPIODriver {
		gpio := fileText(gpioPath)
		candidates := []string{"stm32_pin_get", "stm32_pin_mode", "stm32_pin_write", "stm32_pin_read", "rt_hw_pin_init", "rt_device_pin_register"}
		for _, name := range candidates {
			if strings.Contains(gpio, name) {
				ctx.GPIOFunctions = append(ctx.GPIOFunctions, name)
			}
		}
		ctx.GPIOFunctions = uniqueStrings(ctx.GPIOFunctions)
	}

	if fileExists(filepath.Join(root, "SConstruct")) {
		ctx.BuildModes = append(ctx.BuildModes, "SCons")
	}
	if fileExists(filepath.Join(root, "Debug", "makefile")) {
		ctx.BuildModes = append(ctx.BuildModes, "RT-Thread Studio managed Make")
	}

	for _, fw := range []string{
		filepath.Join(root, "Debug", "rtthread.elf"),
		filepath.Join(root, "Debug", "rtthread.bin"),
		filepath.Join(root, "rt-thread.elf"),
		filepath.Join(root, "rtthread.elf"),
	} {
		if fileExists(fw) {
			ctx.Firmware = fw
			break
		}
	}

	if ctx.HasGPIODriver && ctx.PinEnabled {
		ctx.AnalysisReason = "RT_USING_PIN and drivers/drv_gpio.c are active. CodeGen will exercise the real RT-Thread PIN -> drv_gpio.c path and redirect only GPIO mode/write/read hardware access to a reversible Virtual GPIO SIL backend."
	} else if ctx.HasGPIODriver {
		ctx.AnalysisReason = "drivers/drv_gpio.c exists, but RT_USING_PIN is disabled. Enable the RT-Thread PIN framework before running the GPIO driver SIL test."
	} else {
		ctx.AnalysisReason = "drivers/drv_gpio.c was not detected. This project is not ready for the GPIO driver-path SIL demo."
	}
	return ctx, nil
}

func renderProjectContext(ctx projectContext) string {
	api := "(none detected)"
	if len(ctx.GPIOFunctions) > 0 {
		api = strings.Join(ctx.GPIOFunctions, ", ")
	}
	build := "(none detected)"
	if len(ctx.BuildModes) > 0 {
		build = strings.Join(ctx.BuildModes, " + ")
	}
	return fmt.Sprintf("PROJECT ANALYSIS\r\n\r\nRoot          %s\r\nProject       %s\r\nMCU           %s\r\nRT-Thread     %s\r\nQEMU machine  %s\r\nMSH/FinSH     %t\r\nRT PIN        %t\r\nRT utest      %t\r\nGPIO driver   %t\r\nGPIO symbols  %s\r\nBuild         %s\r\nFirmware      %s\r\n\r\nSIL strategy\r\n%s", ctx.Root, ctx.ProjectName, ctx.MCU, ctx.RTThread, ctx.QemuMachine, ctx.MSHEnabled, ctx.PinEnabled, ctx.UtestEnabled, ctx.HasGPIODriver, api, build, ctx.Firmware, ctx.AnalysisReason)
}

func analyzeSelectedProject() {
	root := getText(edtProject)
	// A new project analysis starts a new preparation context; do not carry a
	// previous TestPlan capability warning/READY state into another project.
	setPipelinePrepCapability("等待测试需求", "")
	setBusy(true)
	uiText(lblRunState, "State    Analyzing RT-Thread project...")
	go func() {
		defer setBusy(false)
		ctx, err := detectProject(root)
		if err != nil {
			uiText(lblProjectState, "Project  ○ Not ready")
			uiText(lblRunState, "State    Project analysis failed")
			uiMessage("Project analysis failed", err.Error(), MB_OK|MB_ICONERROR)
			return
		}
		currentProjectMu.Lock()
		currentProject = ctx
		currentProjectMu.Unlock()
		// A TestPlan belongs to the analyzed project context. Re-analysis invalidates
		// the previously displayed plan so Run cannot accidentally execute a stale plan.
		currentPlanMu.Lock()
		currentPlan = aiTestPlan{}
		currentPlanProvider = ""
		currentPlanModel = ""
		currentPlanRequirement = ""
		currentPlanMu.Unlock()
		refreshPlanViews(aiTestPlan{})
		refreshTestActionUI()
		uiText(edtProject, ctx.Root)
		if ctx.Firmware != "" {
			uiText(edtFirmware, ctx.Firmware)
		}
		uiText(lblProjectState, "Project  ● Analyzed")
		uiCapabilityBadge(ctx.Root, "")
		uiText(lblRunState, "State    Project analyzed")
		uiText(edtResult, renderProjectContext(ctx))
		logLine("PROJECT", fmt.Sprintf("%s / %s / RT-Thread %s", ctx.ProjectName, ctx.MCU, ctx.RTThread))
		logLine("PROJECT", ctx.AnalysisReason)
	}()
}

func generatedVirtualHeader() string {
	return `#ifndef __AI_SIL_GPIO_BACKEND_H__
#define __AI_SIL_GPIO_BACKEND_H__

#include <rtthread.h>
#include <rtdevice.h>
#include <board.h>

typedef enum
{
    AI_SIL_GPIO_FAULT_NONE = 0,
    AI_SIL_GPIO_FAULT_STUCK_LOW,
    AI_SIL_GPIO_FAULT_STUCK_HIGH
} ai_sil_gpio_fault_t;

struct ai_sil_gpio_state
{
    ai_sil_gpio_fault_t fault;
    rt_uint32_t mode_calls;
    rt_uint32_t write_calls;
    rt_uint32_t read_calls;
    rt_int32_t last_port;
    rt_int32_t last_pin;
    rt_int32_t requested_mode;
    rt_uint32_t last_hal_mode;
    rt_uint32_t last_pull;
    rt_uint32_t last_speed;
    rt_int32_t requested_value;
    rt_int32_t observed_value;
    rt_int32_t external_input_value;
    rt_uint32_t error_count;
};

void ai_sil_gpio_reset(void);
void ai_sil_gpio_begin_case(void);
void ai_sil_gpio_end_case(void);
rt_bool_t ai_sil_gpio_is_active(void);
void ai_sil_gpio_fault_none(void);
void ai_sil_gpio_fault_stuck_low(void);
void ai_sil_gpio_fault_stuck_high(void);
const char *ai_sil_gpio_fault_name(void);
void ai_sil_gpio_set_input_level(rt_base_t value);
void ai_sil_gpio_mode(GPIO_TypeDef *port, const GPIO_InitTypeDef *init, rt_base_t requested_mode);
void ai_sil_gpio_write(GPIO_TypeDef *port, rt_uint16_t pin_mask, rt_base_t value);
int ai_sil_gpio_read(GPIO_TypeDef *port, rt_uint16_t pin_mask);
struct ai_sil_gpio_state *ai_sil_gpio_state(void);

#endif
`
}

func generatedVirtualC() string {
	return `#include "ai_sil_gpio_backend.h"

static struct ai_sil_gpio_state g_gpio;
static rt_uint16_t g_levels[16];
static rt_bool_t g_active = RT_FALSE;

static int port_index(GPIO_TypeDef *port)
{
#ifdef GPIOA
    if (port == GPIOA) return 0;
#endif
#ifdef GPIOB
    if (port == GPIOB) return 1;
#endif
#ifdef GPIOC
    if (port == GPIOC) return 2;
#endif
#ifdef GPIOD
    if (port == GPIOD) return 3;
#endif
#ifdef GPIOE
    if (port == GPIOE) return 4;
#endif
#ifdef GPIOF
    if (port == GPIOF) return 5;
#endif
#ifdef GPIOG
    if (port == GPIOG) return 6;
#endif
#ifdef GPIOH
    if (port == GPIOH) return 7;
#endif
#ifdef GPIOI
    if (port == GPIOI) return 8;
#endif
#ifdef GPIOJ
    if (port == GPIOJ) return 9;
#endif
#ifdef GPIOK
    if (port == GPIOK) return 10;
#endif
    return -1;
}

static int pin_index(rt_uint16_t mask)
{
    int i;
    for (i = 0; i < 16; i++)
    {
        if (mask == (rt_uint16_t)(1u << i))
            return i;
    }
    return -1;
}

void ai_sil_gpio_reset(void)
{
    rt_memset(&g_gpio, 0, sizeof(g_gpio));
    rt_memset(g_levels, 0, sizeof(g_levels));
    g_gpio.fault = AI_SIL_GPIO_FAULT_NONE;
    g_gpio.last_port = -1;
    g_gpio.last_pin = -1;
    g_gpio.external_input_value = 0;
    g_active = RT_FALSE;
}

void ai_sil_gpio_begin_case(void)
{
    ai_sil_gpio_fault_t fault = g_gpio.fault;
    rt_memset(&g_gpio, 0, sizeof(g_gpio));
    rt_memset(g_levels, 0, sizeof(g_levels));
    g_gpio.fault = fault;
    g_gpio.last_port = -1;
    g_gpio.last_pin = -1;
    g_gpio.external_input_value = 0;
    g_active = RT_TRUE;
}

void ai_sil_gpio_end_case(void)
{
    g_active = RT_FALSE;
}

rt_bool_t ai_sil_gpio_is_active(void)
{
    return g_active;
}

void ai_sil_gpio_fault_none(void)       { g_gpio.fault = AI_SIL_GPIO_FAULT_NONE; }
void ai_sil_gpio_fault_stuck_low(void)  { g_gpio.fault = AI_SIL_GPIO_FAULT_STUCK_LOW; }
void ai_sil_gpio_fault_stuck_high(void) { g_gpio.fault = AI_SIL_GPIO_FAULT_STUCK_HIGH; }

const char *ai_sil_gpio_fault_name(void)
{
    switch (g_gpio.fault)
    {
    case AI_SIL_GPIO_FAULT_STUCK_LOW:  return "stuck_low";
    case AI_SIL_GPIO_FAULT_STUCK_HIGH: return "stuck_high";
    default:                            return "none";
    }
}

void ai_sil_gpio_set_input_level(rt_base_t value)
{
    g_gpio.external_input_value = value ? 1 : 0;
}

void ai_sil_gpio_mode(GPIO_TypeDef *port, const GPIO_InitTypeDef *init, rt_base_t requested_mode)
{
    int p = port_index(port);
    int n = (init != RT_NULL) ? pin_index((rt_uint16_t)init->Pin) : -1;
    g_gpio.mode_calls++;
    g_gpio.last_port = p;
    g_gpio.last_pin = n;
    g_gpio.requested_mode = (rt_int32_t)requested_mode;
    if (init != RT_NULL)
    {
        g_gpio.last_hal_mode = (rt_uint32_t)init->Mode;
        g_gpio.last_pull = (rt_uint32_t)init->Pull;
        g_gpio.last_speed = (rt_uint32_t)init->Speed;
    }
    if ((p < 0) || (n < 0) || (init == RT_NULL))
        g_gpio.error_count++;
}

void ai_sil_gpio_write(GPIO_TypeDef *port, rt_uint16_t pin_mask, rt_base_t value)
{
    int p = port_index(port);
    int n = pin_index(pin_mask);
    g_gpio.write_calls++;
    g_gpio.last_port = p;
    g_gpio.last_pin = n;
    g_gpio.requested_value = (rt_int32_t)value;
    if ((p < 0) || (n < 0))
    {
        g_gpio.error_count++;
        return;
    }
    if (value)
        g_levels[p] |= pin_mask;
    else
        g_levels[p] &= (rt_uint16_t)(~pin_mask);
}

int ai_sil_gpio_read(GPIO_TypeDef *port, rt_uint16_t pin_mask)
{
    int p = port_index(port);
    int n = pin_index(pin_mask);
    int value;
    g_gpio.read_calls++;
    g_gpio.last_port = p;
    g_gpio.last_pin = n;
    if ((p < 0) || (n < 0))
    {
        g_gpio.error_count++;
        g_gpio.observed_value = 0;
        return 0;
    }
    if ((g_gpio.requested_mode == PIN_MODE_INPUT) ||
        (g_gpio.requested_mode == PIN_MODE_INPUT_PULLUP) ||
        (g_gpio.requested_mode == PIN_MODE_INPUT_PULLDOWN))
        value = g_gpio.external_input_value ? 1 : 0;
    else
        value = (g_levels[p] & pin_mask) ? 1 : 0;
    if (g_gpio.fault == AI_SIL_GPIO_FAULT_STUCK_LOW)
        value = 0;
    else if (g_gpio.fault == AI_SIL_GPIO_FAULT_STUCK_HIGH)
        value = 1;
    g_gpio.observed_value = value;
    return value;
}

struct ai_sil_gpio_state *ai_sil_gpio_state(void)
{
    return &g_gpio;
}
`
}

func generatedRuntimeHeader() string {
	return "#ifndef __AI_SIL_RUNTIME_H__\n#define __AI_SIL_RUNTIME_H__\n\n#include <rtthread.h>\n\n#endif\n"
}

func generatedTestC(tc testCase, includeInput bool) string {
	tmpl := `#include <rtthread.h>
#include <rtdevice.h>
#include <finsh.h>
#include "ai_sil_gpio_backend.h"

/*
 * AI-generated GPIO driver-path test.
 * The test uses RT-Thread PIN APIs. The real drivers/drv_gpio.c remains in the
 * call path; only its HAL GPIO mode/write/read boundary is redirected to the
 * Virtual GPIO SIL backend while this instrumentation is installed.
 *
 * Usage: ai_test_gpio [PA.0..PK.15]
 * Fault injection is configured independently with sil_gpio_fault_* commands,
 * so many cases can run without rebuilding the firmware.
 */
static int ai_test_gpio(int argc, char **argv)
{
    const char *pin_name = "__PIN__";
    rt_base_t pin;
    int high_value;
    int low_value;
    int errors = 0;
    struct ai_sil_gpio_state *s;

    if (argc >= 2)
        pin_name = argv[1];

    ai_sil_gpio_begin_case();
    pin = rt_pin_get(pin_name);
    rt_kprintf("@SIL,CASE,GPIO_001,pin=%s,fault=%s\r\n", pin_name, ai_sil_gpio_fault_name());

    if (pin < 0)
    {
        rt_kprintf("@SIL,RESULT,GPIO,%s,-1,-1,0,0,0,%s,1\r\n", pin_name, ai_sil_gpio_fault_name());
        ai_sil_gpio_end_case();
        return -RT_EINVAL;
    }

    rt_pin_mode(pin, PIN_MODE_OUTPUT);
    rt_pin_write(pin, PIN_HIGH);
    high_value = rt_pin_read(pin);
    rt_kprintf("@SIL,CHECK,write_high,requested=1,observed=%d\r\n", high_value);

    rt_pin_write(pin, PIN_LOW);
    low_value = rt_pin_read(pin);
    rt_kprintf("@SIL,CHECK,write_low,requested=0,observed=%d\r\n", low_value);

    s = ai_sil_gpio_state();
    rt_kprintf("@SIL,CHECK,mode_output,requested=%d,hal_mode=%u,pull=%u\r\n",
               PIN_MODE_OUTPUT, s->last_hal_mode, s->last_pull);

    if (high_value != PIN_HIGH) errors++;
    if (low_value != PIN_LOW) errors++;
    if (s->mode_calls < 1u) errors++;
    if (s->write_calls < 2u) errors++;
    if (s->read_calls < 2u) errors++;
    if (s->requested_mode != PIN_MODE_OUTPUT) errors++;
    if (s->last_hal_mode != GPIO_MODE_OUTPUT_PP) errors++;
    if (s->last_pull != GPIO_NOPULL) errors++;
    errors += (int)s->error_count;

    rt_kprintf("@SIL,DRIVER,drv_gpio.c,mode_calls=%u,write_calls=%u,read_calls=%u,hal_mode=%u,pull=%u\r\n",
               s->mode_calls, s->write_calls, s->read_calls, s->last_hal_mode, s->last_pull);
    rt_kprintf("@SIL,RESULT,GPIO,%s,%d,%d,%u,%u,%u,%u,%u,%s,%d\r\n",
               pin_name,
               high_value,
               low_value,
               s->mode_calls,
               s->write_calls,
               s->read_calls,
               s->last_hal_mode,
               s->last_pull,
               ai_sil_gpio_fault_name(),
               errors);
    ai_sil_gpio_end_case();
    return errors == 0 ? RT_EOK : -RT_ERROR;
}
MSH_CMD_EXPORT(ai_test_gpio, run AI generated GPIO driver SIL testcase);


#ifdef AI_SIL_GPIO_INPUT_CAPABILITY
static int ai_test_gpio_input(int argc, char **argv)
{
    const char *pin_name = "__PIN__";
    rt_base_t pin;
    int high_value;
    int low_value;
    int errors = 0;
    struct ai_sil_gpio_state *s;

    if (argc >= 2)
        pin_name = argv[1];

    ai_sil_gpio_begin_case();
    pin = rt_pin_get(pin_name);
    rt_kprintf("@SIL,CASE,GPIO_INPUT_001,pin=%s,fault=%s\r\n", pin_name, ai_sil_gpio_fault_name());

    if (pin < 0)
    {
        rt_kprintf("@SIL,RESULT,GPIO_INPUT,%s,-1,-1,0,0,0,-1,-1,%s,1\r\n", pin_name, ai_sil_gpio_fault_name());
        ai_sil_gpio_end_case();
        return -RT_EINVAL;
    }

    rt_pin_mode(pin, PIN_MODE_INPUT);
    ai_sil_gpio_set_input_level(PIN_HIGH);
    high_value = rt_pin_read(pin);
    rt_kprintf("@SIL,CHECK,input_high,stimulus=1,observed=%d\r\n", high_value);

    ai_sil_gpio_set_input_level(PIN_LOW);
    low_value = rt_pin_read(pin);
    rt_kprintf("@SIL,CHECK,input_low,stimulus=0,observed=%d\r\n", low_value);

    s = ai_sil_gpio_state();
    rt_kprintf("@SIL,CHECK,mode_input,requested=%d,hal_mode=%u,pull=%u\r\n",
               PIN_MODE_INPUT, s->last_hal_mode, s->last_pull);

    if (high_value != PIN_HIGH) errors++;
    if (low_value != PIN_LOW) errors++;
    if (s->mode_calls < 1u) errors++;
    if (s->read_calls < 2u) errors++;
    if (s->requested_mode != PIN_MODE_INPUT) errors++;
    if (s->last_hal_mode != GPIO_MODE_INPUT) errors++;
    if (s->last_pull != GPIO_NOPULL) errors++;
    errors += (int)s->error_count;

    rt_kprintf("@SIL,DRIVER,drv_gpio.c,input_mode_calls=%u,write_calls=%u,read_calls=%u,hal_mode=%u,pull=%u\r\n",
               s->mode_calls, s->write_calls, s->read_calls, s->last_hal_mode, s->last_pull);
    rt_kprintf("@SIL,RESULT,GPIO_INPUT,%s,%d,%d,%u,%u,%u,%u,%u,%s,%d\r\n",
               pin_name,
               high_value,
               low_value,
               s->mode_calls,
               s->write_calls,
               s->read_calls,
               s->last_hal_mode,
               s->last_pull,
               ai_sil_gpio_fault_name(),
               errors);
    ai_sil_gpio_end_case();
    return errors == 0 ? RT_EOK : -RT_ERROR;
}
MSH_CMD_EXPORT(ai_test_gpio_input, run AI generated GPIO input SIL testcase);
#endif
`
	if includeInput {
		tmpl = strings.Replace(tmpl, "#ifdef AI_SIL_GPIO_INPUT_CAPABILITY", "#define AI_SIL_GPIO_INPUT_CAPABILITY 1\n#ifdef AI_SIL_GPIO_INPUT_CAPABILITY", 1)
	}
	tmpl = strings.ReplaceAll(tmpl, "__PIN__", tc.Pin)
	return tmpl
}

