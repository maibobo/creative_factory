func scaledInt32(v int32, scale float64) int32 {
	if scale <= 0 {
		return v
	}
	return int32(float64(v)*scale + 0.5)
}

// layoutWorkbench turns the fixed v0.8 canvas into a responsive Win32 layout.
// The 195 px navigation rail stays fixed; the workspace consumes all remaining
// horizontal room.  Extra vertical room is distributed to the evidence, matrix
// and log regions so maximizing the window never leaves a dead blank area.
func layoutWorkbench(clientW, clientH int32) {
	if !layoutReady || clientW <= 0 || clientH <= 0 {
		return
	}

	extraH := clientH - layoutBaseClientH
	if extraH < 0 {
		extraH = 0
	}
	mainExtra := extraH * 48 / 100
	matrixExtra := extraH * 22 / 100
	logExtra := extraH - mainExtra - matrixExtra

	contentAvail := clientW - layoutContentLeft - 20
	if contentAvail < layoutContentW {
		contentAvail = layoutContentW
	}
	sx := float64(contentAvail) / float64(layoutContentW)

	layoutMu.Lock()
	items := append([]layoutItem(nil), layoutItems...)
	layoutMu.Unlock()

	for _, it := range items {
		nx, ny, nw, nh := it.x, it.y, it.w, it.h

		if it.x < layoutContentLeft {
			if it.x == 0 && it.y == 0 && it.w >= 185 {
				nh = clientH
			} else if it.y >= 900 {
				ny = clientH - (layoutBaseClientH - it.y)
			}
		} else {
			nx = layoutContentLeft + scaledInt32(it.x-layoutContentLeft, sx)
			nw = scaledInt32(it.w, sx)

			switch {
			case it.y >= 806:
				ny = it.y + mainExtra + matrixExtra
				if it.y == 806 && it.h >= 125 {
					nh = it.h + logExtra
				} else if it.y >= 850 && it.h >= 55 {
					nh = it.h + logExtra
				}
			case it.y >= 648:
				ny = it.y + mainExtra
				if it.y == 648 && it.h >= 135 {
					nh = it.h + matrixExtra
				} else if it.y >= 700 && it.h >= 60 {
					nh = it.h + matrixExtra
				}
			case it.y >= 298:
				if it.y == 298 && it.h >= 320 {
					nh = it.h + mainExtra
				} else if (it.y >= 350 && it.y <= 540) && it.h >= 100 {
					nh = it.h + mainExtra
				} else if it.y >= 575 {
					ny = it.y + mainExtra
				}
			}
		}

		if nw < 1 {
			nw = 1
		}
		if nh < 1 {
			nh = 1
		}
		procMoveWindow.Call(it.hwnd, uintptr(nx), uintptr(ny), uintptr(nw), uintptr(nh), 0)
		if radius, ok := roundedControls[it.hwnd]; ok {
			roundControl(it.hwnd, nw, nh, radius)
		}
	}
	procInvalidateRect.Call(hwndMain, 0, 1)
}
