}
MSH_CMD_EXPORT(sil_gpio_fault_stuck_high, force GPIO readback high);

__AI_SIL_INPUT_RUNTIME__
static int sil_gpio_status(int argc, char **argv)
{
    struct ai_sil_gpio_state *s = ai_sil_gpio_state();
    (void)argc;
    (void)argv;
    rt_kprintf("@SIL,STATUS,GPIO,%s,%u,%u,%u,%u,%u,%d,%d,%u\r\n",
               ai_sil_gpio_fault_name(),
               s->mode_calls,
               s->write_calls,
               s->read_calls,
               s->last_hal_mode,
               s->last_pull,
               s->requested_value,
               s->observed_value,
               s->error_count);
    return RT_EOK;
}
MSH_CMD_EXPORT(sil_gpio_status, print GPIO SIL runtime state);

static int ai_sil_runtime_init(void)
{
    ai_sil_gpio_reset();
    rt_kprintf("@SIL,RUNTIME,READY,__AI_SIL_MCU__,virtual_gpio,v1\r\n");
    return RT_EOK;
}
INIT_APP_EXPORT(ai_sil_runtime_init);
`
	capLine := "@SIL,CAP,gpio,driver=drv_gpio.c,cap=gpio_output_readback,api=rt_pin_get|rt_pin_mode|rt_pin_write|rt_pin_read,faults=none|stuck_low|stuck_high"
	inputRuntime := ""
	if includeInput {
		capLine = "@SIL,CAP,gpio,driver=drv_gpio.c,cap=gpio_output_readback|gpio_input_readback,api=rt_pin_get|rt_pin_mode|rt_pin_write|rt_pin_read,faults=none|stuck_low|stuck_high"
		inputRuntime = `static int sil_gpio_input_low(int argc, char **argv)
{
    (void)argc;
    (void)argv;
    ai_sil_gpio_set_input_level(PIN_LOW);
    rt_kprintf("@SIL,INPUT,gpio,0\r\n");
    return RT_EOK;
}
MSH_CMD_EXPORT(sil_gpio_input_low, drive virtual external GPIO input low);

static int sil_gpio_input_high(int argc, char **argv)
{
    (void)argc;
    (void)argv;
    ai_sil_gpio_set_input_level(PIN_HIGH);
    rt_kprintf("@SIL,INPUT,gpio,1\r\n");
    return RT_EOK;
}
MSH_CMD_EXPORT(sil_gpio_input_high, drive virtual external GPIO input high);

`
	}
	tmpl = strings.ReplaceAll(tmpl, "__AI_SIL_CAP_LINE__", capLine)
	tmpl = strings.ReplaceAll(tmpl, "__AI_SIL_INPUT_RUNTIME__", inputRuntime)
	return strings.ReplaceAll(tmpl, "__AI_SIL_MCU__", mcu)
}

func instrumentGPIODriver(ctx projectContext) (string, error) {
	path := filepath.Join(ctx.Root, "drivers", "drv_gpio.c")
	if !fileExists(path) {
		return "", fmt.Errorf("drivers/drv_gpio.c was not found")
	}
	srcBytes, err := os.ReadFile(path)
	if err != nil {
		return "", err
	}
	src := string(srcBytes)
	if strings.Contains(src, "AI_SIL_GPIO_INSTRUMENTATION_BEGIN") {
		return path, nil
	}
	includeNeedle := "#include <board.h>"
	writeNeedle := "HAL_GPIO_WritePin(gpio_port, gpio_pin, (GPIO_PinState)value);"
	readNeedle := "value = HAL_GPIO_ReadPin(gpio_port, gpio_pin);"
	modeNeedle := "HAL_GPIO_Init(PIN_STPORT(pin), &GPIO_InitStruct);"
	if !strings.Contains(src, includeNeedle) || !strings.Contains(src, writeNeedle) || !strings.Contains(src, readNeedle) || !strings.Contains(src, modeNeedle) {
		return "", fmt.Errorf("drv_gpio.c layout is not recognized; refusing to patch the driver automatically")
	}

	backupDir := filepath.Join(ctx.Root, ".ai_sil_backup")
	if err := os.MkdirAll(backupDir, 0755); err != nil {
		return "", err
	}
	backup := filepath.Join(backupDir, "drv_gpio.c.orig")
	if !fileExists(backup) {
		if err := os.WriteFile(backup, srcBytes, 0644); err != nil {
			return "", err
		}
	}

	src = strings.Replace(src, includeNeedle, includeNeedle+`

/* AI_SIL_GPIO_INSTRUMENTATION_BEGIN
 * Reversible SIL hook. Original file is backed up at .ai_sil_backup/drv_gpio.c.orig.
 */
#include "ai_sil_gpio_backend.h"
/* AI_SIL_GPIO_INSTRUMENTATION_END */`, 1)
	src = strings.Replace(src, writeNeedle, `/* AI_SIL_GPIO_WRITE_BEGIN */
        if (ai_sil_gpio_is_active())
            ai_sil_gpio_write(gpio_port, gpio_pin, value);
        else
            HAL_GPIO_WritePin(gpio_port, gpio_pin, (GPIO_PinState)value);
        /* AI_SIL_GPIO_WRITE_END */`, 1)
	src = strings.Replace(src, readNeedle, `/* AI_SIL_GPIO_READ_BEGIN */
        if (ai_sil_gpio_is_active())
            value = ai_sil_gpio_read(gpio_port, gpio_pin);
        else
            value = HAL_GPIO_ReadPin(gpio_port, gpio_pin);
        /* AI_SIL_GPIO_READ_END */`, 1)
	src = strings.Replace(src, modeNeedle, `/* AI_SIL_GPIO_MODE_BEGIN */
    if (ai_sil_gpio_is_active())
        ai_sil_gpio_mode(PIN_STPORT(pin), &GPIO_InitStruct, mode);
    else
        HAL_GPIO_Init(PIN_STPORT(pin), &GPIO_InitStruct);
    /* AI_SIL_GPIO_MODE_END */`, 1)
	if err := os.WriteFile(path, []byte(src), 0644); err != nil {
		return "", err
	}
	return path, nil
}

func generateTestCode() {
	root := getText(edtProject)
	setBusy(true)
	uiText(lblRunState, "State    Generating GPIO driver-path MSH test...")
	go func() {
		defer setBusy(false)
		ctx, err := detectProject(root)
		if err != nil {
			uiText(lblRunState, "State    CodeGen failed")
			uiMessage("Generate test code failed", err.Error(), MB_OK|MB_ICONERROR)
			return
		}
		if !ctx.MSHEnabled {
			uiMessage("Generate test code failed", "This project does not have FinSH/MSH enabled. MSH_CMD_EXPORT requires FINSH_USING_MSH.", MB_OK|MB_ICONERROR)
			return
		}
		if !ctx.PinEnabled || !ctx.HasGPIODriver {
			uiMessage("Generate test code failed", "GPIO driver-path SIL requires RT_USING_PIN and drivers/drv_gpio.c.", MB_OK|MB_ICONERROR)
			return
		}
		currentProjectMu.Lock()
		currentProject = ctx
		currentProjectMu.Unlock()

		tc := parseRequirement(getText(edtPrompt))
		currentCaseMu.Lock()
		currentCase = tc
		currentCaseMu.Unlock()

		appsDir := filepath.Join(ctx.Root, "applications")
		if !dirExists(appsDir) {
			if err := os.MkdirAll(appsDir, 0755); err != nil {
				uiMessage("Generate test code failed", err.Error(), MB_OK|MB_ICONERROR)
				return
			}
		}

		includeInput := gpioInputCapabilityReadyForRoot(ctx.Root)
		files := map[string][]byte{
			"ai_sil_runtime.c":      []byte(generatedRuntimeC(ctx, includeInput)),
			"ai_sil_runtime.h":      []byte(generatedRuntimeHeader()),
			"ai_sil_gpio_backend.c": []byte(generatedVirtualC()),
			"ai_sil_gpio_backend.h": []byte(generatedVirtualHeader()),
			"ai_generated_test.c":   []byte(generatedTestC(tc, includeInput)),
		}
		for name, data := range files {
			if err := os.WriteFile(filepath.Join(appsDir, name), data, 0644); err != nil {
				uiMessage("Generate test code failed", err.Error(), MB_OK|MB_ICONERROR)
				return
			}
		}
		// Remove stale ADC-only generated files from earlier v0.5 editions so the
		// managed build contains one unambiguous SIL backend.
		_ = os.Remove(filepath.Join(appsDir, "ai_sil_virtual_adc.c"))
		_ = os.Remove(filepath.Join(appsDir, "ai_sil_virtual_adc.h"))

		driverPath, err := instrumentGPIODriver(ctx)
		if err != nil {
			uiText(lblRunState, "State    GPIO instrumentation failed")
			uiMessage("GPIO instrumentation failed", err.Error(), MB_OK|MB_ICONERROR)
			return
		}

		manifest := map[string]any{
			"generator":       "AI SIL Test Workbench v0.9 - GPIO driver SIL",
			"project":         ctx,
			"testcase":        tc,
			"generated_files": []string{"applications/ai_sil_runtime.c", "applications/ai_sil_runtime.h", "applications/ai_sil_gpio_backend.c", "applications/ai_sil_gpio_backend.h", "applications/ai_generated_test.c"},
			"instrumented":    "drivers/drv_gpio.c",
			"backup":          ".ai_sil_backup/drv_gpio.c.orig",
			"msh_commands":    []string{"ai_test_gpio", "sil_ping", "sil_cap", "sil_reset", "sil_gpio_fault_none", "sil_gpio_fault_stuck_low", "sil_gpio_fault_stuck_high", "sil_gpio_status"},
		}
		mb, _ := json.MarshalIndent(manifest, "", "  ")
		_ = os.WriteFile(filepath.Join(ctx.Root, ".ai_sil_manifest.json"), mb, 0644)

		uiText(edtTestcase, generatedTestC(tc, includeInput))
		uiText(lblProjectState, "Project  ● Analyzed")
		uiCapabilityBadge(ctx.Root, "")
		uiText(lblCodegenState, "CodeGen  ● GPIO driver")
		uiText(lblRunState, "State    GPIO driver-path test generated")
		uiText(edtResult, fmt.Sprintf("GPIO DRIVER SIL GENERATED\r\n\r\nTest source\r\n%s\r\n\r\nReal driver in path\r\n%s\r\n\r\nMSH entry\r\nai_test_gpio\r\n\r\nInstrumentation\r\nDuring ai_test_gpio only, drv_gpio.c mode/write/read hardware access is redirected to Virtual GPIO; outside the test, normal HAL GPIO calls remain active.\r\nOriginal backup: %s\r\n\r\nmain.c\r\nNOT modified.\r\n\r\nNext\r\nClick Studio Build, then Start QEMU and run ai_test_gpio.", filepath.Join(appsDir, "ai_generated_test.c"), driverPath, filepath.Join(ctx.Root, ".ai_sil_backup", "drv_gpio.c.orig")))
		logLine("CODEGEN", "Generated GPIO MSH test in "+appsDir)
		logLine("CODEGEN", "Instrumented real driver path: "+driverPath)
		logLine("CODEGEN", "main.c was not modified")
	}()
}

func capabilityBlockerDetails(plan aiTestPlan, ctx projectContext) string {
	rtcfg := fileText(filepath.Join(ctx.Root, "rtconfig.h"))
	board := fileText(filepath.Join(ctx.Root, "drivers", "board.h"))
	driver := strings.ToLower(plan.RequestedDriver)
	var source string
	var enabled []string
	switch driver {
	case "spi":
		source = filepath.Join(ctx.Root, "drivers", "drv_spi.c")
		enabled = []string{fmt.Sprintf("RT_USING_SPI=%t", strings.Contains(rtcfg, "#define RT_USING_SPI")), fmt.Sprintf("BSP_USING_SPIx=%t", regexp.MustCompile(`#define\s+BSP_USING_SPI[1-6]`).MatchString(board))}
	case "adc":
		source = filepath.Join(ctx.Root, "drivers", "drv_adc.c")
		enabled = []string{fmt.Sprintf("RT_USING_ADC=%t", strings.Contains(rtcfg, "#define RT_USING_ADC")), fmt.Sprintf("BSP_USING_ADCx=%t", regexp.MustCompile(`#define\s+BSP_USING_ADC[1-3]`).MatchString(board))}
	case "uart", "serial":
		source = filepath.Join(ctx.Root, "drivers", "drv_usart.c")
		enabled = []string{fmt.Sprintf("RT_USING_SERIAL=%t", strings.Contains(rtcfg, "#define RT_USING_SERIAL"))}
	default:
		source = filepath.Join(ctx.Root, "drivers", "drv_"+driver+".c")
	}
	return fmt.Sprintf("Requested capability: %s / %s\r\nDriver source: %s (exists=%t)\r\nProject config: %s\r\n\r\nThis v0.8 builder does not silently enable RT-Thread/BSP peripheral configuration or invent a hardware model. It can auto-extend GPIO input/readback because that reuses the already-enabled RT PIN framework and the existing drv_gpio.c HAL boundary. Other drivers remain blocked until their project configuration and SIL boundary template are explicitly supported.", plan.RequestedDriver, plan.RequestedCapability, source, fileExists(source), strings.Join(enabled, ", "))
}

func generateGPIOInputCapability(ctx projectContext, pin string) error {
	if !ctx.MSHEnabled || !ctx.PinEnabled || !ctx.HasGPIODriver {
		return fmt.Errorf("GPIO input extension requires FinSH/MSH, RT_USING_PIN, and drivers/drv_gpio.c")
	}
	if p, ok := canonicalGPIOPin(pin); ok {
		pin = p
	} else {
		pin = "PB.0"
	}
	tc := testCase{Target: "gpio", Pin: pin, Fault: "none"}
	appsDir := filepath.Join(ctx.Root, "applications")
	if err := os.MkdirAll(appsDir, 0755); err != nil {
		return err
	}
	files := map[string][]byte{
		"ai_sil_runtime.c":      []byte(generatedRuntimeC(ctx, true)),
		"ai_sil_runtime.h":      []byte(generatedRuntimeHeader()),
		"ai_sil_gpio_backend.c": []byte(generatedVirtualC()),
		"ai_sil_gpio_backend.h": []byte(generatedVirtualHeader()),
		"ai_generated_test.c":   []byte(generatedTestC(tc, true)),
	}
	for name, data := range files {
		if err := os.WriteFile(filepath.Join(appsDir, name), data, 0644); err != nil {
			return err
		}
	}
	if _, err := instrumentGPIODriver(ctx); err != nil {
		return err
	}
	manifest := map[string]any{
		"generator":              "AI SIL Test Workbench v0.9.1 - Capability Builder",
		"project":                ctx,
		"installed_capabilities": []string{"gpio_output_readback", "gpio_input_readback"},
		"generated_files":        []string{"applications/ai_sil_runtime.c", "applications/ai_sil_runtime.h", "applications/ai_sil_gpio_backend.c", "applications/ai_sil_gpio_backend.h", "applications/ai_generated_test.c"},
		"instrumented":           "drivers/drv_gpio.c",
		"msh_commands":           []string{"ai_test_gpio", "ai_test_gpio_input", "sil_ping", "sil_cap", "sil_reset", "sil_gpio_fault_none", "sil_gpio_fault_stuck_low", "sil_gpio_fault_stuck_high"},
	}
	mb, _ := json.MarshalIndent(manifest, "", "  ")
	_ = os.WriteFile(filepath.Join(ctx.Root, ".ai_sil_manifest.json"), mb, 0644)
	return nil
}

func canAutoExtend(plan aiTestPlan) bool {
	return strings.EqualFold(plan.RequestedDriver, "gpio") && normalizeRequestedCapability("gpio", plan.RequestedCapability) == "gpio_input_readback" && !gpioInputCapabilityReady()
}

func ensureBuildIntegration(ctx projectContext) error {
	apps := filepath.Join(ctx.Root, "applications")
	for _, name := range []string{"ai_sil_runtime.c", "ai_sil_runtime.h", "ai_sil_gpio_backend.c", "ai_sil_gpio_backend.h", "ai_generated_test.c"} {
		if !fileExists(filepath.Join(apps, name)) {
			return fmt.Errorf("%s was not found; run Generate Test Code first", filepath.Join("applications", name))
		}
	}
	driver := filepath.Join(ctx.Root, "drivers", "drv_gpio.c")
	if !strings.Contains(fileText(driver), "AI_SIL_GPIO_INSTRUMENTATION_BEGIN") {
		return fmt.Errorf("drivers/drv_gpio.c is not SIL-instrumented; run Generate Test Code first")
	}
	return nil
}

func inferStudioRoot(qemuPath string) string {
	p := resolveExe(qemuPath)
	if p == "" || !filepath.IsAbs(p) {
		return ""
	}
	p = filepath.Dir(p)
	for i := 0; i < 12; i++ {
		if dirExists(filepath.Join(p, "repo", "Extract")) {
			return p
		}
		next := filepath.Dir(p)
		if next == p {
			break
		}
		p = next
	}
	return ""
}

func findNamedFile(root string, names map[string]bool, maxDepth int) string {
	root = strings.TrimSpace(root)
	if root == "" || !dirExists(root) {
		return ""
	}
	var found string
	var walk func(string, int)
	walk = func(dir string, depth int) {
		if found != "" || depth > maxDepth {
			return
		}
		entries, err := os.ReadDir(dir)
		if err != nil {
			return
		}
		for _, e := range entries {
			if found != "" {
				return
			}
			nameLower := strings.ToLower(e.Name())
			path := filepath.Join(dir, e.Name())
			if e.IsDir() {
				// Skip very large/nonessential trees during tool discovery.
				if nameLower == ".git" || nameLower == "workspace" || nameLower == "packages" {
					continue
				}
				walk(path, depth+1)
			} else if names[nameLower] {
				found = path
				return
			}
		}
	}
	walk(root, 0)
	return found
}

type buildLogWriter struct {
	mu                 sync.Mutex
	partial            []byte
	mode               string
	compileCount       int
	errorCount         int
	warningCount       int
	inBuild            bool
	suppressedSamples  int
	suppressedEncoding int
	aiSources          map[string]bool
	captured           []string
}

func newBuildLogWriter(mode string) *buildLogWriter {
	return &buildLogWriter{mode: mode, aiSources: map[string]bool{}}
}

func (w *buildLogWriter) handleLine(raw []byte) {
	raw = bytesTrimSpace(raw)
	if len(raw) == 0 {
		return
	}
	if !utf8.Valid(raw) {
		// RT-Thread Studio may emit a few locale-encoded startup messages before
		// the actual managed build begins. They are IDE startup chatter, not
		// compiler output, so keep them out of the build transcript.
		w.suppressedEncoding++
		return
	}
	line := strings.TrimSpace(string(raw))
	if line == "" {
		return
	}
	lower := strings.ToLower(line)
	if strings.Contains(lower, "[sample]:") || strings.Contains(lower, `\"samples\"`) {
		// CDT error-parser self-test samples are not project diagnostics.
		w.suppressedSamples++
		return
	}

	isBuildStart := strings.Contains(line, "**** Build of configuration") || strings.Contains(line, "**** Clean-only build of configuration")
	if isBuildStart {
		w.inBuild = true
	}
	if w.mode != "build" {
		// Import phase: only keep useful project/workspace status. Actual compiler
		// output is captured completely in the build phase below.
		if strings.Contains(lower, "error") || strings.Contains(lower, "warning") {
			logLine("BUILD", line)
		}
		return
	}

	if !w.inBuild {
		// Before the managed build marker, Eclipse is still loading plugins. Keep
		// that noisy initialization out of the compiler transcript.
		return
	}

	isError := strings.Contains(lower, "error:") || strings.Contains(lower, "fatal error") ||
		strings.Contains(lower, "undefined reference") || strings.Contains(lower, "no rule to make target") ||
		strings.Contains(lower, "make: ***") || strings.Contains(lower, "build failed")
	isWarning := strings.Contains(lower, "warning:")
	if isError {
		w.errorCount++
	}
	if isWarning {
		w.warningCount++
	}

	isCompile := strings.Contains(lower, "arm-none-eabi-gcc") || strings.Contains(lower, "arm-none-eabi-g++")
	if isCompile && (strings.Contains(lower, ".c\"") || strings.Contains(lower, ".c ") || strings.Contains(lower, ".s\"") || strings.Contains(lower, ".s ")) {
		w.compileCount++
		for _, n := range []string{"ai_generated_test.c", "ai_sil_runtime.c", "ai_sil_gpio_backend.c", "drv_gpio.c"} {
			if strings.Contains(lower, n) {
				w.aiSources[n] = true
			}
		}
	}

	// Once the real managed build starts, preserve every valid build line:
	// compiler invocations, linker steps, warnings/errors, objcopy/size output,
	// and the final Build Finished result. Nothing from the compiler is condensed.
	if len(w.captured) < 4000 {
		w.captured = append(w.captured, line)
	}
	logLine("BUILD", line)
}

func bytesTrimSpace(b []byte) []byte {
	i, j := 0, len(b)
	for i < j && (b[i] == ' ' || b[i] == '\t' || b[i] == '\r' || b[i] == '\n') {
		i++
	}
	for j > i && (b[j-1] == ' ' || b[j-1] == '\t' || b[j-1] == '\r' || b[j-1] == '\n') {
		j--
	}
	return b[i:j]
}

func (w *buildLogWriter) Write(p []byte) (int, error) {
	w.mu.Lock()
	defer w.mu.Unlock()
	buf := append(append([]byte{}, w.partial...), p...)
	start := 0
	for i, c := range buf {
		if c == '\n' {
			line := buf[start:i]
			if len(line) > 0 && line[len(line)-1] == '\r' {
				line = line[:len(line)-1]
			}
			w.handleLine(line)
			start = i + 1
		}
	}
	w.partial = append(w.partial[:0], buf[start:]...)
	return len(p), nil
}
func (w *buildLogWriter) Transcript() string {
	w.mu.Lock()
	defer w.mu.Unlock()
	return strings.Join(append([]string(nil), w.captured...), "\n")
}

func (w *buildLogWriter) Flush() {
	w.mu.Lock()
	defer w.mu.Unlock()
	if len(bytesTrimSpace(w.partial)) > 0 {
		w.handleLine(w.partial)
	}
	w.partial = nil
	if w.mode == "build" {
		names := make([]string, 0, len(w.aiSources))
		for _, n := range []string{"ai_generated_test.c", "ai_sil_runtime.c", "ai_sil_gpio_backend.c", "drv_gpio.c"} {
			if w.aiSources[n] {
				names = append(names, n)
			}
		}
		logLine("BUILD", fmt.Sprintf("Build transcript summary: compiler invocations=%d, warning lines=%d, error lines=%d", w.compileCount, w.warningCount, w.errorCount))
		if w.compileCount == 0 {
			logLine("BUILD", "No source compiler command was emitted by Studio in this incremental Build. This normally means the project is already up to date; the linker/size/final Build result above is still preserved.")
		}
		if len(names) > 0 {
			logLine("BUILD", fmt.Sprintf("GPIO SIL sources/driver compiled: %d/4 -> %s", len(names), strings.Join(names, ", ")))
		} else if w.compileCount > 0 {
			logLine("BUILD", "WARNING: compiler ran, but no AI-SIL generated source was observed in the compile transcript.")
		}
		if w.suppressedSamples > 0 || w.suppressedEncoding > 0 {
			logLine("BUILD", fmt.Sprintf("IDE-only startup noise filtered: CDT samples=%d, non-UTF8 startup lines=%d (compiler output is not filtered).", w.suppressedSamples, w.suppressedEncoding))
		}
	}
}

func generatedSourcesModTime(ctx projectContext) time.Time {
	var latest time.Time
	apps := filepath.Join(ctx.Root, "applications")
	for _, name := range []string{"ai_sil_runtime.c", "ai_sil_runtime.h", "ai_sil_gpio_backend.c", "ai_sil_gpio_backend.h", "ai_generated_test.c"} {
		if st, err := os.Stat(filepath.Join(apps, name)); err == nil && st.ModTime().After(latest) {
			latest = st.ModTime()
		}
	}
	if st, err := os.Stat(filepath.Join(ctx.Root, "drivers", "drv_gpio.c")); err == nil && st.ModTime().After(latest) {
		latest = st.ModTime()
	}
	return latest
}

func firmwareFreshForGenerated(ctx projectContext, fw string) bool {
	if fw == "" {
		return false
	}
	gen := generatedSourcesModTime(ctx)
	if gen.IsZero() {
		return true
	}
	st, err := os.Stat(fw)
	if err != nil {
		return false
	}
	return !st.ModTime().Before(gen)
}

func detectFirmware(ctx projectContext) string {
	candidates := []string{
		filepath.Join(ctx.Root, "Debug", "rtthread.elf"),
		filepath.Join(ctx.Root, "Debug", "rtthread.bin"),
		filepath.Join(ctx.Root, "rt-thread.elf"),
		filepath.Join(ctx.Root, "rtthread.elf"),
	}
	var best string
	var bestTime time.Time
	for _, f := range candidates {
		if st, err := os.Stat(f); err == nil && !st.IsDir() {
			if best == "" || st.ModTime().After(bestTime) {
				best = f
				bestTime = st.ModTime()
			}
		}
	}
	return best
}

func inferStudioFromProject(ctx projectContext) string {
	cfg := fileText(filepath.Join(ctx.Root, ".settings", "projcfg.ini"))
	for _, line := range strings.Split(cfg, "\n") {
		line = strings.TrimSpace(line)
		if strings.HasPrefix(line, "output_project_path=") {
			v := strings.TrimSpace(strings.TrimPrefix(line, "output_project_path="))
			v = strings.ReplaceAll(v, `\:`, `:`)
			v = filepath.Clean(v)
			root := filepath.Dir(v)
			for _, n := range []string{"eclipsec.exe", "studio.exe", "RT-Thread Studio.exe", "RT-ThreadStudio.exe"} {
				p := filepath.Join(root, n)
				if fileExists(p) {
					return p
				}
			}
		}
	}
	return ""
}

func detectStudioExe(ctx projectContext, qemuPath string) string {
	roots := []string{}
	if r := inferStudioRoot(qemuPath); r != "" {
		roots = append(roots, r)
	}
	if p := inferStudioFromProject(ctx); p != "" {
		return p
	}
	if strings.EqualFold(filepath.Base(filepath.Dir(ctx.Root)), "workspace") {
		roots = append(roots, filepath.Dir(filepath.Dir(ctx.Root)))
	}
	for _, r := range uniqueStrings(roots) {
		for _, n := range []string{"eclipsec.exe", "studio.exe", "RT-Thread Studio.exe", "RT-ThreadStudio.exe"} {
			p := filepath.Join(r, n)
			if fileExists(p) {
				return p
			}
		}
		if p := findNamedFile(r, map[string]bool{"eclipsec.exe": true, "studio.exe": true}, 2); p != "" {
			return p
		}
	}
	return ""
}

func studioToolDirs(studioExe, qemuPath string) []string {
	roots := []string{}
	if studioExe != "" {
		roots = append(roots, filepath.Dir(studioExe))
	}
	if r := inferStudioRoot(qemuPath); r != "" {
		roots = append(roots, r)
	}
	var dirs []string
	for _, root := range uniqueStrings(roots) {
		for _, names := range []map[string]bool{
			{"make.exe": true},
			{"arm-none-eabi-gcc.exe": true},
		} {
			if f := findNamedFile(root, names, 10); f != "" {
				dirs = append(dirs, filepath.Dir(f))
			}
		}
	}
	return uniqueStrings(dirs)
}

func sanitizeFilePart(s string) string {
	s = strings.TrimSpace(s)
	if s == "" {
		return "project"
	}
	re := regexp.MustCompile(`[^A-Za-z0-9_.-]+`)
	s = re.ReplaceAllString(s, "_")
	if len(s) > 48 {
		s = s[:48]
	}
	return s
}

func runLoggedCommand(name string, args []string, dir string, env []string, mode string) error {
	cmd := exec.Command(name, args...)
	cmd.Dir = dir
	cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true}
	if len(env) > 0 {
		cmd.Env = env
	}
	writer := newBuildLogWriter(mode)
	cmd.Stdout = writer
	cmd.Stderr = writer
	err := cmd.Run()
	writer.Flush()
	if mode == "build" {
		lastBuildTranscriptMu.Lock()
		lastBuildTranscript = writer.Transcript()
		lastBuildTranscriptMu.Unlock()
	}
	return err
}

func latestBuildTranscript() string {
	lastBuildTranscriptMu.Lock()
	defer lastBuildTranscriptMu.Unlock()
	return lastBuildTranscript
}

func detectFirmwareAction() {
	root := getText(edtProject)
	ctx, err := detectProject(root)
	if err != nil {
		message("Detect firmware failed", err.Error(), MB_OK|MB_ICONERROR)
		return
	}
	fw := detectFirmware(ctx)
	if fw == "" {
		message("Firmware not found", "No rtthread.elf/bin was found yet. Build the project in RT-Thread Studio, then click Detect Firmware again.", MB_OK|MB_ICONINFORMATION)
		return
	}
	if !firmwareFreshForGenerated(ctx, fw) {
		message("Firmware is older than generated test code", "The detected firmware was built before applications/ai_generated_test.c was generated. Press Build in RT-Thread Studio, then click Detect Firmware again.", MB_OK|MB_ICONINFORMATION)
		setText(lblBuildState, "Build    ◐ Build")
		return
	}
	setText(edtFirmware, fw)
	scrollEditToEnd(edtFirmware)
	setText(lblBuildState, "Build    ● Firmware")
	setText(lblRunState, "State    Firmware detected")
	setText(edtResult, "FIRMWARE DETECTED\r\n\r\n"+fw+"\r\n\r\nNext: Start QEMU / AI Run.")
	logLine("BUILD", "Detected firmware: "+fw)
}

func generatedSourceSignature(ctx projectContext) string {
	h := sha256.New()
	paths := []string{
		filepath.Join(ctx.Root, "applications", "ai_generated_test.c"),
		filepath.Join(ctx.Root, "applications", "ai_sil_runtime.c"),
		filepath.Join(ctx.Root, "applications", "ai_sil_runtime.h"),
		filepath.Join(ctx.Root, "applications", "ai_sil_gpio_backend.c"),
		filepath.Join(ctx.Root, "applications", "ai_sil_gpio_backend.h"),
		filepath.Join(ctx.Root, "drivers", "drv_gpio.c"),
	}
	if dynamic, _ := filepath.Glob(filepath.Join(ctx.Root, "applications", "ai_sil_ai_*")); len(dynamic) > 0 {
		paths = append(paths, dynamic...)
	}
	for _, path := range paths {
		io.WriteString(h, strings.ToLower(filepath.Clean(path)))
		io.WriteString(h, "\x00")
		data, err := os.ReadFile(path)
		if err != nil {
			io.WriteString(h, "<missing>")
		} else {
			h.Write(data)
		}
		io.WriteString(h, "\x00")
	}
	return hex.EncodeToString(h.Sum(nil))
}

func managedApplicationMetadataStale(ctx projectContext) (bool, string) {
	subdir := filepath.Join(ctx.Root, "Debug", "applications", "subdir.mk")
	txt := fileText(subdir)
	if strings.TrimSpace(txt) == "" {
		return false, ""
	}
	lower := strings.ToLower(txt)
	expected := []string{"ai_generated_test.c", "ai_sil_runtime.c", "ai_sil_gpio_backend.c"}
	if dynamic, _ := filepath.Glob(filepath.Join(ctx.Root, "applications", "ai_sil_ai_*.c")); len(dynamic) > 0 {
		for _, path := range dynamic {
			expected = append(expected, filepath.Base(path))
		}
	}
	for _, name := range expected {
		if fileExists(filepath.Join(ctx.Root, "applications", name)) && !strings.Contains(lower, strings.ToLower(name)) {
			return true, "Debug/applications/subdir.mk does not include " + name
		}
	}
	legacy := []string{"ai_sil_virtual_adc.c"}
	for _, name := range legacy {
		if strings.Contains(lower, strings.ToLower(name)) && !fileExists(filepath.Join(ctx.Root, "applications", name)) {
			return true, "Debug/applications/subdir.mk still references removed " + name
		}
	}
	return false, ""
}

func invalidateManagedApplicationFragment(ctx projectContext) {
	// subdir.mk is generated by Eclipse CDT Managed Build. Removing only this
	// generated fragment does not touch user source files and forces CDT to
	// regenerate the applications source list on the next headless Build.
	subdir := filepath.Join(ctx.Root, "Debug", "applications", "subdir.mk")
	_ = os.Remove(subdir)
}

func studioBuildSync(root, qemu string) (projectContext, string, error) {
	ctx, err := detectProject(root)
	if err != nil {
		return projectContext{}, "", err
	}
	isolationCount, isolationErr := isolateAISILBuildArtifacts(ctx)
	if isolationErr != nil {
		return ctx, "", fmt.Errorf("isolate .ai_sil build artifacts: %w", isolationErr)
	}
	if isolationCount > 0 {
		logLine("BUILD", fmt.Sprintf("Build Isolation: quarantined %d legacy source file(s) under %s; only applications/ai_sil_ai_* may compile.", isolationCount, filepath.Join(ctx.Root, ".ai_sil")))
	}
	if err := ensureBuildIntegration(ctx); err != nil {
		return ctx, "", err
	}
	studio := detectStudioExe(ctx, qemu)
	if studio == "" {
		return ctx, "", fmt.Errorf("RT-Thread Studio executable was not detected; generated sources are ready, but a Studio Build is required")
	}
	workspace := filepath.Dir(ctx.Root)
	tmpWS := filepath.Join(os.TempDir(), "ai_sil_rtt_studio_workspace_"+sanitizeFilePart(ctx.ProjectName))
	marker := filepath.Join(tmpWS, ".ai_sil_project_path")
	sigMarker := filepath.Join(tmpWS, ".ai_sil_source_signature")
	markerText := strings.TrimSpace(fileText(marker))
	currentSig := generatedSourceSignature(ctx)
	previousSig := strings.TrimSpace(fileText(sigMarker))
	staleManaged, staleReason := managedApplicationMetadataStale(ctx)
	needImport := !strings.EqualFold(filepath.Clean(markerText), filepath.Clean(ctx.Root)) || previousSig != currentSig || staleManaged || isolationCount > 0
	if needImport {
		if staleManaged {
			logLine("BUILD", "Managed-build metadata is stale: "+staleReason)
			logLine("BUILD", "Refreshing applications source list before incremental Build (user source files are not cleaned).")
			invalidateManagedApplicationFragment(ctx)
		}
		_ = os.RemoveAll(tmpWS)
	}
	_ = os.MkdirAll(tmpWS, 0755)
	logLine("BUILD", "===== RT-Thread Studio Build =====")
	logLine("BUILD", "RT-Thread Studio: "+studio)
	if needImport {
		logLine("BUILD", "Phase 1/3: preparing headless workspace and importing project")
	} else {
		logLine("BUILD", "Phase 1/3: reusing prepared headless workspace")
	}
	env := os.Environ()
	toolDirs := studioToolDirs(studio, qemu)
	if len(toolDirs) > 0 {
		env = append(env, "PATH="+strings.Join(toolDirs, string(os.PathListSeparator))+string(os.PathListSeparator)+os.Getenv("PATH"))
	}
	baseArgs := []string{"--launcher.suppressErrors", "-nosplash", "-application", "org.eclipse.cdt.managedbuilder.core.headlessbuild", "-data", tmpWS}
	if needImport {
		importArgs := append(append([]string{}, baseArgs...), "-import", ctx.Root)
		if err := runLoggedCommand(studio, importArgs, workspace, env, "import"); err != nil {
			logLine("BUILD", "Headless import returned: "+err.Error())
		} else {
			_ = os.WriteFile(marker, []byte(ctx.Root), 0644)
			_ = os.WriteFile(sigMarker, []byte(currentSig), 0644)
			logLine("BUILD", "Project imported/refreshed in headless workspace.")
		}
	}
	if !needImport {
		_ = os.WriteFile(sigMarker, []byte(currentSig), 0644)
	}
	logLine("BUILD", "Phase 2/3: building "+ctx.ProjectName+"/Debug (incremental managed build; full emitted transcript)")
	buildArgs := append(append([]string{}, baseArgs...), "-build", ctx.ProjectName+"/Debug")
	if err := runLoggedCommand(studio, buildArgs, workspace, env, "build"); err != nil {
		return ctx, "", fmt.Errorf("RT-Thread Studio managed build failed: %w", err)
	}
	logLine("BUILD", "Phase 3/3: verifying generated firmware")
	fw := detectFirmware(ctx)
	if fw == "" || !firmwareFreshForGenerated(ctx, fw) {
		return ctx, "", fmt.Errorf("Studio Build returned success but a fresh rtthread.elf/bin was not located automatically")
	}
	logLine("BUILD", "SUCCESS -> "+fw)
	return ctx, fw, nil
}

func buildSILFirmware() {
	showLogView("build")
	uiText(edtBuildConsole, "")
	root := getText(edtProject)
	qemu := getText(edtQemu)
	setBusy(true)
	uiText(lblBuildState, "Build    ◐ Studio")
	uiText(lblRunState, "State    Triggering RT-Thread Studio build...")
	go func() {
		defer setBusy(false)
		ctx, fw, err := studioBuildSync(root, qemu)
		if err != nil {
			uiText(lblBuildState, "Build    ○ Failed")
			uiText(lblRunState, "State    Studio Build failed; see Build Output")
			uiText(edtResult, "STUDIO BUILD FAILED\r\n\r\n"+err.Error()+"\r\n\r\nSee Build Output for the real compiler/make transcript. Generated sources remain in applications and main.c was not modified.")
			return
		}
		currentProjectMu.Lock()
		currentProject = ctx
		currentProjectMu.Unlock()
		uiText(edtFirmware, fw)
		postUI(func() { scrollEditToEnd(edtFirmware) })
		uiText(lblBuildState, "Build    ● Ready")
		uiText(lblRunState, "State    Studio build complete")
		commands := "ai_test_gpio"
		if gpioInputCapabilityReadyForRoot(ctx.Root) {
			commands += " / ai_test_gpio_input"
		}
		uiText(edtResult, fmt.Sprintf("STUDIO BUILD COMPLETE\r\n\r\nFirmware\r\n%s\r\n\r\nGenerated test command(s)\r\n%s\r\n\r\nNext\r\nStart QEMU / AI Run.", fw, commands))
	}()
}

func postUI(fn func()) {
	uiMu.Lock()
	uiQueue = append(uiQueue, fn)
	uiMu.Unlock()
	procPostMessageW.Call(hwndMain, WM_APP_DRAIN_UI, 0, 0)
}
func drainUI() {
	uiMu.Lock()
	q := uiQueue
	uiQueue = nil
	uiMu.Unlock()
	for _, fn := range q {
		fn()
	}
}
func uiText(hwnd uintptr, s string) {
	postUI(func() {
		setText(hwnd, s)
		syncPipelineState(hwnd, s)
	})
}
func uiAppendBuild(s string) { postUI(func() { appendText(edtBuildConsole, s) }) }

func pipelineLabel(step int, title, detail string, state string) string {
	mark := "○"
	switch state {
	case "done":
		mark = "✓"
	case "active":
		mark = "▶"
	case "warn":
		mark = "!"
	case "extendable":
		mark = "◐"
	case "skip":
		mark = "—"
	}
	return fmt.Sprintf("%s  %d  %s\r\n   %s", mark, step, title, detail)
}

func setPipelineStage(h uintptr, step int, title, detail, state string) {
	if h == 0 {
		return
	}
	setText(h, pipelineLabel(step, title, detail, state))
	fg := colorRef(78, 96, 120)
	bg := colorRef(248, 250, 253)
	brush := hBrushSoft
	switch state {
	case "done":
		fg, bg, brush = colorRef(22, 132, 83), colorRef(236, 250, 243), hBrushSuccess
	case "active":
		fg, bg, brush = colorRef(37, 99, 235), colorRef(239, 245, 255), hBrushAccentSoft
	case "warn", "extendable":
		fg, bg, brush = colorRef(190, 104, 45), colorRef(255, 246, 231), hBrushWarn
	case "skip":
		fg, bg, brush = colorRef(112, 126, 146), colorRef(248, 250, 253), hBrushSoft
	}
	setTheme(h, fg, bg, brush)
	// Native static controls can still feel flat; clipping them gives a subtle chip/card silhouette.
	rememberRounded(h, 205, 42, 10)
}

func refreshPipelinePreparation() {
	if lblPipeAnalyze == 0 {
		return
	}
	state := pipelinePrepProjectState
	detail := pipelinePrepProjectDetail
	if detail == "" {
		detail = "等待工程"
	}

	// Capability routing is an internal part of engineering preparation, not a
	// separate operator action. Only surface it here when it changes what can run.
	switch pipelinePrepCapabilityState {
	case "warn":
		state = "warn"
		detail = pipelinePrepCapabilityDetail
	case "active":
		state = "active"
		detail = pipelinePrepCapabilityDetail
	case "extendable":
		state = "extendable"
		detail = pipelinePrepCapabilityDetail
	case "done":
		if pipelinePrepProjectState == "done" {
			state = "done"
			detail = pipelinePrepCapabilityDetail
		}
	}
	setPipelineStage(lblPipeAnalyze, 1, "工程准备", detail, state)
}

func setPipelinePrepProject(detail, state string) {
	pipelinePrepProjectDetail = detail
	pipelinePrepProjectState = state
	refreshPipelinePreparation()
}

func setPipelinePrepCapability(detail, state string) {
	pipelinePrepCapabilityDetail = detail
	pipelinePrepCapabilityState = state
	refreshPipelinePreparation()
}

func uiPipelineCapabilityDecision(plan aiTestPlan) {
	postUI(func() {
		capability := normalizeRequestedCapability(plan.RequestedDriver, plan.RequestedCapability)
		switch plan.Route {
		case "run_existing":
			setPipelinePrepCapability(capability+" · READY", "done")
			buildText := strings.ToLower(getText(lblBuildState))
			if !strings.Contains(buildText, "studio") && !strings.Contains(buildText, "ready") && !strings.Contains(buildText, "firmware") {
				setPipelineStage(lblPipeBuild, 2, "构建", "本次无需重新构建", "skip")
			}
		case "capability_missing":
			if canAutoExtend(plan) {
				setPipelinePrepCapability(capability+" · 可自动扩展", "extendable")
				setPipelineStage(lblPipeBuild, 2, "构建", "等待自动扩展", "")
			} else {
				setPipelinePrepCapability(capability+" · MISSING", "warn")
				setPipelineStage(lblPipeBuild, 2, "构建", "当前能力不支持", "skip")
			}
		case "needs_clarification":
			setPipelinePrepCapability("需求待澄清", "warn")
			setPipelineStage(lblPipeBuild, 2, "构建", "等待明确测试目标", "skip")
		default:
			setPipelinePrepCapability("等待测试需求", "")
		}
		setPipelineStage(lblPipeExecute, 4, "执行测试", "等待运行", "")
		setPipelineStage(lblPipeDiagnose, 5, "结果分析", "等待执行结果", "")
	})
}

func syncPipelineState(hwnd uintptr, s string) {
	lower := strings.ToLower(s)
	switch hwnd {
	case lblProjectState:
		state := "active"
		detail := "解析工程结构"
		if strings.Contains(lower, "analyzed") {
			state, detail = "done", "工程已分析"
		}
		if strings.Contains(lower, "not ready") || strings.Contains(lower, "failed") {
			state, detail = "warn", "等待工程"
		}
		setPipelinePrepProject(detail, state)

	case lblCodegenState:
		// Code generation is only one possible implementation of a capability.
		// Do not mark the step READY merely because some GPIO code exists.
		if strings.Contains(lower, "out+in") {
			setPipelinePrepCapability("gpio_input_readback · READY", "done")
		} else if strings.Contains(lower, "gpio") {
			setPipelinePrepCapability("GPIO SIL 已生成，等待测试需求确认", "active")
		}

	case lblBuildState:
		state := "active"
		detail := "正在构建 Firmware"
		if strings.Contains(lower, "ready") || strings.Contains(lower, "firmware") {
			state, detail = "done", "Firmware Ready"
		}
		if strings.Contains(lower, "failed") {
			state, detail = "warn", "Build Failed"
		}
		setPipelineStage(lblPipeBuild, 2, "构建", detail, state)

	case lblQemuState:
		if strings.Contains(lower, "running") {
			setPipelineStage(lblPipeQemu, 3, "QEMU 运行", "进程已启动，等待 RT-Thread", "active")
		} else if strings.Contains(lower, "stopped") {
			setPipelineStage(lblPipeQemu, 3, "QEMU 运行", "未启动", "")
		}
	case lblRTState:
		if strings.Contains(lower, "ready") {
			setPipelineStage(lblPipeQemu, 3, "QEMU 运行", "RT-Thread Ready", "done")
		} else if strings.Contains(lower, "waiting") && session.running.Load() {
			setPipelineStage(lblPipeQemu, 3, "QEMU 运行", "等待 RT-Thread MSH", "active")
		}
	case lblSILState:
		if strings.Contains(lower, "ready") {
			setPipelineStage(lblPipeQemu, 3, "QEMU 运行", "SIL Runtime Ready", "done")
		}

	case lblRunState:
		switch {
		case strings.Contains(lower, "routing requirement") || strings.Contains(lower, "capability routing"):
			setPipelinePrepCapability("正在解析测试能力", "active")
		case strings.Contains(lower, "missing capability is auto-extendable") || strings.Contains(lower, "generating gpio input sil capability"):
			setPipelinePrepCapability("正在安装 gpio_input_readback", "active")
		case strings.Contains(lower, "capability extension blocked") || strings.Contains(lower, "capability auto-extension failed"):
			setPipelinePrepCapability("Capability 扩展失败", "warn")
		case strings.Contains(lower, "capability installed"):
			setPipelinePrepCapability("Capability READY", "done")
		case strings.Contains(lower, "diagnos"):
			state := "active"
			detail := "分析执行证据"
			if strings.Contains(lower, "ready") {
				state, detail = "done", "诊断已生成"
			} else if strings.Contains(lower, "failed") {
				state, detail = "warn", "诊断失败"
			}
			setPipelineStage(lblPipeDiagnose, 5, "结果分析", detail, state)
		case strings.Contains(lower, "starting ai-generated plan") ||
			strings.Contains(lower, "ai plan ") ||
			strings.Contains(lower, "starting gpio test") ||
			strings.Contains(lower, "fault matrix") ||
			strings.Contains(lower, "commands sent"):
			setPipelineStage(lblPipeExecute, 4, "执行测试", "正在运行测试用例", "active")
		case strings.Contains(lower, "testplan pass") || strings.Contains(lower, "fault matrix pass") || strings.Contains(lower, "finished: pass"):
			setPipelineStage(lblPipeExecute, 4, "执行测试", "执行完成 · PASS", "done")
		case strings.Contains(lower, "testplan fail") || strings.Contains(lower, "fault matrix fail") || strings.Contains(lower, "run failed") || strings.Contains(lower, "finished: fail"):
			setPipelineStage(lblPipeExecute, 4, "执行测试", "执行完成 · FAIL", "warn")
		}
	}
}

func uiAppendUart(s string)                       { postUI(func() { appendText(edtUartConsole, s) }) }
func uiAppendAgent(s string)                      { postUI(func() { appendText(edtAgentConsole, s) }) }
func uiMessage(title, text string, flags uintptr) { postUI(func() { message(title, text, flags) }) }
func uiRunSummary(cases int, verdict string, issues int, duration time.Duration) {
	postUI(func() {
		if lblSummaryCases != 0 {
			if cases >= 0 {
				setText(lblSummaryCases, fmt.Sprintf("%d 组", cases))
			} else {
				setText(lblSummaryCases, "—")
			}
		}
		if lblSummaryVerdict != 0 {
			v := strings.TrimSpace(verdict)
			if v == "" {
				v = "—"
			}
			setText(lblSummaryVerdict, v)
			switch strings.ToUpper(v) {
			case "PASS":
				setTheme(lblSummaryVerdict, colorRef(21, 139, 96), colorRef(255, 255, 255), hBrushWhite)
			case "FAIL":
				setTheme(lblSummaryVerdict, colorRef(201, 76, 61), colorRef(255, 255, 255), hBrushWhite)
			case "运行中", "RUNNING":
				setTheme(lblSummaryVerdict, colorRef(38, 85, 238), colorRef(255, 255, 255), hBrushWhite)
			default:
				setTheme(lblSummaryVerdict, colorRef(28, 45, 68), colorRef(255, 255, 255), hBrushWhite)
			}
		}
		if lblSummaryIssues != 0 {
			if issues >= 0 {
				setText(lblSummaryIssues, fmt.Sprintf("%d 组", issues))
			} else {
				setText(lblSummaryIssues, "—")
			}
		}
		if lblSummaryDuration != 0 {
			if duration > 0 {
				setText(lblSummaryDuration, fmt.Sprintf("%.1fs", duration.Seconds()))
			} else {
				setText(lblSummaryDuration, "—")
			}
		}
	})
}
func setTheme(hwnd uintptr, fg, bg uint32, brush uintptr) {
	if hwnd == 0 {
		return
	}
	controlThemes[hwnd] = controlTheme{fg: fg, bg: bg, brush: brush}
	procInvalidateRect.Call(hwnd, 0, 1)
}

func uiResultState(verdict, headline, detail string) {
	postUI(func() {
		if lblResultVerdict != 0 {
			v := strings.ToUpper(strings.TrimSpace(verdict))
			fg := colorRef(78, 96, 120)
			bg := colorRef(239, 244, 251)
			brush := hBrushSoft
			switch v {
			case "PASS", "READY", "DETECTED":
				fg = colorRef(21, 139, 96)
				bg = colorRef(229, 248, 239)
				brush = hBrushSuccess
			case "FAIL", "ERROR", "TIMEOUT", "MISSING":
				fg = colorRef(201, 76, 61)
				bg = colorRef(255, 239, 233)
				brush = hBrushWarn
			case "EXTENDABLE", "BUILDING":
				fg = colorRef(190, 104, 45)
				bg = colorRef(255, 246, 231)
				brush = hBrushWarn
			case "RUNNING":
				fg = colorRef(38, 85, 238)
			}
			setTheme(lblResultVerdict, fg, bg, brush)
			setText(lblResultVerdict, v)
		}
		if lblResultHeadline != 0 {
			setText(lblResultHeadline, headline)
		}
		if edtResult != 0 && detail != "" {
			setText(edtResult, detail)
		}
	})
}

func matrixStatus(text string) {
	postUI(func() {
		matrixViewRows = nil
		if lstMatrix != 0 {
			procSendMessageW.Call(lstMatrix, LB_RESETCONTENT, 0, 0)
			procSendMessageW.Call(lstMatrix, LB_ADDSTRING, 0, uintptr(unsafe.Pointer(utf16(text))))
		}
		if lblMatrixHint != 0 {
			setText(lblMatrixHint, "选择用例后，右侧会显示该条执行证据")
		}
	})
}

func setMatrixViewRows(rows []matrixViewRow, selectIndex int) {
	postUI(func() {
		matrixViewRows = append([]matrixViewRow(nil), rows...)
		if lstMatrix == 0 {
			return
		}
		procSendMessageW.Call(lstMatrix, LB_RESETCONTENT, 0, 0)
		for _, row := range rows {
			result := row.CaseResult
			if result == "" {
				result = "—"
			}
			line := fmt.Sprintf("%-20s  %-12s  %-9s  %-9s  %-13s  %s", row.CaseID, row.Fault, row.Observed, row.Expected, row.Detection, result)
			procSendMessageW.Call(lstMatrix, LB_ADDSTRING, 0, uintptr(unsafe.Pointer(utf16(line))))
		}
		if len(rows) == 0 {
			procSendMessageW.Call(lstMatrix, LB_ADDSTRING, 0, uintptr(unsafe.Pointer(utf16("等待回归结果..."))))
			return
		}
		if selectIndex < 0 || selectIndex >= len(rows) {
			selectIndex = 0
		}
		procSendMessageW.Call(lstMatrix, LB_SETCURSEL, uintptr(selectIndex), 0)
		showMatrixRow(selectIndex)
	})
}

func showMatrixRow(index int) {
	if index < 0 || index >= len(matrixViewRows) {
		return
	}
	row := matrixViewRows[index]
	verdict := row.CaseResult
	if verdict == "" {
		verdict = "PASS"
		if row.Detection == "Not Detected" || row.Detection == "Mismatch" || row.Detection == "FAIL" {
			verdict = "FAIL"
		}
	}
	if row.Observed == "TIMEOUT" {
		verdict = "TIMEOUT"
	}
	uiResultState(verdict, row.Headline, row.Detail)
}

func handleMatrixSelection() {
	if lstMatrix == 0 {
		return
	}
	r, _, _ := procSendMessageW.Call(lstMatrix, LB_GETCURSEL, 0, 0)
	if r == ^uintptr(0) {
		return
	}
	showMatrixRow(int(r))
}

func aiRowsForMatrix(plan aiTestPlan, rows []aiPlanRunRow) ([]matrixViewRow, int) {
	out := make([]matrixViewRow, 0, len(rows))
	selectIndex := 0
	selectedIssue := false
	for i, row := range rows {
		mv := matrixViewRow{CaseID: row.Case.ID, Fault: row.Case.Fault, Expected: row.Case.Expected}
		if row.ProtocolError != "" {
			mv.Observed = "PROTOCOL"
			mv.Detection = "Mismatch"
			mv.CaseResult = "FAIL"
			if strings.Contains(row.ProtocolError, "COMMAND_ECHO") || strings.Contains(row.ProtocolError, "RETRY_SEND") {
				mv.Headline = row.Case.ID + " · UART / MSH 命令传输异常"
				mv.Detail = fmt.Sprintf("Fault       %s\r\nExpected    %s\r\nObserved    COMMAND_TRANSPORT_ERROR\r\n\r\n%s\r\n\r\nWorkbench 已在规则执行前发现命令回显不一致；该 Case 不会被误报为功能 TIMEOUT。请查看 UART 与 Agent Events 中的 expected / received echo。", row.Case.Fault, row.Case.Expected, row.ProtocolError)
			} else {
				mv.Headline = row.Case.ID + " · SIL 协议同步异常"
				mv.Detail = fmt.Sprintf("Fault       %s\r\nExpected    %s\r\nObserved    PROTOCOL_MISMATCH\r\n\r\n%s\r\n\r\n这不是功能判定 TIMEOUT；Workbench 已收到与当前 Case 不一致的协议状态/结果，建议查看 UART 与 Agent Events。", row.Case.Fault, row.Case.Expected, row.ProtocolError)
			}
			if !selectedIssue {
				selectIndex, selectedIssue = i, true
			}
		} else if row.Timeout {
			mv.Observed = "TIMEOUT"
			mv.Detection = "Timeout"
			mv.CaseResult = "FAIL"
			mv.Headline = row.Case.ID + " · 未收到执行结果"
			if plan.RequestedCapability != "gpio_output_readback" && plan.RequestedCapability != "gpio_input_readback" {
				m, _ := generatedCapabilityReady(plan.RequestedCapability)
				mv.Detail = fmt.Sprintf("Scenario    %s\r\nExpected    %s\r\nObserved    TIMEOUT\r\n\r\n命令回显已通过，但未在超时窗口内收到 @SIL,GEN_RESULT。\r\nCommand     %s %s %s", row.Case.Fault, row.Case.Expected, m.TestCommand, plan.Target, row.Case.Fault)
			} else {
				mv.Detail = fmt.Sprintf("Fault       %s\r\nExpected    %s\r\nObserved    TIMEOUT\r\n\r\nRESET 与 Fault ACK 已完成，但未在超时窗口内收到 @SIL,RESULT。\r\n建议检查 ai_test_gpio_input / RT-Thread 执行是否卡住。", row.Case.Fault, row.Case.Expected)
			}
			if !selectedIssue {
				selectIndex, selectedIssue = i, true
			}
		} else {
			mv.Observed = row.Result.Verdict
			matched := row.Result.Verdict == row.Case.Expected
			if matched {
				mv.CaseResult = "PASS"
				if row.Case.Expected == "FAIL" {
					mv.Detection = "Detected"
				} else {
					mv.Detection = "—"
				}
			} else {
				mv.CaseResult = "FAIL"
				if row.Case.Expected == "FAIL" {
					mv.Detection = "Not Detected"
				} else {
					mv.Detection = "Mismatch"
				}
				if !selectedIssue {
					selectIndex, selectedIssue = i, true
				}
			}
			status := "期望行为已观测"
			if row.Case.Expected == "FAIL" && matched {
				status = "故障已成功检出"
			}
			if !matched {
				status = "执行结果与 TestPlan 不一致"
			}
			mv.Headline = row.Case.ID + " · " + status
			failed := "—"
			if len(row.Result.Failed) > 0 {
				failed = strings.Join(row.Result.Failed, ", ")
			}
			if row.Result.Kind == "GENERIC" {
				m, _ := generatedCapabilityReady(plan.RequestedCapability)
				mv.Detail = fmt.Sprintf("Capability     %s\r\nBackend        ai_generated_sil_harness\r\nDriver         %s\r\n\r\n功能结果      %s\r\n期望结果      %s\r\n检测状态      %s\r\n\r\nScenario      %s\r\nTarget        %s\r\nCommand       %s <target> <scenario>\r\n\r\n%s", plan.RequestedCapability, m.Driver, row.Result.Verdict, row.Case.Expected, mv.Detection, row.Case.Fault, plan.Target, m.TestCommand, m.Summary)
			} else if plan.RequestedCapability == "gpio_input_readback" {
				mv.Detail = fmt.Sprintf("Capability     gpio_input_readback\r\nBackend        virtual_gpio_external_input\r\n\r\n功能结果      %s\r\n期望结果      %s\r\n检测状态      %s\r\n\r\nFault         %s\r\n外部 HIGH / 读回  %d\r\n外部 LOW  / 读回  %d\r\nFailed rules  %s\r\n\r\n真实驱动路径\r\nrt_pin_mode/read → drivers/drv_gpio.c\r\nmode=%d  write=%d  read=%d\r\nHAL mode=%d  pull=%d  errors=%d", row.Result.Verdict, row.Case.Expected, mv.Detection, row.Case.Fault, row.Result.High, row.Result.Low, failed, row.Result.ModeCalls, row.Result.WriteCalls, row.Result.ReadCalls, row.Result.HALMode, row.Result.Pull, row.Result.Errors)
			} else {
				mv.Detail = fmt.Sprintf("Capability     gpio_output_readback\r\nBackend        virtual_gpio\r\n\r\n功能结果      %s\r\n期望结果      %s\r\n检测状态      %s\r\n\r\nFault         %s\r\n写 HIGH / 回读  %d\r\n写 LOW  / 回读  %d\r\nFailed rules  %s\r\n\r\n真实驱动路径\r\nrt_pin_write/read → drivers/drv_gpio.c\r\nmode=%d  write=%d  read=%d\r\nHAL mode=%d  pull=%d  errors=%d", row.Result.Verdict, row.Case.Expected, mv.Detection, row.Case.Fault, row.Result.High, row.Result.Low, failed, row.Result.ModeCalls, row.Result.WriteCalls, row.Result.ReadCalls, row.Result.HALMode, row.Result.Pull, row.Result.Errors)
			}
		}
		out = append(out, mv)
	}
	return out, selectIndex
}

func gpioRowsForMatrix(pin string, rows []gpioResult, timedOut []string) ([]matrixViewRow, int) {
	out := make([]matrixViewRow, 0, len(rows)+len(timedOut))
	selectIndex := 0
	selectedIssue := false
	for i, r := range rows {
		expected := "FAIL"
		if r.Fault == "none" {
			expected = "PASS"
		}
		matched := r.Verdict == expected
		detection := "—"
		caseResult := "PASS"
		if expected == "FAIL" && matched {
			detection = "Detected"
		}
		if !matched {
			caseResult = "FAIL"
			if expected == "FAIL" {
				detection = "Not Detected"
			} else {
				detection = "Mismatch"
			}
			if !selectedIssue {
				selectIndex, selectedIssue = i, true
			}
		}
		caseID := "GPIO_" + strings.ToUpper(r.Fault)
		if r.Fault == "none" {
			caseID = "GPIO_NORMAL"
		}
		status := "期望行为已观测"
		if expected == "FAIL" && matched {
			status = "故障已成功检出"
		}
		if !matched {
			status = "执行结果与期望不一致"
		}
		failed := "—"
		if len(r.Failed) > 0 {
			failed = strings.Join(r.Failed, ", ")
		}
		out = append(out, matrixViewRow{
			CaseID: caseID, Fault: r.Fault, Observed: r.Verdict, Expected: expected, Detection: detection, CaseResult: caseResult,
			Headline: caseID + " · " + status,
			Detail:   fmt.Sprintf("Target        %s\r\n功能结果      %s\r\n期望结果      %s\r\n检测状态      %s\r\n\r\nHIGH 回读     %d\r\nLOW 回读      %d\r\nFailed rules  %s\r\n\r\nDriver calls\r\nmode=%d  write=%d  read=%d", pin, r.Verdict, expected, detection, r.High, r.Low, failed, r.ModeCalls, r.WriteCalls, r.ReadCalls),
		})
	}
	for _, fault := range timedOut {
		i := len(out)
		out = append(out, matrixViewRow{CaseID: "GPIO_" + strings.ToUpper(fault), Fault: fault, Observed: "TIMEOUT", Expected: "—", Detection: "Timeout", CaseResult: "FAIL", Headline: "GPIO_" + strings.ToUpper(fault) + " · 未收到执行结果", Detail: "未在超时窗口内收到 @SIL,RESULT。"})
		if !selectedIssue {
			selectIndex, selectedIssue = i, true
		}
	}
	return out, selectIndex
}

func setBusy(b bool) {
	postUI(func() {
		enabled := uintptr(1)
		if b {
			enabled = 0
		}
		for _, h := range []uintptr{btnAIRun, btnGenerate, btnRun, btnRunMatrix, btnAIGeneratePlan, btnRunAIPlan, btnExtendCapability, btnAISILEngineer, btnAIDiagnose, btnExportReport, btnStartQemu, btnPreflight, btnVerifySIL, btnBrowseProject, btnAnalyzeProject, btnGenerateCode, btnBuildFirmware, btnDetectFirmware, btnBrowseQemu, btnBrowseFirmware} {
			if h != 0 {
				procEnableWindow.Call(h, enabled)
			}
		}
		if btnStop != 0 {
			procEnableWindow.Call(btnStop, 1)
		}
	})
}

func timestamp() string { return time.Now().Format("15:04:05") }
func logLine(kind, text string) {
	line := fmt.Sprintf("%s  [%-6s] %s\r\n", timestamp(), kind, text)
	if kind == "BUILD" {
		uiAppendBuild(line)
		return
	}
	uiAppendAgent(line)
}

func showLogView(view string) {
	postUI(func() {
		activeLogView = view
		procShowWindow.Call(edtBuildConsole, SW_HIDE)
		procShowWindow.Call(edtUartConsole, SW_HIDE)
		procShowWindow.Call(edtAgentConsole, SW_HIDE)
		setButtonKind(btnShowBuild, "ghost")
		setButtonKind(btnShowUart, "ghost")
		setButtonKind(btnShowAgent, "ghost")
		switch view {
		case "uart":
			procShowWindow.Call(edtUartConsole, SW_SHOW)
			setButtonKind(btnShowUart, "tab-active")
		case "agent":
			procShowWindow.Call(edtAgentConsole, SW_SHOW)
			setButtonKind(btnShowAgent, "tab-active")
		default:
			activeLogView = "build"
			procShowWindow.Call(edtBuildConsole, SW_SHOW)
			setButtonKind(btnShowBuild, "tab-active")
		}
	})
}

func clearActiveLog() {
	switch activeLogView {
	case "uart":
		setText(edtUartConsole, "")
	case "agent":
		setText(edtAgentConsole, "")
	default:
		setText(edtBuildConsole, "")
	}
}

func parseRequirement(s string) testCase {
	tc := testCase{Target: "gpio", Pin: "PB.0", Fault: "none"}
	upper := strings.ToUpper(s)
	rePin := regexp.MustCompile(`P([A-K])\.?([0-9]{1,2})`)
	if m := rePin.FindStringSubmatch(upper); len(m) == 3 {
		n, _ := strconv.Atoi(m[2])
		if n >= 0 && n <= 15 {
			tc.Pin = "P" + m[1] + "." + strconv.Itoa(n)
		}
	}
	lower := strings.ToLower(s)
	if strings.Contains(lower, "stuck low") || strings.Contains(lower, "stuck_low") || strings.Contains(s, "卡死低") || strings.Contains(s, "固定低") {
		tc.Fault = "stuck_low"
	} else if strings.Contains(lower, "stuck high") || strings.Contains(lower, "stuck_high") || strings.Contains(s, "卡死高") || strings.Contains(s, "固定高") {
		tc.Fault = "stuck_high"
	}
	return tc
}

func renderCase(tc testCase) string {
	obj := map[string]any{
		"case_id": "GPIO_SIL_001",
		"target": map[string]any{
			"host": "Windows", "mcu": "STM32F407", "machine": "stm32f407-atk-explorer", "os": "RT-Thread", "driver": "drivers/drv_gpio.c",
		},
		"pin":             tc.Pin,
		"stimulus":        []string{"PIN_MODE_OUTPUT", "WRITE_HIGH", "READBACK_HIGH", "WRITE_LOW", "READBACK_LOW"},
		"fault_injection": map[string]any{"type": tc.Fault},
		"assertions":      []string{"PIN_LOOKUP_VALID", "HIGH_READBACK", "LOW_READBACK", "DRV_GPIO_MODE_CALLED", "DRV_GPIO_WRITE_CALLED", "DRV_GPIO_READ_CALLED"},
	}
	b, _ := json.MarshalIndent(obj, "", "  ")
	return string(b)
}

func generateCase() testCase {
	tc := parseRequirement(getText(edtPrompt))
	currentCaseMu.Lock()
	currentCase = tc
	currentCaseMu.Unlock()
	setText(edtTestcase, renderCase(tc))
	setText(lblPlannerState, "Planner  ● Local")
	setText(lblRunState, "State    GPIO TestCase ready")
	if hwndMain != 0 {
		logLine("PLAN", "GPIO TestCase generated from requirement (local planner).")
	}
	return tc
}

func canonicalGPIOPin(pin string) (string, bool) {
	pin = strings.ToUpper(strings.TrimSpace(pin))
	re := regexp.MustCompile(`^P([A-K])\.?([0-9]{1,2})$`)
	m := re.FindStringSubmatch(pin)
	if len(m) != 3 {
		return "", false
	}
	n, err := strconv.Atoi(m[2])
	if err != nil || n < 0 || n > 15 {
		return "", false
	}
	return "P" + m[1] + "." + strconv.Itoa(n), true
}

func gpioInputCapabilityReadyForRoot(root string) bool {
	if strings.TrimSpace(root) == "" {
		return false
	}
	return strings.Contains(fileText(filepath.Join(root, "applications", "ai_generated_test.c")), "#define AI_SIL_GPIO_INPUT_CAPABILITY 1")
}

func gpioInputCapabilityReady() bool {
	currentProjectMu.Lock()
	root := currentProject.Root
	currentProjectMu.Unlock()
	return gpioInputCapabilityReadyForRoot(root)
}

func capabilitySlug(capability string) string {
	c := strings.ToLower(strings.TrimSpace(capability))
	re := regexp.MustCompile(`[^a-z0-9_]+`)
	c = re.ReplaceAllString(c, "_")
	c = strings.Trim(c, "_")
	if c == "" {
		return "generated_capability"
	}
	if len(c) > 64 {
		c = c[:64]
	}
	return c
}

func generatedManifestPath(root, capability string) string {
	return filepath.Join(root, ".ai_sil", "generated", capabilitySlug(capability), "manifest.json")
}

func writeGeneratedCapabilityManifest(root string, m generatedCapabilityManifest) error {
	if strings.TrimSpace(root) == "" {
		return fmt.Errorf("project root is empty")
	}
	path := generatedManifestPath(root, m.Capability)
	if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
		return err
	}
	b, err := json.MarshalIndent(m, "", "  ")
	if err != nil {
		return err
	}
	return os.WriteFile(path, b, 0644)
}

func loadGeneratedCapabilityManifest(root, capability string) (generatedCapabilityManifest, bool) {
	var m generatedCapabilityManifest
	if strings.TrimSpace(root) == "" || strings.TrimSpace(capability) == "" {
		return m, false
	}
	b, err := os.ReadFile(generatedManifestPath(root, capability))
	if err != nil || json.Unmarshal(b, &m) != nil {
		return generatedCapabilityManifest{}, false
	}
	m.Driver = strings.ToLower(strings.TrimSpace(m.Driver))
	m.Capability = normalizeRequestedCapability(m.Driver, m.Capability)
	return m, m.Capability != ""
}

func allGeneratedCapabilityManifests(root string) []generatedCapabilityManifest {
	paths, _ := filepath.Glob(filepath.Join(root, ".ai_sil", "generated", "*", "manifest.json"))
	out := make([]generatedCapabilityManifest, 0, len(paths))
	for _, path := range paths {
		var m generatedCapabilityManifest
		b, err := os.ReadFile(path)
		if err != nil || json.Unmarshal(b, &m) != nil {
			continue
		}
		m.Driver = strings.ToLower(strings.TrimSpace(m.Driver))
		m.Capability = normalizeRequestedCapability(m.Driver, m.Capability)
		if m.Capability != "" {
			out = append(out, m)
		}
	}
	return out
}

func generatedCapabilityReady(capability string) (generatedCapabilityManifest, bool) {
	currentProjectMu.Lock()
	ctx := currentProject
	currentProjectMu.Unlock()
	m, ok := loadGeneratedCapabilityManifest(ctx.Root, capability)
	if !ok || !strings.EqualFold(m.Status, "ready") {
		return m, false
	}
	latest := time.Time{}
	for _, name := range m.Files {
		path := filepath.Join(ctx.Root, "applications", filepath.Base(name))
		st, err := os.Stat(path)
		if err != nil || st.IsDir() {
			return m, false
		}
		if st.ModTime().After(latest) {
			latest = st.ModTime()
		}
	}
	fw := detectFirmware(ctx)
	if fw == "" {
		return m, false
	}
	if st, err := os.Stat(fw); err != nil || st.ModTime().Before(latest) {
		return m, false
	}
	return m, true
}

func uiCapabilityBadge(root, stage string) {
	postUI(func() {
		if lblCapabilityBadge == 0 {
			return
		}
		ready := gpioInputCapabilityReadyForRoot(root)
		text := "GPIO OUT ●   IN ◐ EXT"
		fg := colorRef(223, 119, 76)
		switch strings.ToLower(strings.TrimSpace(stage)) {
		case "building", "installing":
			text = "GPIO OUT ●   IN ◐ BUILD"
			fg = colorRef(38, 85, 238)
		case "error":
			text = "GPIO OUT ●   IN ! ERROR"
			fg = colorRef(201, 76, 61)
		default:
			if ready {
				text = "GPIO OUT ●   IN ●"
				fg = colorRef(21, 139, 96)
			}
		}
		setTheme(lblCapabilityBadge, fg, colorRef(255, 255, 255), hBrushWhite)
		setText(lblCapabilityBadge, text)
	})
}

func normalizeRequestedCapability(driver, capability string) string {
	driver = strings.ToLower(strings.TrimSpace(driver))
	c := strings.ToLower(strings.TrimSpace(capability))
	c = strings.ReplaceAll(c, "-", "_")
	c = strings.ReplaceAll(c, " ", "_")
	if driver == "gpio" {
		if strings.Contains(c, "irq") || strings.Contains(c, "interrupt") || strings.Contains(c, "edge") {
			return "gpio_irq"
		}
		if strings.Contains(c, "input") {
			return "gpio_input_readback"
		}
		if c == "" || strings.Contains(c, "output") || strings.Contains(c, "write") || strings.Contains(c, "readback") || c == "gpio" {
			return "gpio_output_readback"
		}
	}
	if c == "" && driver != "" {
		return driver + "_test"
	}
	return c
}

func capabilityReady(capability string) bool {
	switch capability {
	case "gpio_output_readback":
		return true
	case "gpio_input_readback":
		return gpioInputCapabilityReady()
	default:
		_, ready := generatedCapabilityReady(capability)
		return ready
	}
}

func validateAIPlan(plan *aiTestPlan) error {
	plan.Route = strings.ToLower(strings.TrimSpace(plan.Route))
	plan.RequestedDriver = strings.ToLower(strings.TrimSpace(plan.RequestedDriver))
	plan.RequestedCapability = normalizeRequestedCapability(plan.RequestedDriver, plan.RequestedCapability)
	plan.Reason = strings.TrimSpace(plan.Reason)
	plan.Driver = strings.ToLower(strings.TrimSpace(plan.Driver))
	plan.Target = strings.TrimSpace(plan.Target)

	// Backward compatibility for a plan created by the immediately previous v0.5 build.
	if plan.Route == "" && plan.Driver == "gpio" && len(plan.Cases) > 0 {
		plan.Route = "run_existing"
		plan.RequestedDriver = "gpio"
		plan.RequestedCapability = "gpio_output_readback"
		if plan.Reason == "" {
			plan.Reason = "Matches the installed GPIO output/readback SIL capability."
		}
	}
	if plan.RequestedDriver == "" {
		plan.RequestedDriver = plan.Driver
	}
	plan.RequestedCapability = normalizeRequestedCapability(plan.RequestedDriver, plan.RequestedCapability)
	if strings.TrimSpace(plan.Version) == "" {
		plan.Version = "1.0"
	}

	switch plan.Route {
	case "run_existing":
		if !capabilityReady(plan.RequestedCapability) {
			return fmt.Errorf("requested capability %q is not installed in the current firmware", plan.RequestedCapability)
		}
		if len(plan.Cases) < 1 || len(plan.Cases) > 20 {
			return fmt.Errorf("case count must be 1..20 for route=run_existing, got %d", len(plan.Cases))
		}

		// Built-in GPIO capabilities keep their stricter deterministic validator.
		if plan.RequestedCapability == "gpio_output_readback" || plan.RequestedCapability == "gpio_input_readback" {
			if plan.Driver != "gpio" || plan.RequestedDriver != "gpio" {
				return fmt.Errorf("built-in GPIO capability requires driver=gpio")
			}
			pin, ok := canonicalGPIOPin(plan.Target)
			if !ok {
				return fmt.Errorf("invalid GPIO target %q; expected PA.0 .. PK.15", plan.Target)
			}
			plan.Target = pin
			seen := map[string]bool{}
			for i := range plan.Cases {
				c := &plan.Cases[i]
				c.ID = strings.TrimSpace(c.ID)
				c.Fault = strings.ToLower(strings.TrimSpace(c.Fault))
				c.Expected = strings.ToUpper(strings.TrimSpace(c.Expected))
				c.Description = strings.TrimSpace(c.Description)
				if c.ID == "" {
					return fmt.Errorf("case %d has empty id", i+1)
				}
				if seen[c.ID] {
					return fmt.Errorf("duplicate case id %q", c.ID)
				}
				seen[c.ID] = true
				switch c.Fault {
				case "none":
					if c.Expected != "PASS" {
						return fmt.Errorf("case %s: fault=none must expect PASS", c.ID)
					}
				case "stuck_low", "stuck_high":
					if c.Expected != "FAIL" {
						return fmt.Errorf("case %s: injected fault %s must expect FAIL", c.ID, c.Fault)
					}
				default:
					return fmt.Errorf("case %s uses unsupported fault %q", c.ID, c.Fault)
				}
			}
			if plan.Reason == "" {
				plan.Reason = "Matches an installed GPIO SIL capability."
			}
			return nil
		}

		// AI-generated capabilities are executable only after their generated
		// manifest reached status=ready after Build plus a QEMU command/protocol readiness probe.
		// Functional behavior is NOT part of capability readiness; it is judged later by Test Cases.
		m, ready := generatedCapabilityReady(plan.RequestedCapability)
		if !ready {
			return fmt.Errorf("generated capability %q is not READY after Build/QEMU command probe", plan.RequestedCapability)
		}
		if plan.Driver == "" {
			plan.Driver = m.Driver
		}
		if plan.RequestedDriver == "" {
			plan.RequestedDriver = m.Driver
		}
		if !strings.EqualFold(plan.Driver, m.Driver) || !strings.EqualFold(plan.RequestedDriver, m.Driver) {
			return fmt.Errorf("generated capability %s belongs to driver %s", m.Capability, m.Driver)
		}
		if plan.Target == "" || len(plan.Target) > 96 {
			return fmt.Errorf("generated capability requires a concise non-empty target")
		}
		if !regexp.MustCompile(`^[A-Za-z0-9_.:/-]+$`).MatchString(plan.Target) {
			return fmt.Errorf("unsafe target token %q; only letters, numbers, . _ : / - are allowed", plan.Target)
		}
		allowed := map[string]bool{}
		for _, scenario := range m.Scenarios {
			allowed[strings.ToLower(strings.TrimSpace(scenario))] = true
		}
		seen := map[string]bool{}
		for i := range plan.Cases {
			c := &plan.Cases[i]
			c.ID = strings.TrimSpace(c.ID)
			c.Fault = strings.ToLower(strings.TrimSpace(c.Fault))
			c.Expected = strings.ToUpper(strings.TrimSpace(c.Expected))
			c.Description = strings.TrimSpace(c.Description)
			if c.ID == "" || len(c.ID) > 64 || !regexp.MustCompile(`^[A-Za-z0-9_.-]+$`).MatchString(c.ID) {
				return fmt.Errorf("case %d has invalid id %q", i+1, c.ID)
			}
			if seen[c.ID] {
				return fmt.Errorf("duplicate case id %q", c.ID)
			}
			seen[c.ID] = true
			if !allowed[c.Fault] {
				return fmt.Errorf("case %s uses scenario %q not allowed by generated capability", c.ID, c.Fault)
			}
			if c.Expected != "PASS" && c.Expected != "FAIL" {
				return fmt.Errorf("case %s expected must be PASS or FAIL", c.ID)
			}
		}
		if plan.Reason == "" {
			plan.Reason = "Matches an AI-generated SIL capability that passed Build and QEMU command/protocol readiness checks."
		}
		return nil

	case "capability_missing":
		if len(plan.Cases) != 0 {
			return fmt.Errorf("route=capability_missing must not contain executable cases")
		}
		if plan.RequestedDriver == "" || plan.RequestedDriver == "unknown" {
			return fmt.Errorf("route=capability_missing must identify the requested driver")
		}
		if plan.Driver == "" {
			plan.Driver = plan.RequestedDriver
		}
		if plan.RequestedCapability == "" {
			plan.RequestedCapability = plan.RequestedDriver + "_test"
		}
		if plan.Reason == "" {
			return fmt.Errorf("route=capability_missing requires a reason")
		}
		return nil

	case "needs_clarification":
		if len(plan.Cases) != 0 {
			return fmt.Errorf("route=needs_clarification must not contain executable cases")
		}
		if plan.Reason == "" {
			return fmt.Errorf("route=needs_clarification requires a reason")
		}
		if plan.RequestedDriver == "" {
			plan.RequestedDriver = "unknown"
		}
		return nil

	default:
		return fmt.Errorf("unsupported capability route %q", plan.Route)
	}
}

func capabilityRouteLabel(route string) string {
	switch route {
	case "run_existing":
		return "READY - RUN EXISTING SIL"
	case "capability_missing":
		return "CAPABILITY MISSING - DO NOT EXECUTE"
	case "needs_clarification":
		return "NEEDS CLARIFICATION - DO NOT EXECUTE"
	default:
		return strings.ToUpper(route)
	}
}

func renderCapabilityDecision(plan aiTestPlan) string {
	var sb strings.Builder
	inputReady := gpioInputCapabilityReady()
	sb.WriteString("CAPABILITY ROUTER\r\n")
	sb.WriteString("========================================\r\n")
	sb.WriteString(fmt.Sprintf("Route      : %s\r\n", capabilityRouteLabel(plan.Route)))
	sb.WriteString(fmt.Sprintf("Driver     : %s\r\n", plan.RequestedDriver))
	sb.WriteString(fmt.Sprintf("Capability : %s\r\n", plan.RequestedCapability))
	if strings.TrimSpace(plan.Target) != "" {
		sb.WriteString(fmt.Sprintf("Target     : %s\r\n", plan.Target))
	}
	sb.WriteString(fmt.Sprintf("Reason     : %s\r\n\r\n", plan.Reason))
	sb.WriteString("Installed SIL capabilities\r\n")
	sb.WriteString("  READY          GPIO output + write/readback\r\n")
	sb.WriteString("                 faults: none / stuck_low / stuck_high\r\n")
	if inputReady {
		sb.WriteString("  READY          GPIO input + external-level readback\r\n")
		sb.WriteString("                 faults: none / stuck_low / stuck_high\r\n")
	} else {
		sb.WriteString("  EXTENDABLE     GPIO input + external-level readback\r\n")
	}
	currentProjectMu.Lock()
	root := currentProject.Root
	currentProjectMu.Unlock()
	for _, m := range allGeneratedCapabilityManifests(root) {
		if strings.EqualFold(m.Status, "ready") {
			sb.WriteString(fmt.Sprintf("  READY (AI)     %s / %s · scenarios=%s\r\n", m.Driver, m.Capability, strings.Join(m.Scenarios, "|")))
		}
	}
	sb.WriteString("  OTHER          未列为 READY 的能力仍视为未安装，可交给 AI SIL Engineer 生成候选 Harness\r\n")
	if plan.Route == "capability_missing" {
		if plan.RequestedDriver == "gpio" && plan.RequestedCapability == "gpio_input_readback" && !inputReady {
			sb.WriteString("\r\nThis requirement matches a safe built-in extension template. Use Extend Capability, or AI Plan + Run will generate it, run Studio Build, re-plan, and continue automatically.\r\n")
		} else {
			sb.WriteString("\r\nNo MSH command was executed. The Capability Builder will inspect the project and explain whether this driver can be extended safely.\r\n")
		}
	} else if plan.Route == "needs_clarification" {
		sb.WriteString("\r\nNo MSH command was executed. Refine the requirement, for example by naming the driver/target and behavior to test.\r\n")
	}
	return sb.String()
}

func renderAIPlan(plan aiTestPlan) string {
	var sb strings.Builder
	sb.WriteString(renderCapabilityDecision(plan))
	if plan.Route == "run_existing" {
		sb.WriteString("\r\nAI TEST PLAN\r\n")
		sb.WriteString("========================================\r\n")
		sb.WriteString(fmt.Sprintf("Driver : %s\r\n", plan.Driver))
		sb.WriteString(fmt.Sprintf("Capability : %s\r\n", plan.RequestedCapability))
		sb.WriteString(fmt.Sprintf("Target : %s\r\n", plan.Target))
		sb.WriteString(fmt.Sprintf("Cases  : %d\r\n\r\n", len(plan.Cases)))
		sb.WriteString("#   Case ID              Fault        Expect   Description\r\n")
		sb.WriteString("--  -------------------  -----------  -------  ------------------------------\r\n")
		for i, c := range plan.Cases {
			sb.WriteString(fmt.Sprintf("%-2d  %-19s  %-11s  %-7s  %s\r\n", i+1, c.ID, c.Fault, c.Expected, c.Description))
		}
	}
	sb.WriteString("\r\nRAW JSON\r\n")
	sb.WriteString("----------------------------------------\r\n")
	b, _ := json.MarshalIndent(plan, "", "  ")
	// Native Win32 multiline EDIT controls render CRLF most reliably.
	sb.WriteString(strings.ReplaceAll(string(b), "\n", "\r\n"))
	return sb.String()
}

func aiProjectContext() map[string]any {
	currentProjectMu.Lock()
	ctx := currentProject
	currentProjectMu.Unlock()
	caps := []map[string]any{
		{
			"driver":       "gpio",
			"capability":   "gpio_output_readback",
			"status":       "ready",
			"source":       "drivers/drv_gpio.c",
			"rtthread_api": []string{"rt_pin_get", "rt_pin_mode", "rt_pin_write", "rt_pin_read"},
			"backend":      "virtual_gpio",
			"targets":      "PA.0..PK.15",
			"scenarios":    []string{"none", "stuck_low", "stuck_high"},
			"faults":       []string{"none", "stuck_low", "stuck_high"},
			"test_command": "ai_test_gpio <pin>",
		},
	}
	installedDrivers := map[string]bool{"gpio": true}
	if gpioInputCapabilityReadyForRoot(ctx.Root) {
		caps = append(caps, map[string]any{
			"driver":       "gpio",
			"capability":   "gpio_input_readback",
			"status":       "ready",
			"source":       "drivers/drv_gpio.c",
			"rtthread_api": []string{"rt_pin_get", "rt_pin_mode", "rt_pin_read"},
			"backend":      "virtual_gpio_external_input",
			"targets":      "PA.0..PK.15",
			"scenarios":    []string{"none", "stuck_low", "stuck_high"},
			"faults":       []string{"none", "stuck_low", "stuck_high"},
			"test_command": "ai_test_gpio_input <pin>",
		})
	}
	for _, m := range allGeneratedCapabilityManifests(ctx.Root) {
		readyManifest, ready := generatedCapabilityReady(m.Capability)
		if !ready {
			continue
		}
		m = readyManifest
		installedDrivers[m.Driver] = true
		caps = append(caps, map[string]any{
			"driver":       m.Driver,
			"capability":   m.Capability,
			"status":       "ready",
			"source":       "AI-generated isolated test harness",
			"backend":      "ai_generated_sil_harness",
			"targets":      "use the concrete target requested by the user",
			"scenarios":    m.Scenarios,
			"test_command": m.TestCommand + " <target> <scenario>",
			"summary":      m.Summary,
		})
	}
	notInstalled := []string{}
	if !gpioInputCapabilityReadyForRoot(ctx.Root) {
		notInstalled = append(notInstalled, "gpio_input_readback (safe built-in auto-extension available)")
	}
	for _, d := range []string{"adc", "spi", "can", "uart", "i2c", "pwm"} {
		if !installedDrivers[d] {
			notInstalled = append(notInstalled, d)
		}
	}
	return map[string]any{
		"project": map[string]any{
			"name":         ctx.ProjectName,
			"mcu":          ctx.MCU,
			"rt_thread":    ctx.RTThread,
			"qemu_machine": ctx.QemuMachine,
		},
		"installed_capabilities": caps,
		"not_installed_examples": notInstalled,
		"routing_policy":         "route=run_existing only for a capability listed with status=ready. For AI-generated capabilities, use only the exact scenarios advertised by that capability. Missing capabilities must route to capability_missing; the host may offer AI SIL Engineer code generation after planning. Never reinterpret an unsupported request as GPIO.",
	}
}

type aiProviderConfig struct {
	ID           string
	Label        string
	DefaultModel string
	Endpoint     string
	EnvKeys      []string
	APIStyle     string
}

var aiProviders = []aiProviderConfig{
	{ID: "gpt", Label: "GPT / OpenAI", DefaultModel: "gpt-5.6-luna", Endpoint: "https://api.openai.com/v1/responses", EnvKeys: []string{"OPENAI_API_KEY"}, APIStyle: "responses_schema"},
	{ID: "deepseek", Label: "DeepSeek", DefaultModel: "deepseek-flash", Endpoint: "https://api.deepseek.com/chat/completions", EnvKeys: []string{"DEEPSEEK_API_KEY"}, APIStyle: "chat_json"},
	{ID: "glm", Label: "GLM / Zhipu", DefaultModel: "glm-5-turbo", Endpoint: "https://open.bigmodel.cn/api/paas/v4/chat/completions", EnvKeys: []string{"ZHIPUAI_API_KEY", "GLM_API_KEY", "BIGMODEL_API_KEY"}, APIStyle: "chat_prompt_json"},
}

func aiProviderByIndex(idx int) aiProviderConfig {
	if idx < 0 || idx >= len(aiProviders) {
		return aiProviders[0]
	}
	return aiProviders[idx]
}

func currentAIEndpoint(p aiProviderConfig) string {
	aiConfigMu.Lock()
	override := strings.TrimSpace(aiEndpointOverride)
	aiConfigMu.Unlock()
	if override != "" {
		return override
	}
	return p.Endpoint
}

func currentRoleModel(role string, p aiProviderConfig) string {
	aiConfigMu.Lock()
	defer aiConfigMu.Unlock()
	switch role {
	case "codegen":
		if strings.TrimSpace(aiCodegenModel) != "" {
			return strings.TrimSpace(aiCodegenModel)
		}
	case "repair":
		if strings.TrimSpace(aiRepairModel) != "" {
			return strings.TrimSpace(aiRepairModel)
		}
	case "diagnosis":
		if strings.TrimSpace(aiDiagnosisModel) != "" {
			return strings.TrimSpace(aiDiagnosisModel)
		}
	}
	if edtAIModel != 0 && strings.TrimSpace(getText(edtAIModel)) != "" {
		return strings.TrimSpace(getText(edtAIModel))
	}
	return p.DefaultModel
}

func providerModelPresets(p aiProviderConfig) []string {
	switch p.ID {
	case "gpt":
		return []string{"gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol"}
	case "deepseek":
		return []string{"deepseek-flash", "deepseek-v4-pro"}
	case "glm":
		return []string{"glm-5-turbo"}
	}
	return []string{p.DefaultModel}
}

func updateAISummary() {
	if lblAISummary == 0 {
		return
	}
	p := selectedAIProvider()
	model := currentRoleModel("planner", p)
	aiConfigMu.Lock()
	verified := aiConnectionVerified
	status := aiConnectionStatus
	aiConfigMu.Unlock()
	state := "○ 未验证"
	if verified {
		state = "● 已连接"
	} else if strings.TrimSpace(status) != "" && status != "未验证" {
		state = "! " + status
	}
	setText(lblAISummary, fmt.Sprintf("%s · %s · %s", p.Label, model, state))
}

func aiSettingsFingerprint(providerID, endpoint, key, planner, codegen, repair, diagnosis string) string {
	joined := strings.Join([]string{providerID, strings.TrimSpace(endpoint), key, strings.TrimSpace(planner), strings.TrimSpace(codegen), strings.TrimSpace(repair), strings.TrimSpace(diagnosis)}, "\x1f")
	sum := sha256.Sum256([]byte(joined))
	return hex.EncodeToString(sum[:])
}

func markAIConnectionUnverified(reason string) {
	aiConfigMu.Lock()
	aiConnectionVerified = false
	if strings.TrimSpace(reason) == "" {
		reason = "未验证"
	}
	aiConnectionStatus = reason
	aiConnectionLatency = 0
	aiConfigMu.Unlock()
	updateAISummary()
}

func selectedAIProvider() aiProviderConfig {
	idx := comboSelected(cmbAIProvider)
	if idx < 0 || idx >= len(aiProviders) {
		return aiProviders[0]
	}
	return aiProviders[idx]
}

func updateAIProviderUI(resetModel bool) {
	p := selectedAIProvider()
	if resetModel || strings.TrimSpace(getText(edtAIModel)) == "" {
		setText(edtAIModel, p.DefaultModel)
	}
	setText(lblAIEndpoint, "Endpoint: "+p.Endpoint)
	setText(lblAIKeyHint, "Key: memory-only; blank uses "+strings.Join(p.EnvKeys, " / "))
}

func providerAPIKey(p aiProviderConfig) string {
	key := strings.TrimSpace(getText(edtAPIKey))
	if key != "" {
		return key
	}
	for _, env := range p.EnvKeys {
		if v := strings.TrimSpace(os.Getenv(env)); v != "" {
			return v
		}
	}
	return ""
}

func aiPlanSchema() map[string]any {
	return map[string]any{
		"type": "object",
		"properties": map[string]any{
			"version":              map[string]any{"type": "string"},
			"route":                map[string]any{"type": "string", "enum": []string{"run_existing", "capability_missing", "needs_clarification"}},
			"requested_driver":     map[string]any{"type": "string"},
			"requested_capability": map[string]any{"type": "string"},
			"reason":               map[string]any{"type": "string"},
			"driver":               map[string]any{"type": "string"},
			"target":               map[string]any{"type": "string"},
			"cases": map[string]any{
				"type": "array", "minItems": 0, "maxItems": 20,
				"items": map[string]any{
					"type": "object",
					"properties": map[string]any{
						"id":          map[string]any{"type": "string"},
						"fault":       map[string]any{"type": "string", "minLength": 1, "maxLength": 64},
						"expected":    map[string]any{"type": "string", "enum": []string{"PASS", "FAIL"}},
						"description": map[string]any{"type": "string"},
					},
					"required":             []string{"id", "fault", "expected", "description"},
					"additionalProperties": false,
				},
			},
		},
		"required": []string{
			"version", "route", "requested_driver", "requested_capability", "reason", "driver", "target", "cases",
		},
		"additionalProperties": false,
	}
}

func aiSILCodeSchema() map[string]any {
	return map[string]any{
		"type": "object",
		"properties": map[string]any{
			"version":       map[string]any{"type": "string"},
			"driver":        map[string]any{"type": "string"},
			"capability":    map[string]any{"type": "string"},
			"summary":       map[string]any{"type": "string"},
			"test_command":  map[string]any{"type": "string"},
			"smoke_command": map[string]any{"type": "string"},
			"scenarios": map[string]any{
				"type": "array", "minItems": 1, "maxItems": 12,
				"items": map[string]any{"type": "string", "minLength": 1, "maxLength": 64},
			},
			"files": map[string]any{
				"type": "array", "minItems": 1, "maxItems": 6,
				"items": map[string]any{
					"type": "object",
					"properties": map[string]any{
						"name":    map[string]any{"type": "string"},
						"content": map[string]any{"type": "string"},
					},
					"required":             []string{"name", "content"},
					"additionalProperties": false,
				},
			},
		},
		"required":             []string{"version", "driver", "capability", "summary", "test_command", "smoke_command", "scenarios", "files"},
		"additionalProperties": false,
	}
}

func parseAISILCodeBundleJSON(textOut string) (aiSILCodeBundle, error) {
	t := strings.TrimSpace(textOut)
	if strings.HasPrefix(t, "```") {
		lines := strings.Split(t, "\n")
		if len(lines) >= 2 {
			lines = lines[1:]
			if len(lines) > 0 && strings.TrimSpace(lines[len(lines)-1]) == "```" {
				lines = lines[:len(lines)-1]
			}
			t = strings.TrimSpace(strings.Join(lines, "\n"))
		}
	}
	var bundle aiSILCodeBundle
	if err := json.Unmarshal([]byte(t), &bundle); err != nil {
		first, last := strings.Index(t, "{"), strings.LastIndex(t, "}")
		if first >= 0 && last > first {
			if err2 := json.Unmarshal([]byte(t[first:last+1]), &bundle); err2 == nil {
				return bundle, nil
			}
		}
		return aiSILCodeBundle{}, fmt.Errorf("model output was not valid SIL code bundle JSON: %w", err)
	}
	return bundle, nil
}

func requestGPTCodeBundle(p aiProviderConfig, model, key, systemPrompt, userPrompt string) (aiSILCodeBundle, error) {
	body := map[string]any{
		"model": model,
		"input": []map[string]any{{"role": "system", "content": systemPrompt}, {"role": "user", "content": userPrompt}},
		"text":  map[string]any{"format": map[string]any{"type": "json_schema", "name": "ai_sil_code_bundle", "strict": true, "schema": aiSILCodeSchema()}},
	}
	raw, status, err := httpPostJSON(p.Endpoint, key, body)
	if err != nil {
		return aiSILCodeBundle{}, fmt.Errorf("%s network error: %w", p.Label, err)
	}
	if status < 200 || status >= 300 {
		return aiSILCodeBundle{}, apiHTTPError(p.Label, status, raw)
	}
	var out struct {
		Status string `json:"status"`
		Error  *struct {
			Message string `json:"message"`
		} `json:"error"`
		Output []struct {
			Content []struct {
				Type    string `json:"type"`
				Text    string `json:"text"`
				Refusal string `json:"refusal"`
			} `json:"content"`
		} `json:"output"`
	}
	if err := json.Unmarshal(raw, &out); err != nil {
		return aiSILCodeBundle{}, fmt.Errorf("%s returned invalid response JSON: %w", p.Label, err)
	}
	if out.Error != nil && out.Error.Message != "" {
		return aiSILCodeBundle{}, fmt.Errorf("%s API: %s", p.Label, out.Error.Message)
	}
	var textOut string
	for _, item := range out.Output {
		for _, c := range item.Content {
			if c.Type == "output_text" {
				textOut += c.Text
			}
			if c.Type == "refusal" && c.Refusal != "" {
				return aiSILCodeBundle{}, fmt.Errorf("%s model refusal: %s", p.Label, c.Refusal)
			}
		}
	}
	if strings.TrimSpace(textOut) == "" {
		return aiSILCodeBundle{}, fmt.Errorf("%s returned no output_text (status=%s)", p.Label, out.Status)
	}
	return parseAISILCodeBundleJSON(textOut)
}

func requestChatCodeBundle(p aiProviderConfig, model, key, systemPrompt, userPrompt string) (aiSILCodeBundle, error) {
	body := map[string]any{
		"model":      model,
		"messages":   []map[string]any{{"role": "system", "content": systemPrompt}, {"role": "user", "content": userPrompt}},
		"stream":     false,
		"max_tokens": 12000,
	}
	if p.ID == "deepseek" {
		body["response_format"] = map[string]any{"type": "json_object"}
		body["thinking"] = map[string]any{"type": "disabled"}
	} else if p.ID == "glm" {
		body["temperature"] = 0.1
	}
	raw, status, err := httpPostJSON(p.Endpoint, key, body)
	if err != nil {
		return aiSILCodeBundle{}, fmt.Errorf("%s network error: %w", p.Label, err)
	}
	if status < 200 || status >= 300 {
		return aiSILCodeBundle{}, apiHTTPError(p.Label, status, raw)
	}
	var out struct {
		Choices []struct {
			Message struct {
				Content any `json:"content"`
			} `json:"message"`
		} `json:"choices"`
		Error *struct {
			Message string `json:"message"`
		} `json:"error"`
	}
	if err := json.Unmarshal(raw, &out); err != nil {
		return aiSILCodeBundle{}, fmt.Errorf("%s returned invalid response JSON: %w", p.Label, err)
	}
	if out.Error != nil && out.Error.Message != "" {
		return aiSILCodeBundle{}, fmt.Errorf("%s API: %s", p.Label, out.Error.Message)
	}
	if len(out.Choices) == 0 {
		return aiSILCodeBundle{}, fmt.Errorf("%s returned no choices", p.Label)
	}
	var textOut string
	switch v := out.Choices[0].Message.Content.(type) {
	case string:
		textOut = v
	case nil:
		textOut = ""
	default:
		b, _ := json.Marshal(v)
		textOut = string(b)
	}
	if strings.TrimSpace(textOut) == "" {
		return aiSILCodeBundle{}, fmt.Errorf("%s returned empty code bundle content", p.Label)
	}
	return parseAISILCodeBundleJSON(textOut)
}

func requestAISILCodeBundle(systemPrompt, userPrompt, role string) (aiSILCodeBundle, string, string, error) {
	p := selectedAIProvider()
	p.Endpoint = currentAIEndpoint(p)
	key := providerAPIKey(p)
	if key == "" {
		return aiSILCodeBundle{}, p.Label, "", fmt.Errorf("%s API key is empty. Configure it under 设置 → AI 服务 or set %s", p.Label, strings.Join(p.EnvKeys, " / "))
	}
	model := currentRoleModel(role, p)
	var bundle aiSILCodeBundle
	var err error
	switch p.APIStyle {
	case "responses_schema":
		bundle, err = requestGPTCodeBundle(p, model, key, systemPrompt, userPrompt)
	case "chat_json", "chat_prompt_json":
		bundle, err = requestChatCodeBundle(p, model, key, systemPrompt, userPrompt)
	default:
		err = fmt.Errorf("unsupported AI provider adapter: %s", p.ID)
	}
	return bundle, p.Label, model, err
}

func readFileForAI(path string, maxBytes int) string {
	b, err := os.ReadFile(path)
	if err != nil {
		return "<missing: " + path + ">"
	}
	if maxBytes > 0 && len(b) > maxBytes {
		b = append(append([]byte{}, b[:maxBytes]...), []byte("\n/* ... truncated by Workbench ... */\n")...)
	}
	return string(b)
}

func findDriverSourceForAI(ctx projectContext, driver string) string {
	driver = strings.ToLower(strings.TrimSpace(driver))
	candidates := map[string][]string{
		"gpio": {"drv_gpio.c"},
		"adc":  {"drv_adc.c"},
		"spi":  {"drv_spi.c", "drv_spi_flash.c"},
		"uart": {"drv_usart.c", "drv_uart.c"},
		"can":  {"drv_can.c"},
		"i2c":  {"drv_i2c.c", "drv_soft_i2c.c"},
		"pwm":  {"drv_pwm.c"},
	}
	for _, name := range candidates[driver] {
		p := filepath.Join(ctx.Root, "drivers", name)
		if fileExists(p) {
			return p
		}
	}
	if driver != "" {
		if p := findNamedFile(filepath.Join(ctx.Root, "drivers"), map[string]bool{"drv_" + driver + ".c": true}, 3); p != "" {
			return p
		}
	}
	return ""
}

func aiSILDriverContext(ctx projectContext, plan aiTestPlan, requirement string) string {
	var b strings.Builder
	fmt.Fprintf(&b, "Project: %s\nMCU: %s\nRT-Thread: %s\nRequested driver: %s\nRequested capability: %s\nTarget: %s\nRequirement: %s\n\n", ctx.ProjectName, ctx.MCU, ctx.RTThread, plan.RequestedDriver, plan.RequestedCapability, plan.Target, requirement)
	driverPath := findDriverSourceForAI(ctx, plan.RequestedDriver)
	if driverPath != "" {
		fmt.Fprintf(&b, "=== DRIVER SOURCE: %s ===\n%s\n\n", driverPath, readFileForAI(driverPath, 36000))
	} else {
		b.WriteString("=== DRIVER SOURCE ===\n<no matching driver source found by Workbench>\n\n")
	}
	for _, rel := range []string{"rtconfig.h", filepath.Join("board", "board.h"), filepath.Join("board", "Kconfig")} {
		path := filepath.Join(ctx.Root, rel)
		if fileExists(path) {
			fmt.Fprintf(&b, "=== %s ===\n%s\n\n", rel, readFileForAI(path, 12000))
		}
	}
	return b.String()
}

func aiSILGenerationPrompts(ctx projectContext, plan aiTestPlan, requirement string) (string, string) {
	systemPrompt := `You are an AI SIL engineer generating a constrained RT-Thread test harness. Return JSON only and exactly match the requested schema.

The response MUST be exactly one JSON object containing ALL of these top-level keys, even when a value is simple:
version, driver, capability, summary, test_command, smoke_command, scenarios, files.
Never omit driver or capability. They are authoritative host metadata and must exactly match the values in the user prompt.
Required shape:
{"version":"1.0","driver":"<requested driver>","capability":"<requested capability>","summary":"...","test_command":"ai_sil_xxx","smoke_command":"ai_sil_xxx <target> smoke","scenarios":["normal"],"files":[{"name":"ai_sil_ai_xxx.c","content":"..."}]}

Your job is to generate NEW isolated C/H files only. You must NOT edit main.c, drv_*.c, rtconfig.h, Kconfig, linker scripts, startup code, kernel sources, or any existing user source. The Workbench will reject arbitrary paths and will materialize only validated ai_sil_ai_*.c/.h files under applications/.

Requirements for generated code:
- Target RT-Thread 4.0.x and the project context supplied by the host.
- Use only public RT-Thread APIs and symbols that are visible in the supplied source/context. Do not invent HAL/BSP functions.
- Register exactly one generated MSH test command named with prefix ai_sil_. test_command must be the command name only, no arguments.
- The C command handler function itself MUST be named exactly the top-level test_command, and it MUST be exported exactly as MSH_CMD_EXPORT(<test_command>, ...). Do not register a different command name, alias, wrapper name, *_test name, or rely on comments/strings merely containing test_command.
- Syntax of the test command must be: <test_command> <target> <scenario>.
- smoke_command MUST begin with exactly the same test_command token.
- scenarios must list every scenario accepted by the command. Prefer a normal baseline plus scenarios explicitly requested by the user. Use concise lowercase tokens such as normal, timeout, overrange, stuck_low.
- Every test invocation must print exactly one machine-readable result line: @SIL,GEN_RESULT,<capability>,<target>,<scenario>,PASS|FAIL,<detail>. The <capability> field MUST equal the top-level capability exactly; it is NOT test_command and MUST NOT have an added ai_sil_ prefix unless the authoritative capability itself has one.
- GEN_RESULT PASS/FAIL is the functional observation for that scenario, not the overall regression verdict. A normal scenario should normally report PASS when the driver operation succeeds; a deliberately injected/negative scenario may report FAIL when the intended failure condition is actually observed. The host TestPlan defines what result is expected.
- Provide smoke_command as a full MSH command line used ONLY as an infrastructure/readiness probe. Its first token MUST equal test_command exactly. It must verify that the generated MSH command is registered, arguments can be parsed, and the harness can emit the protocol without crashing. It must print exactly one: @SIL,AI_SMOKE,<capability>,PASS,<detail>. The <capability> field MUST equal the top-level capability exactly, NOT test_command.
- The smoke/readiness probe MUST NOT judge driver correctness, GPIO readback, ADC values, IRQ behavior, or any other DUT functional expectation. Those checks belong only to normal test scenarios and @SIL,GEN_RESULT.
- If the underlying project lacks required BSP configuration/device registration/hardware support, do NOT fake functional success. The readiness probe may still report PASS when the command/protocol is alive; the real test scenario must report @SIL,GEN_RESULT,...,FAIL,BLOCKED_* (or another evidence-backed FAIL detail).
- Keep generated code deterministic. The Workbench rule engine owns the final plan verdict; the model does not get to reinterpret runtime evidence.
- No dynamic code loading, filesystem mutation, shell/system calls, network access, or arbitrary memory patching from generated firmware code.
- Keep the bundle small: normally one .c and optionally one .h file.

The Workbench will Build this code. If compilation fails, you may receive a later repair request with the exact compiler transcript.`
	expectedDriver := strings.ToLower(strings.TrimSpace(plan.RequestedDriver))
	expectedCapability := normalizeRequestedCapability(expectedDriver, plan.RequestedCapability)
	userPrompt := aiSILDriverContext(ctx, plan, requirement) + fmt.Sprintf("\nGenerate a candidate harness. AUTHORITATIVE metadata: driver=%s capability=%s. You MUST return these exact values in the top-level driver and capability fields. File names must start with ai_sil_ai_*.c/.h. Return every required top-level key: version, driver, capability, summary, test_command, smoke_command, scenarios, files.", expectedDriver, expectedCapability)
	return systemPrompt, userPrompt
}

func aiSILBundleRepairPrompts(ctx projectContext, plan aiTestPlan, requirement string, bundle aiSILCodeBundle, validationErr error) (string, string) {
	bundleJSON, _ := json.MarshalIndent(bundle, "", "  ")
	expectedDriver := strings.ToLower(strings.TrimSpace(plan.RequestedDriver))
	expectedCapability := normalizeRequestedCapability(expectedDriver, plan.RequestedCapability)
	systemPrompt := `You are repairing the STRUCTURE and validation compliance of an AI-generated RT-Thread SIL code bundle BEFORE any files are written or built. Return the COMPLETE corrected JSON object only, with no prose and no markdown.

The output MUST contain ALL top-level keys exactly as follows:
version, driver, capability, summary, test_command, smoke_command, scenarios, files.
The host-provided driver and capability are authoritative. Do not change them. Keep generated files isolated as ai_sil_ai_*.c/.h. Preserve useful source content unless a change is required by the validator. Do not modify or propose modifications to original project sources or configuration.

Required shape:
{"version":"1.0","driver":"<requested driver>","capability":"<requested capability>","summary":"...","test_command":"ai_sil_xxx","smoke_command":"ai_sil_xxx <target> smoke","scenarios":["normal"],"files":[{"name":"ai_sil_ai_xxx.c","content":"..."}]}

STRICT COMMAND/PROTOCOL CONTRACT:
- The generated handler function MUST be named exactly test_command and exported exactly with MSH_CMD_EXPORT(test_command, ...).
- smoke_command first token MUST equal test_command.
- @SIL,AI_SMOKE capability field MUST equal top-level capability exactly.
- @SIL,GEN_RESULT capability field MUST equal top-level capability exactly.
Do not satisfy these rules with comments or unrelated marker strings; the real executable code and protocol literals must match.`
	userPrompt := aiSILDriverContext(ctx, plan, requirement) + fmt.Sprintf("\n=== AUTHORITATIVE HOST METADATA ===\ndriver=%s\ncapability=%s\n\n=== VALIDATOR ERROR ===\n%s\n\n=== CURRENT BUNDLE ===\n%s\n\nReturn the complete corrected JSON bundle. The top-level driver MUST be %q and capability MUST be %q.", expectedDriver, expectedCapability, validationErr.Error(), string(bundleJSON), expectedDriver, expectedCapability)
	return systemPrompt, userPrompt
}

func aiSILRepairPrompts(ctx projectContext, plan aiTestPlan, requirement string, bundle aiSILCodeBundle, transcript string) (string, string) {
	if len(transcript) > 24000 {
		transcript = transcript[len(transcript)-24000:]
	}
	bundleJSON, _ := json.MarshalIndent(bundle, "", "  ")
	systemPrompt := `You are repairing an AI-generated RT-Thread SIL test harness after a real compiler/build failure. Return the COMPLETE corrected JSON code bundle, not a patch and not prose.

Preserve the same driver and capability and ALWAYS include all required top-level keys: version, driver, capability, summary, test_command, smoke_command, scenarios, files. Keep all files isolated as ai_sil_ai_*.c/.h. Do not modify original project sources or configuration. Fix only what is supported by the supplied project context and build transcript. Do not silence real missing BSP/device support by fabricating runtime success. The result protocol and smoke protocol must remain exactly as specified: @SIL,GEN_RESULT,... and @SIL,AI_SMOKE,... . The AI_SMOKE path is infrastructure-only and must not encode the functional verdict of the driver-under-test.

STRICT COMMAND/PROTOCOL CONTRACT: the generated C handler function must be named exactly test_command and exported exactly as MSH_CMD_EXPORT(test_command, ...); smoke_command must begin with test_command; AI_SMOKE and GEN_RESULT must use the top-level capability exactly as their capability field, never test_command or an ai_sil_-prefixed substitute.`
	userPrompt := aiSILDriverContext(ctx, plan, requirement) + "\n=== CURRENT GENERATED BUNDLE ===\n" + string(bundleJSON) + "\n\n=== REAL BUILD TRANSCRIPT ===\n" + transcript + "\n\nReturn the complete corrected bundle."
	return systemPrompt, userPrompt
}

func aiSILProbeRepairPrompts(ctx projectContext, plan aiTestPlan, requirement string, bundle aiSILCodeBundle, probeErr, uartEvidence string) (string, string) {
	if len(uartEvidence) > 16000 {
		uartEvidence = uartEvidence[len(uartEvidence)-16000:]
	}
	bundleJSON, _ := json.MarshalIndent(bundle, "", "  ")
	systemPrompt := `You are repairing ONLY the command-registration / readiness-protocol contract of an AI-generated RT-Thread SIL harness after Build PASS but the host capability probe failed. Return the COMPLETE corrected JSON code bundle only, no prose and no markdown.

Do NOT modify the user's functional test intent, functional acceptance criteria, scenario meaning, or original project/driver/BSP/configuration files. Do NOT weaken the test to make it pass. This repair phase is infrastructure-only.

The output MUST include all top-level keys: version, driver, capability, summary, test_command, smoke_command, scenarios, files.
STRICT CONTRACT:
1. test_command is one ai_sil_* token with no arguments.
2. The generated C handler function itself is named exactly test_command and is registered exactly with MSH_CMD_EXPORT(test_command, ...). Do not register a *_test command or a different alias.
3. smoke_command first token equals test_command exactly and normally uses <target> smoke.
4. The smoke path performs no DUT functional checks. It only proves command registration, argument parsing, process liveness and protocol output.
5. Smoke prints exactly one literal protocol frame with capability identity: @SIL,AI_SMOKE,<capability>,PASS,<detail>. The capability field is the top-level capability, NOT test_command.
6. Functional scenarios print @SIL,GEN_RESULT,<capability>,<target>,<scenario>,PASS|FAIL,<detail>, again using top-level capability exactly.
7. Keep files isolated as ai_sil_ai_*.c/.h and preserve working functional logic unless a command/protocol correction requires a small local edit.`
	userPrompt := aiSILDriverContext(ctx, plan, requirement) + "\n=== CURRENT GENERATED BUNDLE ===\n" + string(bundleJSON) + "\n\n=== CAPABILITY PROBE ERROR ===\n" + probeErr + "\n\n=== UART EVIDENCE AROUND PROBE ===\n" + uartEvidence + "\n\nRepair only the generated harness command/protocol contract and return the complete corrected JSON bundle."
	return systemPrompt, userPrompt
}

func isAISILProbeRepairable(err error) bool {
	if err == nil {
		return false
	}
	s := strings.ToLower(err.Error())
	// After Build PASS, these failures are local to the generated command/protocol
	// contract often enough to repair safely without touching the DUT. QEMU start,
	// RT-Thread boot, transport/echo, and host-side environment failures are not
	// sent to code repair because changing the harness would be speculative.
	return strings.Contains(s, "capability probe protocol: ai_smoke_") ||
		strings.Contains(s, "invalid ai_smoke status")
}

func aiPlannerPrompts(requirement string) (string, string) {
	ctxJSON, _ := json.Marshal(aiProjectContext())
	systemPrompt := `You are the capability router and constrained test planner for an RT-Thread software-in-the-loop test agent. Return JSON only.

First decide whether the user's request can be executed by a capability explicitly listed with status=ready in installed_capabilities.
- route=run_existing ONLY when the entire request is covered by one installed ready capability. Do not infer readiness from a driver source file.
- route=capability_missing when the needed capability is not listed ready. The host may later invoke AI SIL Engineer to generate an isolated test harness. For this route, cases MUST be empty.
- route=needs_clarification when target or behavior is too ambiguous for safe execution. For this route, cases MUST be empty.

For built-in GPIO capabilities: target must be PA.0..PK.15; scenarios are none/stuck_low/stuck_high. For GPIO, fault=none expects PASS and stuck_low/stuck_high expect FAIL because the test verifies fault detection.

For an AI-generated ready capability: use exactly its driver, capability and advertised scenarios. Put the selected scenario name in each case.fault field. The target must be a concrete single token suitable for the capability (for example ADC1_CH0, SPI1, USART2). Do not invent scenarios not advertised by installed_capabilities. expected describes the functional result expected from that scenario and must be PASS or FAIL.

If the user asks for typical/common scenarios, include a normal baseline plus only the relevant scenarios explicitly advertised by the selected capability. If the user asks for normal-only or one specific scenario, follow that request.

requested_capability should be a concise machine-friendly capability label. reason must be concise and in the user's language. Do not invent commands, APIs, hardware behavior, or capabilities.`
	userPrompt := fmt.Sprintf("Project capability context:\n%s\n\nUser requirement:\n%s\n\nReturn exactly this JSON shape:\n{\"version\":\"1.0\",\"route\":\"run_existing|capability_missing|needs_clarification\",\"requested_driver\":\"gpio|spi|adc|...\",\"requested_capability\":\"short_label\",\"reason\":\"why this route was selected\",\"driver\":\"gpio|spi|adc|...\",\"target\":\"PB.0|SPI1|...\",\"cases\":[{\"id\":\"GPIO_NORMAL\",\"fault\":\"none\",\"expected\":\"PASS\",\"description\":\"normal GPIO output/readback\"}]}", string(ctxJSON), requirement)
	return systemPrompt, userPrompt
}

func httpPostJSON(endpoint, key string, body any) ([]byte, int, error) {
	payload, err := json.Marshal(body)
	if err != nil {
		return nil, 0, err
	}
	req, err := http.NewRequest("POST", endpoint, bytes.NewReader(payload))
	if err != nil {
		return nil, 0, err
	}
	req.Header.Set("Authorization", "Bearer "+key)
	req.Header.Set("Content-Type", "application/json")
	client := &http.Client{Timeout: 45 * time.Second}
	resp, err := client.Do(req)
	if err != nil {
		return nil, 0, err
	}
	defer resp.Body.Close()
	raw, err := io.ReadAll(io.LimitReader(resp.Body, 2*1024*1024))
	return raw, resp.StatusCode, err
}

func apiHTTPError(provider string, status int, raw []byte) error {
	var apiErr struct {
		Error struct {
			Message string `json:"message"`
			Type    string `json:"type"`
			Code    any    `json:"code"`
		} `json:"error"`
		Message string `json:"message"`
		Msg     string `json:"msg"`
	}
	_ = json.Unmarshal(raw, &apiErr)
	msg := strings.TrimSpace(apiErr.Error.Message)
	if msg == "" {
		msg = strings.TrimSpace(apiErr.Message)
	}
	if msg == "" {
		msg = strings.TrimSpace(apiErr.Msg)
	}
	if msg == "" {
		msg = strings.TrimSpace(string(raw))
	}
	if len(msg) > 800 {
		msg = msg[:800] + "..."
	}
	return fmt.Errorf("%s API HTTP %d: %s", provider, status, msg)
}

func parsePlanJSON(textOut string) (aiTestPlan, error) {
	t := strings.TrimSpace(textOut)
	if strings.HasPrefix(t, "```") {
		lines := strings.Split(t, "\n")
		if len(lines) >= 2 {
			lines = lines[1:]
			if len(lines) > 0 && strings.TrimSpace(lines[len(lines)-1]) == "```" {
				lines = lines[:len(lines)-1]
			}
			t = strings.TrimSpace(strings.Join(lines, "\n"))
		}
	}
	var plan aiTestPlan
	if err := json.Unmarshal([]byte(t), &plan); err != nil {
		first, last := strings.Index(t, "{"), strings.LastIndex(t, "}")
		if first >= 0 && last > first {
			if err2 := json.Unmarshal([]byte(t[first:last+1]), &plan); err2 == nil {
				if err := validateAIPlan(&plan); err != nil {
					return aiTestPlan{}, fmt.Errorf("AI plan rejected by Workbench validator: %w", err)
				}
				return plan, nil
			}
		}
		return aiTestPlan{}, fmt.Errorf("model output was not valid TestPlan JSON: %w", err)
	}
	if err := validateAIPlan(&plan); err != nil {
		return aiTestPlan{}, fmt.Errorf("AI plan rejected by Workbench validator: %w", err)
	}
	return plan, nil
}

func requestGPTPlan(p aiProviderConfig, model, key, systemPrompt, userPrompt string) (aiTestPlan, error) {
	body := map[string]any{
		"model": model,
		"input": []map[string]any{{"role": "system", "content": systemPrompt}, {"role": "user", "content": userPrompt}},
		"text":  map[string]any{"format": map[string]any{"type": "json_schema", "name": "sil_capability_route_plan", "strict": true, "schema": aiPlanSchema()}},
	}
	raw, status, err := httpPostJSON(p.Endpoint, key, body)
	if err != nil {
		return aiTestPlan{}, fmt.Errorf("%s network error: %w", p.Label, err)
	}
	if status < 200 || status >= 300 {
		return aiTestPlan{}, apiHTTPError(p.Label, status, raw)
	}
	var out struct {
		Status string `json:"status"`
		Error  *struct {
			Message string `json:"message"`
		} `json:"error"`
		Output []struct {
			Content []struct {
				Type    string `json:"type"`
				Text    string `json:"text"`
				Refusal string `json:"refusal"`
			} `json:"content"`
		} `json:"output"`
	}
	if err := json.Unmarshal(raw, &out); err != nil {
		return aiTestPlan{}, fmt.Errorf("%s returned invalid response JSON: %w", p.Label, err)
	}
	if out.Error != nil && out.Error.Message != "" {
		return aiTestPlan{}, fmt.Errorf("%s API: %s", p.Label, out.Error.Message)
	}
	textOut := ""
	for _, item := range out.Output {
		for _, c := range item.Content {
			if c.Type == "output_text" {
				textOut += c.Text
			}
			if c.Type == "refusal" && c.Refusal != "" {
				return aiTestPlan{}, fmt.Errorf("%s model refusal: %s", p.Label, c.Refusal)
			}
		}
	}
	if strings.TrimSpace(textOut) == "" {
		return aiTestPlan{}, fmt.Errorf("%s returned no output_text (status=%s)", p.Label, out.Status)
	}
	return parsePlanJSON(textOut)
}

func requestChatPlan(p aiProviderConfig, model, key, systemPrompt, userPrompt string) (aiTestPlan, error) {
	body := map[string]any{
		"model":      model,
		"messages":   []map[string]any{{"role": "system", "content": systemPrompt}, {"role": "user", "content": userPrompt}},
		"stream":     false,
		"max_tokens": 2048,
	}
	if p.ID == "deepseek" {
		body["response_format"] = map[string]any{"type": "json_object"}
		body["thinking"] = map[string]any{"type": "disabled"}
	} else if p.ID == "glm" {
		// Keep GLM request on the broad OpenAI-compatible surface. The host validator remains authoritative.
		body["temperature"] = 0.1
	}
	raw, status, err := httpPostJSON(p.Endpoint, key, body)
	if err != nil {
		return aiTestPlan{}, fmt.Errorf("%s network error: %w", p.Label, err)
	}
	if status < 200 || status >= 300 {
		return aiTestPlan{}, apiHTTPError(p.Label, status, raw)
	}
	var out struct {
		Choices []struct {
			Message struct {
				Content any `json:"content"`
			} `json:"message"`
			FinishReason string `json:"finish_reason"`
		} `json:"choices"`
		Error *struct {
			Message string `json:"message"`
		} `json:"error"`
	}
	if err := json.Unmarshal(raw, &out); err != nil {
		return aiTestPlan{}, fmt.Errorf("%s returned invalid response JSON: %w", p.Label, err)
	}
	if out.Error != nil && out.Error.Message != "" {
		return aiTestPlan{}, fmt.Errorf("%s API: %s", p.Label, out.Error.Message)
	}
	if len(out.Choices) == 0 {
		return aiTestPlan{}, fmt.Errorf("%s returned no choices", p.Label)
	}
	var textOut string
	switch v := out.Choices[0].Message.Content.(type) {
	case string:
		textOut = v
	case nil:
		textOut = ""
	default:
		b, _ := json.Marshal(v)
		textOut = string(b)
	}
	if strings.TrimSpace(textOut) == "" {
		return aiTestPlan{}, fmt.Errorf("%s returned empty message content", p.Label)
	}
	return parsePlanJSON(textOut)
}

func requestAITestPlan(requirement string) (aiTestPlan, string, string, error) {
	p := selectedAIProvider()
	p.Endpoint = currentAIEndpoint(p)
	key := providerAPIKey(p)
	if key == "" {
		return aiTestPlan{}, p.Label, "", fmt.Errorf("%s API key is empty. Configure it under 设置 → AI 服务 or set %s", p.Label, strings.Join(p.EnvKeys, " / "))
	}
	model := currentRoleModel("planner", p)
	systemPrompt, userPrompt := aiPlannerPrompts(requirement)
	var plan aiTestPlan
	var err error
	switch p.APIStyle {
	case "responses_schema":
		plan, err = requestGPTPlan(p, model, key, systemPrompt, userPrompt)
	case "chat_json", "chat_prompt_json":
		plan, err = requestChatPlan(p, model, key, systemPrompt, userPrompt)
	default:
		err = fmt.Errorf("unsupported AI provider adapter: %s", p.ID)
	}
	return plan, p.Label, model, err
}

func generateAIPlanForRequirement(requirement string) (aiTestPlan, string, string, error) {
	reqText := strings.TrimSpace(requirement)
	if reqText == "" {
		return aiTestPlan{}, "", "", fmt.Errorf("requirement is empty")
	}
	currentProjectMu.Lock()
	ctx := currentProject
	currentProjectMu.Unlock()
	if strings.TrimSpace(ctx.Root) == "" {
		return aiTestPlan{}, "", "", fmt.Errorf("analyze the RT-Thread project first")
	}
	return requestAITestPlan(reqText)
}

func generateAIPlanInternal() (aiTestPlan, string, string, error) {
	return generateAIPlanForRequirement(strings.TrimSpace(getText(edtPrompt)))
}

func planCaseLine(c aiPlanCase) string {
	tag := "Normal"
	if c.Fault != "none" {
		tag = "Fault Injection"
	}
	return fmt.Sprintf("%-20s  %-15s  Expect %-4s   %s", c.ID, tag, c.Expected, c.Description)
}

func refreshPlanViews(plan aiTestPlan) {
	postUI(func() {
		if edtTestcase != 0 {
			setText(edtTestcase, renderAIPlan(plan))
		}
		if lstPlan == 0 {
			return
		}
		procSendMessageW.Call(lstPlan, LB_RESETCONTENT, 0, 0)
		if btnAISILEngineer != 0 {
			if plan.Route == "capability_missing" && !(plan.RequestedDriver == "gpio" && normalizeRequestedCapability(plan.RequestedDriver, plan.RequestedCapability) == "gpio_input_readback") {
				procShowWindow.Call(btnAISILEngineer, SW_SHOW)
				setButtonKind(btnAISILEngineer, "tab-active")
			} else {
				procShowWindow.Call(btnAISILEngineer, SW_HIDE)
			}
		}
		if plan.Route != "run_existing" {
			line := fmt.Sprintf("%s  ·  %s", capabilityRouteLabel(plan.Route), plan.Reason)
			procSendMessageW.Call(lstPlan, LB_ADDSTRING, 0, uintptr(unsafe.Pointer(utf16(line))))
			return
		}
		for _, c := range plan.Cases {
			line := planCaseLine(c)
			procSendMessageW.Call(lstPlan, LB_ADDSTRING, 0, uintptr(unsafe.Pointer(utf16(line))))
		}
		if len(plan.Cases) == 0 {
			procSendMessageW.Call(lstPlan, LB_ADDSTRING, 0, uintptr(unsafe.Pointer(utf16("等待 AI TestPlan..."))))
		}
	})
}

func showPlanStructured() {
	if lstPlan != 0 {
		procShowWindow.Call(lstPlan, SW_SHOW)
	}
	if edtTestcase != 0 {
		procShowWindow.Call(edtTestcase, SW_HIDE)
	}
	setButtonKind(btnPlanStructured, "tab-active")
	setButtonKind(btnPlanJSON, "ghost")
}

func showPlanJSON() {
	if lstPlan != 0 {
		procShowWindow.Call(lstPlan, SW_HIDE)
	}
	if edtTestcase != 0 {
		procShowWindow.Call(edtTestcase, SW_SHOW)
	}
	setButtonKind(btnPlanStructured, "ghost")
	setButtonKind(btnPlanJSON, "tab-active")
}

func refreshTestActionUI() {
	if btnAIGeneratePlan == 0 || btnAIRun == 0 {
		return
	}
	currentPlanMu.Lock()
	plan := currentPlan
	planRequirement := strings.TrimSpace(currentPlanRequirement)
	currentPlanMu.Unlock()
	currentRequirement := strings.TrimSpace(getText(edtPrompt))

	if strings.TrimSpace(plan.Route) == "" {
		setText(btnAIGeneratePlan, "✦  仅生成测试计划")
		setText(btnAIRun, "▶  AI规划并运行")
		if lblTestActionHint != 0 {
			setText(lblTestActionHint, "暂无 TestPlan · 可先预览计划，也可直接规划并运行")
		}
		return
	}

	setText(btnAIGeneratePlan, "↻  重新生成计划")
	if currentRequirement == planRequirement {
		setText(btnAIRun, "▶  运行当前计划")
		if lblTestActionHint != 0 {
			setText(lblTestActionHint, fmt.Sprintf("当前计划有效 · %d 个用例 · 运行时不会重新调用 AI", len(plan.Cases)))
		}
		return
	}

	setText(btnAIRun, "▶  运行测试")
	if lblTestActionHint != 0 {
		setText(lblTestActionHint, "⚠ 测试需求已修改 · 当前 TestPlan 基于旧需求")
	}
}

func applyAIPlanToUIForRequirement(plan aiTestPlan, provider, model, requirement string) {
	currentPlanMu.Lock()
	currentPlan = plan
	currentPlanProvider = provider
	currentPlanModel = model
	currentPlanRequirement = strings.TrimSpace(requirement)
	currentPlanMu.Unlock()
	refreshPlanViews(plan)
	refreshTestActionUI()
	uiRunSummary(len(plan.Cases), "待执行", -1, 0)
	matrixStatus("AI TestPlan 已生成，等待执行。")
	uiPipelineCapabilityDecision(plan)

	switch plan.Route {
	case "run_existing":
		currentCaseMu.Lock()
		currentCase = testCase{Target: "gpio", Pin: plan.Target, Fault: "none"}
		currentCaseMu.Unlock()
		uiText(lblPlannerState, "Planner  ● Ready")
		uiText(lblRunState, fmt.Sprintf("State    Capability READY; TestPlan has %d case(s)", len(plan.Cases)))
		logLine("ROUTER", fmt.Sprintf("READY provider=%s model=%s capability=%s target=%s cases=%d", provider, model, plan.RequestedCapability, plan.Target, len(plan.Cases)))
	case "capability_missing":
		uiText(lblPlannerState, "Planner  ● Missing")
		uiText(lblRunState, fmt.Sprintf("State    Capability missing: %s / %s", plan.RequestedDriver, plan.RequestedCapability))
		if plan.RequestedDriver == "gpio" && plan.RequestedCapability == "gpio_input_readback" && !gpioInputCapabilityReady() {
			currentProjectMu.Lock()
			root := currentProject.Root
			currentProjectMu.Unlock()
			uiCapabilityBadge(root, "")
			uiResultState("EXTENDABLE", "GPIO Input 可安全自动扩展", renderCapabilityDecision(plan)+"\r\n\r\n下一步：点击运行测试，Workbench 将自动安装能力、Build、重新规划同一需求并继续执行。")
		} else {
			uiResultState("MISSING", "当前 SIL 能力不足", renderCapabilityDecision(plan))
		}
		logLine("ROUTER", fmt.Sprintf("MISSING provider=%s model=%s driver=%s capability=%s", provider, model, plan.RequestedDriver, plan.RequestedCapability))
	case "needs_clarification":
		uiText(lblPlannerState, "Planner  ● Clarify")
		uiText(lblRunState, "State    Requirement needs clarification")
		uiText(edtResult, renderCapabilityDecision(plan))
		logLine("ROUTER", fmt.Sprintf("CLARIFY provider=%s model=%s reason=%s", provider, model, plan.Reason))
	}
}

func applyAIPlanToUI(plan aiTestPlan, provider, model string) {
	applyAIPlanToUIForRequirement(plan, provider, model, strings.TrimSpace(getText(edtPrompt)))
}

func generateAIPlan() {
	requirement := strings.TrimSpace(getText(edtPrompt))
	setBusy(true)
	uiText(lblRunState, "State    Generating TestPlan only...")
	logLine("AI", "Requesting capability route + structured TestPlan preview (API key is never logged).")
	go func(req string) {
		defer setBusy(false)
		plan, provider, model, err := generateAIPlanForRequirement(req)
		if err != nil {
			uiText(lblRunState, "State    AI capability routing failed")
			uiMessage("AI planning failed", err.Error(), MB_OK|MB_ICONERROR)
			logLine("AI", "Capability routing/TestPlan failed: "+err.Error())
			return
		}
		applyAIPlanToUIForRequirement(plan, provider, model, req)
		matrixStatus("当前 TestPlan 已生成；点击运行测试将直接执行当前计划。")
	}(requirement)
}

func faultCommand(fault string) (string, bool) {
	switch fault {
	case "none":
		return "sil_gpio_fault_none", true
	case "stuck_low":
		return "sil_gpio_fault_stuck_low", true
	case "stuck_high":
		return "sil_gpio_fault_stuck_high", true
	default:
		return "", false
	}
}

func aiPlanSummary(plan aiTestPlan, rows []aiPlanRunRow, provider, model string) (string, bool) {
	var b strings.Builder
	if plan.RequestedCapability != "gpio_output_readback" && plan.RequestedCapability != "gpio_input_readback" {
		m, _ := generatedCapabilityReady(plan.RequestedCapability)
		b.WriteString("AI-GENERATED SIL TEST PLAN\r\n\r\n")
		if provider != "" {
			b.WriteString("Provider " + provider + "\r\n")
		}
		if model != "" {
			b.WriteString("Model    " + model + "\r\n")
		}
		b.WriteString("Driver   " + m.Driver + "\r\n")
		b.WriteString("Capability " + plan.RequestedCapability + "\r\n")
		b.WriteString("Target   " + plan.Target + "\r\n")
		b.WriteString("Backend  ai_generated_sil_harness\r\n")
		b.WriteString("Command  " + m.TestCommand + " <target> <scenario>\r\n\r\n")
		b.WriteString("Case                 Scenario      Observed  Expected  Detection\r\n")
		b.WriteString("-------------------  ------------  --------  --------  ---------\r\n")
		allOK := true
		for _, row := range rows {
			if row.ProtocolError != "" {
				allOK = false
				fmt.Fprintf(&b, "%-19s  %-12s  PROTOCOL  %-8s  MISMATCH\r\n", row.Case.ID, row.Case.Fault, row.Case.Expected)
				b.WriteString("  -> " + row.ProtocolError + "\r\n")
				continue
			}
			if row.Timeout {
				allOK = false
				fmt.Fprintf(&b, "%-19s  %-12s  TIMEOUT   %-8s  MISSING\r\n", row.Case.ID, row.Case.Fault, row.Case.Expected)
				continue
			}
			detection := "OK"
			if row.Result.Verdict != row.Case.Expected {
				detection = "MISMATCH"
				allOK = false
			}
			fmt.Fprintf(&b, "%-19s  %-12s  %-8s  %-8s  %s\r\n", row.Case.ID, row.Case.Fault, row.Result.Verdict, row.Case.Expected, detection)
		}
		b.WriteString("\r\n")
		if allOK && len(rows) == len(plan.Cases) {
			b.WriteString("PLAN VERDICT  PASS\r\n")
		} else {
			b.WriteString("PLAN VERDICT  FAIL\r\n")
		}
		fmt.Fprintf(&b, "%d/%d case result(s) processed.\r\n", len(rows), len(plan.Cases))
		b.WriteString("\r\nRule engine owns PASS/FAIL. Generated firmware code only reports deterministic runtime evidence.")
		return b.String(), allOK && len(rows) == len(plan.Cases)
	}
	b.WriteString("AI-GENERATED GPIO TEST PLAN\r\n\r\n")
	if provider != "" {
		b.WriteString("Provider " + provider + "\r\n")
	}
	if model != "" {
		b.WriteString("Model    " + model + "\r\n")
	}
	b.WriteString("Driver   drivers/drv_gpio.c\r\n")
	b.WriteString("Capability " + plan.RequestedCapability + "\r\n")
	b.WriteString("Target   " + plan.Target + "\r\n")
	backend := "virtual_gpio"
	if plan.RequestedCapability == "gpio_input_readback" {
		backend = "virtual_gpio_external_input"
	}
	b.WriteString("Backend  " + backend + "\r\n\r\n")
	if plan.RequestedCapability == "gpio_input_readback" {
		b.WriteString("Case                 Fault        ExtHI ExtLO Observed  Expected  Detection\r\n")
	} else {
		b.WriteString("Case                 Fault        HIGH  LOW   Observed  Expected  Detection\r\n")
	}
	b.WriteString("-------------------  -----------  ----  ----  --------  --------  ---------\r\n")
	allOK := true
	for _, row := range rows {
		if row.ProtocolError != "" {
			allOK = false
			fmt.Fprintf(&b, "%-19s  %-11s  --    --    PROTOCOL  %-8s  MISMATCH\r\n", row.Case.ID, row.Case.Fault, row.Case.Expected)
			b.WriteString("  -> " + row.ProtocolError + "\r\n")
			continue
		}
		if row.Timeout {
			allOK = false
			fmt.Fprintf(&b, "%-19s  %-11s  --    --    TIMEOUT   %-8s  MISSING\r\n", row.Case.ID, row.Case.Fault, row.Case.Expected)
			continue
		}
		detection := "OK"
		if row.Result.Verdict != row.Case.Expected {
			detection = "MISMATCH"
			allOK = false
		}
		fmt.Fprintf(&b, "%-19s  %-11s  %-4d  %-4d  %-8s  %-8s  %s\r\n", row.Case.ID, row.Case.Fault, row.Result.High, row.Result.Low, row.Result.Verdict, row.Case.Expected, detection)
	}
	b.WriteString("\r\n")
	if allOK && len(rows) == len(plan.Cases) {
		b.WriteString("PLAN VERDICT  PASS\r\n")
		fmt.Fprintf(&b, "%d/%d AI-planned expected behaviors observed.\r\n", len(rows), len(plan.Cases))
	} else {
		b.WriteString("PLAN VERDICT  FAIL\r\n")
		fmt.Fprintf(&b, "%d/%d case result(s) processed; at least one expected behavior was missing or mismatched.\r\n", len(rows), len(plan.Cases))
	}
	b.WriteString("\r\nRule engine owns PASS/FAIL. The model only planned the cases; it did not execute arbitrary shell commands.")
	return b.String(), allOK && len(rows) == len(plan.Cases)
}

func runAIPlanSync(plan aiTestPlan, provider, model, requirement string) error {
	startedAt := time.Now()
	if err := validateAIPlan(&plan); err != nil {
		return err
	}
	if plan.Route != "run_existing" {
		return fmt.Errorf("requirement is not executable with the installed SIL capability: %s", plan.Reason)
	}
	cfg := captureConfig()
	matrixRunning.Store(true)
	defer matrixRunning.Store(false)
	drainMatrixResults()
	uiText(lblRunState, "State    Starting AI-generated plan...")
	uiRunSummary(len(plan.Cases), "运行中", -1, 0)
	uiResultState("RUNNING", "正在准备 QEMU / RT-Thread", fmt.Sprintf("Target  %s\r\n\r\n正在启动/检查执行环境...", plan.Target))
	matrixStatus(fmt.Sprintf("Target %s · 正在准备 QEMU / RT-Thread...", plan.Target))
	if !session.running.Load() {
		if e := session.start(cfg); e != nil {
			return fmt.Errorf("start QEMU: %w", e)
		}
	}
	if !waitReady(10 * time.Second) {
		return fmt.Errorf("QEMU started but msh > was not detected within 10 seconds")
	}
	if plan.RequestedCapability == "gpio_output_readback" || plan.RequestedCapability == "gpio_input_readback" {
		if !session.silReady.Load() {
			_ = session.send("sil_ping")
			if !waitSILReady(2 * time.Second) {
				return fmt.Errorf("GPIO SIL runtime did not answer sil_ping")
			}
		}
	}
	rows := make([]aiPlanRunRow, 0, len(plan.Cases))
	for i, c := range plan.Cases {
		uiText(lblRunState, fmt.Sprintf("State    AI plan %d/%d: %s", i+1, len(plan.Cases), c.ID))
		progress := fmt.Sprintf("AI TEST PLAN\r\n\r\nTarget %s\r\nRunning %d/%d: %s\r\nFault: %s\r\nExpected: %s\r\n\r\n%s", plan.Target, i+1, len(plan.Cases), c.ID, c.Fault, c.Expected, c.Description)
		uiResultState("RUNNING", fmt.Sprintf("执行 %d/%d · %s", i+1, len(plan.Cases), c.ID), progress)
		matrixStatus(fmt.Sprintf("执行 %d/%d · %s · %s", i+1, len(plan.Cases), c.ID, c.Fault))
		var execResult silCaseExecResult
		if plan.RequestedCapability != "gpio_output_readback" && plan.RequestedCapability != "gpio_input_readback" {
			m, ready := generatedCapabilityReady(plan.RequestedCapability)
			if !ready {
				return fmt.Errorf("generated capability %s is not READY", plan.RequestedCapability)
			}
			execResult = executeGeneratedCase(m, plan.Target, c.Fault)
		} else {
			faultCmd, ok := faultCommand(c.Fault)
			if !ok {
				return fmt.Errorf("unsupported fault in validated plan: %s", c.Fault)
			}
			testCmd := fmt.Sprintf("ai_test_gpio %s", plan.Target)
			expectedKind := "GPIO"
			if plan.RequestedCapability == "gpio_input_readback" {
				testCmd = fmt.Sprintf("ai_test_gpio_input %s", plan.Target)
				expectedKind = "GPIO_INPUT"
			}
			execResult = executeSILCase(plan.Target, c.Fault, expectedKind, faultCmd, testCmd)
		}
		switch {
		case execResult.ProtocolError != "":
			rows = append(rows, aiPlanRunRow{Case: c, ProtocolError: execResult.ProtocolError})
			logLine("PROTO", fmt.Sprintf("%s protocol error: %s", c.ID, execResult.ProtocolError))
		case execResult.Timeout:
			rows = append(rows, aiPlanRunRow{Case: c, Timeout: true})
			logLine("PROTO", fmt.Sprintf("%s result timeout capability=%s target=%s scenario=%s", c.ID, plan.RequestedCapability, plan.Target, c.Fault))
		default:
			rows = append(rows, aiPlanRunRow{Case: c, Result: execResult.Result})
		}
	}
	summary, ok := aiPlanSummary(plan, rows, provider, model)
	verdict := "FAIL"
	if ok {
		verdict = "PASS"
	}
	currentProjectMu.Lock()
	ctx := currentProject
	currentProjectMu.Unlock()
	lastRunMu.Lock()
	lastRun = aiRunSnapshot{
		Requirement: strings.TrimSpace(requirement),
		Provider:    provider,
		Model:       model,
		Plan:        plan,
		Rows:        append([]aiPlanRunRow(nil), rows...),
		Verdict:     verdict,
		CompletedAt: time.Now().Format(time.RFC3339),
		Project:     ctx,
		Firmware:    strings.TrimSpace(getText(edtFirmware)),
	}
	lastDiagnosis = aiDiagnosis{}
	lastDiagnosisProvider = ""
	lastDiagnosisModel = ""
	lastRunMu.Unlock()
	issues := 0
	for _, row := range rows {
		if row.ProtocolError != "" || row.Timeout || row.Result.Verdict != row.Case.Expected {
			issues++
		}
	}
	matrixRows, selectIndex := aiRowsForMatrix(plan, rows)
	setMatrixViewRows(matrixRows, selectIndex)
	if ok {
		uiResultState("PASS", fmt.Sprintf("TestPlan 通过 · %d/%d 期望行为已观测", len(rows), len(plan.Cases)), summary)
	} else {
		uiResultState("FAIL", "TestPlan 存在缺失或不一致结果", summary)
	}
	uiRunSummary(len(plan.Cases), verdict, issues, time.Since(startedAt))
	if ok {
		uiText(lblRunState, "State    AI TestPlan PASS")
		logLine("AI", fmt.Sprintf("Plan PASS target=%s cases=%d", plan.Target, len(plan.Cases)))
	} else {
		uiText(lblRunState, "State    AI TestPlan FAIL")
		logLine("AI", fmt.Sprintf("Plan FAIL target=%s cases=%d", plan.Target, len(plan.Cases)))
	}
	return nil
}

func fillAISILBundleHostMetadata(bundle *aiSILCodeBundle, plan aiTestPlan) []string {
	var filled []string
	expectedDriver := strings.ToLower(strings.TrimSpace(plan.RequestedDriver))
	expectedCapability := normalizeRequestedCapability(expectedDriver, plan.RequestedCapability)
	if strings.TrimSpace(bundle.Version) == "" {
		bundle.Version = "1.0"
		filled = append(filled, "version=1.0")
	}
	// driver/capability were already decided by the validated TestPlan. If the
	// model merely omitted them, the host can safely restore those known fields.
	// Explicit conflicting values are not overwritten and will be rejected.
	if strings.TrimSpace(bundle.Driver) == "" && expectedDriver != "" {
		bundle.Driver = expectedDriver
		filled = append(filled, "driver="+expectedDriver)
	}
	if strings.TrimSpace(bundle.Capability) == "" && expectedCapability != "" {
		bundle.Capability = expectedCapability
		filled = append(filled, "capability="+expectedCapability)
	}
	return filled
}

func validateAISILCodeBundleWithHostMetadata(bundle *aiSILCodeBundle, plan aiTestPlan) ([]string, error) {
	filled := fillAISILBundleHostMetadata(bundle, plan)
	return filled, validateAISILCodeBundle(bundle, plan)
}

func validateAISILCodeBundle(bundle *aiSILCodeBundle, plan aiTestPlan) error {
	bundle.Version = strings.TrimSpace(bundle.Version)
	if bundle.Version == "" {
		bundle.Version = "1.0"
	}
	bundle.Driver = strings.ToLower(strings.TrimSpace(bundle.Driver))
	bundle.Capability = normalizeRequestedCapability(bundle.Driver, bundle.Capability)
	bundle.Summary = strings.TrimSpace(bundle.Summary)
	bundle.TestCommand = strings.TrimSpace(bundle.TestCommand)
	bundle.SmokeCommand = strings.TrimSpace(bundle.SmokeCommand)
	if bundle.Driver != strings.ToLower(strings.TrimSpace(plan.RequestedDriver)) {
		return fmt.Errorf("generated bundle driver %q does not match requested driver %q", bundle.Driver, plan.RequestedDriver)
	}
	requestedCap := normalizeRequestedCapability(plan.RequestedDriver, plan.RequestedCapability)
	if bundle.Capability != requestedCap {
		return fmt.Errorf("generated bundle capability %q does not match requested capability %q", bundle.Capability, requestedCap)
	}
	cmdRE := regexp.MustCompile(`^ai_sil_[a-z0-9_]{2,64}$`)
	if !cmdRE.MatchString(bundle.TestCommand) {
		return fmt.Errorf("test_command %q must be a single ai_sil_* command name", bundle.TestCommand)
	}
	if bundle.SmokeCommand == "" || len(bundle.SmokeCommand) > 180 || !regexp.MustCompile(`^[A-Za-z0-9_.:/ -]+$`).MatchString(bundle.SmokeCommand) {
		return fmt.Errorf("smoke_command contains unsupported characters or is empty")
	}
	smokeHead := strings.Fields(bundle.SmokeCommand)
	if len(smokeHead) == 0 || !cmdRE.MatchString(smokeHead[0]) {
		return fmt.Errorf("smoke_command must begin with an ai_sil_* command")
	}
	if smokeHead[0] != bundle.TestCommand {
		return fmt.Errorf("smoke_command command mismatch: expected first token %q to equal test_command, got %q", bundle.TestCommand, smokeHead[0])
	}
	if len(bundle.Scenarios) < 1 || len(bundle.Scenarios) > 12 {
		return fmt.Errorf("scenarios must contain 1..12 entries")
	}
	scenarioRE := regexp.MustCompile(`^[a-z0-9_.-]{1,64}$`)
	seenScenario := map[string]bool{}
	for i, scenario := range bundle.Scenarios {
		scenario = strings.ToLower(strings.TrimSpace(scenario))
		if !scenarioRE.MatchString(scenario) {
			return fmt.Errorf("invalid scenario %q", scenario)
		}
		if seenScenario[scenario] {
			return fmt.Errorf("duplicate scenario %q", scenario)
		}
		seenScenario[scenario] = true
		bundle.Scenarios[i] = scenario
	}
	if len(bundle.Files) < 1 || len(bundle.Files) > 6 {
		return fmt.Errorf("generated bundle must contain 1..6 files")
	}
	nameRE := regexp.MustCompile(`^ai_sil_ai_[A-Za-z0-9_.-]+\.(c|h)$`)
	seenFile := map[string]bool{}
	total := 0
	hasC := false
	allContent := strings.Builder{}
	for i := range bundle.Files {
		f := &bundle.Files[i]
		f.Name = strings.TrimSpace(f.Name)
		if !nameRE.MatchString(f.Name) || filepath.Base(f.Name) != f.Name {
			return fmt.Errorf("generated file %q is not an allowed isolated ai_sil_ai_*.c/.h name", f.Name)
		}
		if seenFile[strings.ToLower(f.Name)] {
			return fmt.Errorf("duplicate generated file %q", f.Name)
		}
		seenFile[strings.ToLower(f.Name)] = true
		if strings.TrimSpace(f.Content) == "" {
			return fmt.Errorf("generated file %s is empty", f.Name)
		}
		if len(f.Content) > 80000 {
			return fmt.Errorf("generated file %s exceeds 80KB", f.Name)
		}
		total += len(f.Content)
		if total > 180000 {
			return fmt.Errorf("generated bundle exceeds 180KB")
		}
		if strings.HasSuffix(strings.ToLower(f.Name), ".c") {
			hasC = true
		}
		allContent.WriteString(f.Content)
		allContent.WriteString("\n")
	}
	if !hasC {
		return fmt.Errorf("generated bundle must contain at least one .c file")
	}
	joined := allContent.String()

	// v0.9.13 strict executable command/protocol contract. A plain substring
	// check is not enough: a model can mention the requested command in a
	// comment/string while exporting a different MSH symbol. Parse the actual
	// MSH_CMD_EXPORT first argument and require the authoritative test_command.
	exportRE := regexp.MustCompile(`MSH_CMD_EXPORT\s*\(\s*([A-Za-z_][A-Za-z0-9_]*)\s*,`)
	exportMatches := exportRE.FindAllStringSubmatch(joined, -1)
	if len(exportMatches) == 0 {
		return fmt.Errorf("generated source must register the test command with MSH_CMD_EXPORT(%s, ...)", bundle.TestCommand)
	}
	exported := make([]string, 0, len(exportMatches))
	hasExpectedExport := false
	for _, m := range exportMatches {
		if len(m) < 2 {
			continue
		}
		exported = append(exported, m[1])
		if m[1] == bundle.TestCommand {
			hasExpectedExport = true
		}
	}
	if !hasExpectedExport {
		return fmt.Errorf("generated MSH command mismatch: expected MSH_CMD_EXPORT(%s, ...), found export(s): %s", bundle.TestCommand, strings.Join(exported, ", "))
	}

	// Protocol identity is the capability, not the shell command. Requiring the
	// exact literal prefix keeps host parsing deterministic and prevents cases
	// such as capability=gpio_toggle_pattern but AI_SMOKE reporting
	// ai_sil_gpio_toggle_pattern.
	expectedSmokePrefix := "@SIL,AI_SMOKE," + bundle.Capability + ","
	if !strings.Contains(joined, expectedSmokePrefix) {
		protoRE := regexp.MustCompile(`@SIL,AI_SMOKE,([A-Za-z0-9_.-]+),`)
		found := "none"
		if m := protoRE.FindStringSubmatch(joined); len(m) >= 2 {
			found = m[1]
		}
		return fmt.Errorf("AI_SMOKE capability mismatch: expected literal prefix %q, generated capability field=%q", expectedSmokePrefix, found)
	}
	expectedResultPrefix := "@SIL,GEN_RESULT," + bundle.Capability + ","
	if !strings.Contains(joined, expectedResultPrefix) {
		protoRE := regexp.MustCompile(`@SIL,GEN_RESULT,([A-Za-z0-9_.-]+),`)
		found := "none"
		if m := protoRE.FindStringSubmatch(joined); len(m) >= 2 {
			found = m[1]
		}
		return fmt.Errorf("GEN_RESULT capability mismatch: expected literal prefix %q, generated capability field=%q", expectedResultPrefix, found)
	}
	for _, banned := range []string{"system(", "popen(", "CreateProcess", "WinExec", "fopen(\"/", "remove(\"/"} {
		if strings.Contains(joined, banned) {
			return fmt.Errorf("generated source contains disallowed operation %q", banned)
		}
	}
	return nil
}

// isolateAISILBuildArtifacts keeps .ai_sil as a Workbench metadata/history
// directory only. RT-Thread Studio Managed Build recursively discovers C/C++
// sources under the project tree, so archived/generated source copies must never
// keep buildable source extensions inside .ai_sil.
func isolateAISILBuildArtifacts(ctx projectContext) (int, error) {
	workspace := filepath.Join(ctx.Root, ".ai_sil")
	if !dirExists(workspace) {
		return 0, nil
	}
	buildableExt := map[string]bool{
		".c": true, ".h": true, ".cc": true, ".cpp": true, ".cxx": true, ".s": true,
	}
	moved := 0
	err := filepath.Walk(workspace, func(path string, info os.FileInfo, walkErr error) error {
		if walkErr != nil {
			return walkErr
		}
		if info == nil || info.IsDir() {
			return nil
		}
		nameLower := strings.ToLower(info.Name())
		// CDT can leave managed-build fragments and objects beside source-tree
		// mirrors. They are disposable and must not keep stale .ai_sil targets alive.
		if nameLower == "subdir.mk" || nameLower == "objects.mk" || nameLower == "sources.mk" || strings.HasSuffix(nameLower, ".o") || strings.HasSuffix(nameLower, ".d") {
			_ = os.Remove(path)
			return nil
		}
		ext := strings.ToLower(filepath.Ext(info.Name()))
		if !buildableExt[ext] {
			return nil
		}
		dst := path + ".snapshot"
		if fileExists(dst) {
			dst = fmt.Sprintf("%s.%d.snapshot", path, time.Now().UnixNano())
		}
		if err := os.Rename(path, dst); err != nil {
			data, readErr := os.ReadFile(path)
			if readErr != nil {
				return err
			}
			if writeErr := os.WriteFile(dst, data, 0644); writeErr != nil {
				return writeErr
			}
			if removeErr := os.Remove(path); removeErr != nil {
				return removeErr
			}
		}
		moved++
		return nil
	})
	if err != nil {
		return moved, err
	}
	// Remove the generated Debug mirror so stale .ai_sil make fragments cannot
	// continue compiling files that have just been quarantined.
	_ = os.RemoveAll(filepath.Join(ctx.Root, "Debug", ".ai_sil"))
	return moved, nil
}

func aiSILFailureDir(root, capability string) string {
	return filepath.Join(root, ".ai_sil", "last_failure", capabilitySlug(capability))
}

func saveAISILFailureArtifacts(ctx projectContext, capability, reason, transcript string, bundle aiSILCodeBundle) {
	dir := aiSILFailureDir(ctx.Root, capability)
	if err := os.MkdirAll(dir, 0755); err != nil {
		logLine("ENGINEER", "WARNING: cannot create AI SIL failure folder: "+err.Error())
		return
	}
	_ = os.WriteFile(filepath.Join(dir, "reason.txt"), []byte(reason+"\r\n"), 0644)
	if strings.TrimSpace(transcript) != "" {
		_ = os.WriteFile(filepath.Join(dir, "build.log"), []byte(transcript), 0644)
	}
	if data, err := json.MarshalIndent(bundle, "", "  "); err == nil {
		_ = os.WriteFile(filepath.Join(dir, "bundle.json"), data, 0644)
	}
	logLine("ENGINEER", "Failure artifacts: "+dir)
}

type generatedWorkspaceSnapshot struct {
	AppFiles       map[string][]byte
	GeneratedFiles map[string][]byte
	Manifest       []byte
	ManifestExists bool
}

func captureGeneratedWorkspaceSnapshot(ctx projectContext, capability string) generatedWorkspaceSnapshot {
	snap := generatedWorkspaceSnapshot{AppFiles: map[string][]byte{}, GeneratedFiles: map[string][]byte{}}
	appDir := filepath.Join(ctx.Root, "applications")
	if paths, _ := filepath.Glob(filepath.Join(appDir, "ai_sil_ai_*")); len(paths) > 0 {
		for _, path := range paths {
			if data, err := os.ReadFile(path); err == nil {
				snap.AppFiles[filepath.Base(path)] = data
			}
		}
	}
	genDir := filepath.Join(ctx.Root, ".ai_sil", "generated", capabilitySlug(capability))
	_ = filepath.Walk(genDir, func(path string, info os.FileInfo, err error) error {
		if err != nil || info == nil || info.IsDir() {
			return nil
		}
		rel, err := filepath.Rel(genDir, path)
		if err != nil || rel == "manifest.json" {
			return nil
		}
		if data, err := os.ReadFile(path); err == nil {
			snap.GeneratedFiles[rel] = data
		}
		return nil
	})
	manifestPath := generatedManifestPath(ctx.Root, capability)
	if data, err := os.ReadFile(manifestPath); err == nil {
		snap.Manifest = data
		snap.ManifestExists = true
	}
	return snap
}

func restoreGeneratedWorkspaceSnapshot(ctx projectContext, capability string, snap generatedWorkspaceSnapshot) error {
	appDir := filepath.Join(ctx.Root, "applications")
	paths, _ := filepath.Glob(filepath.Join(appDir, "ai_sil_ai_*"))
	for _, path := range paths {
		_ = os.Remove(path)
	}
	for name, data := range snap.AppFiles {
		if err := os.WriteFile(filepath.Join(appDir, filepath.Base(name)), data, 0644); err != nil {
			return err
		}
	}
	genDir := filepath.Join(ctx.Root, ".ai_sil", "generated", capabilitySlug(capability))
	_ = os.RemoveAll(genDir)
	if len(snap.GeneratedFiles) > 0 || snap.ManifestExists {
		if err := os.MkdirAll(genDir, 0755); err != nil {
			return err
		}
		for rel, data := range snap.GeneratedFiles {
			path := filepath.Join(genDir, rel)
			if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
				return err
			}
			if err := os.WriteFile(path, data, 0644); err != nil {
				return err
			}
		}
		if snap.ManifestExists {
			if err := os.WriteFile(filepath.Join(genDir, "manifest.json"), snap.Manifest, 0644); err != nil {
				return err
			}
		}
	}
	invalidateManagedApplicationFragment(ctx)
	return nil
}

func applyAISILCodeBundle(ctx projectContext, bundle aiSILCodeBundle, provider, model string, attempt int) (generatedCapabilityManifest, error) {
	if err := validateAISILCodeBundle(&bundle, aiTestPlan{RequestedDriver: bundle.Driver, RequestedCapability: bundle.Capability}); err != nil {
		return generatedCapabilityManifest{}, err
	}
	slug := capabilitySlug(bundle.Capability)
	genDir := filepath.Join(ctx.Root, ".ai_sil", "generated", slug)
	appDir := filepath.Join(ctx.Root, "applications")
	if err := os.MkdirAll(genDir, 0755); err != nil {
		return generatedCapabilityManifest{}, err
	}
	if err := os.MkdirAll(appDir, 0755); err != nil {
		return generatedCapabilityManifest{}, err
	}

	// Remove only files previously owned by this generated capability and no longer
	// present in the repaired bundle. User files are never touched.
	newNames := map[string]bool{}
	for _, f := range bundle.Files {
		newNames[strings.ToLower(f.Name)] = true
	}
	if old, ok := loadGeneratedCapabilityManifest(ctx.Root, bundle.Capability); ok {
		for _, name := range old.Files {
			if !newNames[strings.ToLower(name)] && strings.HasPrefix(strings.ToLower(name), "ai_sil_ai_") {
				_ = os.Remove(filepath.Join(appDir, filepath.Base(name)))
			}
		}
	}

	backupDir := filepath.Join(ctx.Root, ".ai_sil", "backups", time.Now().Format("20060102_150405"), slug)
	for _, f := range bundle.Files {
		appPath := filepath.Join(appDir, f.Name)
		if data, err := os.ReadFile(appPath); err == nil {
			_ = os.MkdirAll(backupDir, 0755)
			// IMPORTANT: history inside .ai_sil must not use .c/.h extensions,
			// otherwise Eclipse CDT may recursively add it to Managed Build.
			_ = os.WriteFile(filepath.Join(backupDir, f.Name+".snapshot"), data, 0644)
		}
		// Keep a readable source-of-truth/history copy without a buildable source
		// extension. The only live compilable copy is applications/ai_sil_ai_*.
		if err := os.WriteFile(filepath.Join(genDir, f.Name+".snapshot"), []byte(f.Content), 0644); err != nil {
			return generatedCapabilityManifest{}, err
		}
		if err := os.WriteFile(appPath, []byte(f.Content), 0644); err != nil {
			return generatedCapabilityManifest{}, err
		}
	}
	manifest := generatedCapabilityManifest{
		Version: bundle.Version, Driver: bundle.Driver, Capability: bundle.Capability, Summary: bundle.Summary,
		TestCommand: bundle.TestCommand, SmokeCommand: bundle.SmokeCommand, Scenarios: append([]string(nil), bundle.Scenarios...),
		Status: "candidate", GeneratedAt: time.Now().Format(time.RFC3339), Provider: provider, Model: model, BuildAttempts: attempt,
	}
	for _, f := range bundle.Files {
		manifest.Files = append(manifest.Files, f.Name)
	}
	if err := writeGeneratedCapabilityManifest(ctx.Root, manifest); err != nil {
		return generatedCapabilityManifest{}, err
	}
	invalidateManagedApplicationFragment(ctx)
	return manifest, nil
}

func setGeneratedManifestStatus(root string, m generatedCapabilityManifest, status string, attempts int) generatedCapabilityManifest {
	m.Status = status
	m.BuildAttempts = attempts
	_ = writeGeneratedCapabilityManifest(root, m)
	return m
}

func waitSessionStopped(timeout time.Duration) {
	deadline := time.Now().Add(timeout)
	for session.running.Load() && time.Now().Before(deadline) {
		time.Sleep(50 * time.Millisecond)
	}
}

func runGeneratedCapabilityProbe(ctx projectContext, firmware string, m generatedCapabilityManifest) (silProtocolEvent, error) {
	if session.running.Load() {
		logLine("ENGINEER", "Stopping QEMU before probing freshly built generated capability.")
		session.stop()
		waitSessionStopped(2 * time.Second)
	}
	cfg := qemuConfig{Exe: strings.TrimSpace(getText(edtQemu)), Firmware: firmware}
	if err := session.start(cfg); err != nil {
		return silProtocolEvent{}, fmt.Errorf("start QEMU for capability probe: %w", err)
	}
	if !waitReady(10 * time.Second) {
		return silProtocolEvent{}, fmt.Errorf("capability probe: msh > was not detected within 10 seconds")
	}
	drainSILProtocolEvents()
	logLine("ENGINEER", "Capability probe command: "+m.SmokeCommand)
	if detail := sendVerifiedCommand(m.SmokeCommand); detail != "" {
		return silProtocolEvent{}, fmt.Errorf("capability probe transport: %s", detail)
	}
	ev, ok, detail := waitGeneratedProtocolEvent("AI_SMOKE", m.Capability, "", "", 6*time.Second)
	if !ok {
		return silProtocolEvent{}, fmt.Errorf("capability probe protocol: %s", detail)
	}
	value := strings.ToUpper(strings.TrimSpace(ev.Value))
	if value != "PASS" && value != "FAIL" {
		return silProtocolEvent{}, fmt.Errorf("capability probe returned invalid AI_SMOKE status: %s", ev.Raw)
	}

	// v0.9.12 semantic boundary:
	// AI_SMOKE is only proof that the generated command is present, invokable,
	// and able to return the expected protocol frame without crashing QEMU/RT-Thread.
	// Older generated harnesses may still perform a functional check in their
	// smoke branch and therefore emit FAIL (for example MISMATCH_HIGH_READ_0).
	// Such a functional observation must NOT invalidate/rollback a successfully
	// built capability. It is carried forward as a hint; the formal Test Case
	// and deterministic Rule Engine own the functional PASS/FAIL verdict.
	if value == "FAIL" {
		logLine("ENGINEER", "Capability probe READY; legacy/functional AI_SMOKE reported FAIL and will be treated as a test hint, not a capability failure: "+ev.Raw)
	} else {
		logLine("ENGINEER", "Capability probe READY: "+ev.Raw)
	}
	return ev, nil
}

func runAISILEngineerSync(plan aiTestPlan, requirement string) error {
	if plan.Route != "capability_missing" {
		return fmt.Errorf("AI SIL Engineer requires a capability_missing TestPlan")
	}
	if plan.RequestedDriver == "gpio" && normalizeRequestedCapability(plan.RequestedDriver, plan.RequestedCapability) == "gpio_input_readback" {
		return fmt.Errorf("gpio_input_readback already has a deterministic built-in extension; use normal Run Test so the safer template path is used")
	}
	currentProjectMu.Lock()
	ctx := currentProject
	currentProjectMu.Unlock()
	if strings.TrimSpace(ctx.Root) == "" {
		return fmt.Errorf("analyze the RT-Thread project first")
	}
	if isolated, err := isolateAISILBuildArtifacts(ctx); err != nil {
		return fmt.Errorf("prepare isolated AI SIL workspace: %w", err)
	} else if isolated > 0 {
		logLine("ENGINEER", fmt.Sprintf("Build Isolation migrated %d legacy .ai_sil source file(s) to .snapshot; workspace=%s", isolated, filepath.Join(ctx.Root, ".ai_sil")))
	}
	if strings.TrimSpace(findDriverSourceForAI(ctx, plan.RequestedDriver)) == "" {
		logLine("ENGINEER", "No matching drv_*.c source was detected; AI will receive project configuration and must report blockers honestly.")
	}

	uiText(lblRunState, "State    AI SIL Engineer analyzing driver...")
	uiResultState("AI CODEGEN", "AI SIL 工程师 · 正在分析驱动", "阶段 1/5  分析工程与驱动\r\n阶段 2/5  生成隔离测试代码\r\n阶段 3/5  Build / 自动修复\r\n阶段 4/5  QEMU 命令/协议就绪检查\r\n阶段 5/5  执行正式功能测试")
	showLogView("agent")
	logLine("ENGINEER", fmt.Sprintf("Start driver=%s capability=%s requirement=%q", plan.RequestedDriver, plan.RequestedCapability, requirement))
	logLine("ENGINEER", "AI SIL workspace: "+filepath.Join(ctx.Root, ".ai_sil"))
	logLine("ENGINEER", "Only applications/ai_sil_ai_*.c/.h are live build sources; .ai_sil stores metadata and non-buildable .snapshot history only.")

	systemPrompt, userPrompt := aiSILGenerationPrompts(ctx, plan, requirement)
	bundle, provider, model, err := requestAISILCodeBundle(systemPrompt, userPrompt, "codegen")
	if err != nil {
		return fmt.Errorf("AI code generation: %w", err)
	}
	filled, validationErr := validateAISILCodeBundleWithHostMetadata(&bundle, plan)
	if len(filled) > 0 {
		logLine("ENGINEER", "Host safely filled omitted bundle metadata: "+strings.Join(filled, ", "))
	}
	// Keep repairing malformed AI bundles until validation succeeds, the user
	// stops the engineer, or the model makes no change at all. No project file
	// is written during this phase.
	for validationErr != nil {
		if engineerStopRequested.Load() {
			return fmt.Errorf("AI SIL Engineer stopped by user during bundle validation")
		}
		logLine("ENGINEER", "AI bundle rejected before Build: "+validationErr.Error())
		uiResultState("BUNDLE REPAIR", "AI Code Bundle 不完整 · 持续自动修复", "Workbench 尚未写入任何工程文件。\r\n\r\nValidator: "+validationErr.Error()+"\r\n\r\n将持续要求模型修复，直到 Validator 通过；可随时点击“停止”。")
		before, _ := json.Marshal(bundle)
		repairSystem, repairUser := aiSILBundleRepairPrompts(ctx, plan, requirement, bundle, validationErr)
		bundle, _, _, err = requestAISILCodeBundle(repairSystem, repairUser, "repair")
		if err != nil {
			return fmt.Errorf("AI bundle repair: %w", err)
		}
		after, _ := json.Marshal(bundle)
		if bytes.Equal(before, after) {
			return fmt.Errorf("AI bundle repair made no changes while Validator still rejects the bundle: %w", validationErr)
		}
		filled, validationErr = validateAISILCodeBundleWithHostMetadata(&bundle, plan)
		if len(filled) > 0 {
			logLine("ENGINEER", "Host safely filled omitted metadata after bundle repair: "+strings.Join(filled, ", "))
		}
	}
	logLine("ENGINEER", "AI bundle accepted by validator; continuing to materialize and Build.")
	logLine("ENGINEER", fmt.Sprintf("AI generated %d isolated file(s), command=%s, scenarios=%s", len(bundle.Files), bundle.TestCommand, strings.Join(bundle.Scenarios, "|")))

	root, qemu := ctx.Root, strings.TrimSpace(getText(edtQemu))
	workspaceSnapshot := captureGeneratedWorkspaceSnapshot(ctx, plan.RequestedCapability)
	workspaceCommitted := false
	defer func() {
		if workspaceCommitted {
			return
		}
		if err := restoreGeneratedWorkspaceSnapshot(ctx, plan.RequestedCapability, workspaceSnapshot); err != nil {
			logLine("ENGINEER", "WARNING: automatic rollback failed: "+err.Error())
		} else {
			logLine("ENGINEER", "Restored last pre-AI generated workspace after unsuccessful engineer run.")
		}
	}()
	var manifest generatedCapabilityManifest
	var fw string
	var probeEv silProtocolEvent
	for attempt := 1; ; attempt++ {
		if engineerStopRequested.Load() {
			return fmt.Errorf("AI SIL Engineer stopped by user before Build attempt %d", attempt)
		}
		uiText(lblRunState, fmt.Sprintf("State    AI SIL Engineer Build #%d...", attempt))
		logLine("ENGINEER", fmt.Sprintf("Build attempt #%d", attempt))
		manifest, err = applyAISILCodeBundle(ctx, bundle, provider, model, attempt)
		if err != nil {
			return fmt.Errorf("materialize AI-generated code: %w", err)
		}
		if session.running.Load() {
			session.stop()
			waitSessionStopped(2 * time.Second)
		}
		uiText(lblBuildState, fmt.Sprintf("Build    ◐ AI repair #%d", attempt))
		var builtCtx projectContext
		builtCtx, fw, err = studioBuildSync(root, qemu)
		if err != nil {
			manifest = setGeneratedManifestStatus(root, manifest, "build_failed", attempt)
			transcript := latestBuildTranscript()
			logLine("ENGINEER", fmt.Sprintf("Build FAIL on attempt %d: %v", attempt, err))
			saveAISILFailureArtifacts(ctx, plan.RequestedCapability, fmt.Sprintf("Build #%d failed: %v", attempt, err), transcript, bundle)
			if !strings.Contains(strings.ToLower(transcript), "ai_sil_ai_") {
				return fmt.Errorf("Build failed, but the compiler transcript does not point to AI-generated files. Automatic repair stopped to avoid modifying unrelated project code: %w", err)
			}
			if engineerStopRequested.Load() {
				return fmt.Errorf("AI SIL Engineer stopped by user after Build #%d", attempt)
			}
			uiResultState("REPAIRING", fmt.Sprintf("Build #%d 失败 · AI 正在持续修复", attempt), "Workbench 已把真实编译器错误和当前生成文件重新交给 AI。\r\n\r\n没有固定重试轮数：将持续修复直到 Build PASS、检测到不可自动修复的阻塞，或你点击“停止”。\r\n\r\n自动修复只允许覆盖 ai_sil_ai_*.c/.h；原始 driver / main.c / rtconfig.h 不会被 AI 直接修改。")
			beforeRepair, _ := json.Marshal(bundle)
			repairSystem, repairUser := aiSILRepairPrompts(ctx, plan, requirement, bundle, transcript)
			bundle, _, _, err = requestAISILCodeBundle(repairSystem, repairUser, "repair")
			if err != nil {
				return fmt.Errorf("AI repair #%d: %w", attempt, err)
			}
			afterRepair, _ := json.Marshal(bundle)
			if bytes.Equal(beforeRepair, afterRepair) {
				return fmt.Errorf("AI repair #%d made no source changes while Build is still failing; automatic repair stopped as no progress", attempt)
			}
			filled, repairValidationErr := validateAISILCodeBundleWithHostMetadata(&bundle, plan)
			if len(filled) > 0 {
				logLine("ENGINEER", "Host safely filled omitted metadata in build repair: "+strings.Join(filled, ", "))
			}
			if repairValidationErr != nil {
				return fmt.Errorf("AI repair #%d rejected by validator: %w", attempt, repairValidationErr)
			}
			logLine("ENGINEER", fmt.Sprintf("AI compiler repair #%d accepted; retrying Build", attempt))
			continue
		}

		ctx = builtCtx
		manifest = setGeneratedManifestStatus(root, manifest, "build_pass", attempt)
		currentProjectMu.Lock()
		currentProject = ctx
		currentProjectMu.Unlock()
		uiText(edtFirmware, fw)
		uiText(lblBuildState, "Build    ● Ready")
		logLine("ENGINEER", fmt.Sprintf("Build PASS on attempt %d: %s", attempt, fw))

		// Build PASS only proves the code compiled/linked. Now verify the generated
		// command-registration and @SIL readiness protocol contract. If this exact
		// infrastructure contract is broken, automatically repair ONLY the generated
		// harness and rebuild. Functional DUT mismatches are not repaired here.
		uiText(lblRunState, "State    Build passed; verifying generated command/protocol readiness...")
		uiResultState("CAPABILITY PROBE", "Build 已通过 · 正在确认测试能力可调用", "这里仅检查：QEMU/RT-Thread 能启动、生成的 MSH 命令名与 Bundle 一致、命令可调用、@SIL,AI_SMOKE 的 capability 字段正确。\r\n\r\n不会在这一阶段修驱动功能，也不会把功能不符合预期当成 Capability FAIL。")
		probeEv, err = runGeneratedCapabilityProbe(ctx, fw, manifest)
		if err == nil {
			manifest.ProbeStatus = "ready"
			manifest.ProbeRaw = probeEv.Raw
			manifest = setGeneratedManifestStatus(root, manifest, "ready", manifest.BuildAttempts)
			break
		}

		manifest = setGeneratedManifestStatus(root, manifest, "probe_failed", manifest.BuildAttempts)
		probeErr := err
		uartEvidence := getText(edtUartConsole)
		if len(uartEvidence) > 16000 {
			uartEvidence = uartEvidence[len(uartEvidence)-16000:]
		}
		logLine("ENGINEER", "Capability probe FAIL after Build PASS: "+probeErr.Error())
		saveAISILFailureArtifacts(ctx, plan.RequestedCapability, "Capability probe failed after Build PASS: "+probeErr.Error(), latestBuildTranscript()+"\n\n=== PROBE UART ===\n"+uartEvidence, bundle)

		if !isAISILProbeRepairable(probeErr) {
			return probeErr
		}
		if engineerStopRequested.Load() {
			return fmt.Errorf("AI SIL Engineer stopped by user during command/protocol repair")
		}
		uiResultState("PROTOCOL REPAIR", "Build 已通过 · 自动修复生成 Harness 的命令/协议契约", "正式驱动测试尚未开始。Workbench 检测到生成 Harness 的 MSH 注册名或 @SIL,AI_SMOKE 协议不符合约定。\r\n\r\n将只允许 AI 修改 applications/ai_sil_ai_*.c/.h 中的命令注册 / smoke 协议代码，然后自动重新 Build + Probe；不会修改 drv_gpio.c、BSP、rtconfig.h，也不会放宽功能测试规则。\r\n\r\nProbe: "+probeErr.Error())
		beforeRepair, _ := json.Marshal(bundle)
		repairSystem, repairUser := aiSILProbeRepairPrompts(ctx, plan, requirement, bundle, probeErr.Error(), uartEvidence)
		bundle, _, _, err = requestAISILCodeBundle(repairSystem, repairUser, "repair")
		if err != nil {
			return fmt.Errorf("AI command/protocol repair after Build #%d: %w", attempt, err)
		}
		afterRepair, _ := json.Marshal(bundle)
		if bytes.Equal(beforeRepair, afterRepair) {
			return fmt.Errorf("AI command/protocol repair made no source changes while capability probe still fails: %w", probeErr)
		}

		filled, validationErr := validateAISILCodeBundleWithHostMetadata(&bundle, plan)
		if len(filled) > 0 {
			logLine("ENGINEER", "Host safely filled omitted metadata in protocol repair: "+strings.Join(filled, ", "))
		}
		// A protocol-repair response can itself violate the static contract. Keep
		// repairing it before touching/building project files again.
		for validationErr != nil {
			if engineerStopRequested.Load() {
				return fmt.Errorf("AI SIL Engineer stopped by user during protocol bundle validation")
			}
			logLine("ENGINEER", "Protocol repair bundle rejected before rebuild: "+validationErr.Error())
			beforeValidationRepair, _ := json.Marshal(bundle)
			validationSystem, validationUser := aiSILBundleRepairPrompts(ctx, plan, requirement, bundle, validationErr)
			bundle, _, _, err = requestAISILCodeBundle(validationSystem, validationUser, "repair")
			if err != nil {
				return fmt.Errorf("AI protocol bundle repair: %w", err)
			}
			afterValidationRepair, _ := json.Marshal(bundle)
			if bytes.Equal(beforeValidationRepair, afterValidationRepair) {
				return fmt.Errorf("AI protocol bundle repair made no changes while Validator still rejects the bundle: %w", validationErr)
			}
			filled, validationErr = validateAISILCodeBundleWithHostMetadata(&bundle, plan)
			if len(filled) > 0 {
				logLine("ENGINEER", "Host safely filled omitted metadata after protocol bundle repair: "+strings.Join(filled, ", "))
			}
		}
		logLine("ENGINEER", fmt.Sprintf("AI command/protocol repair accepted after Build #%d; rebuilding and probing again", attempt))
	}

	workspaceCommitted = true
	logLine("ENGINEER", "Capability READY after Build + QEMU command/protocol probe: "+manifest.Capability)
	probeNote := "命令/协议就绪检查通过。接下来执行正式功能测试，由 Rule Engine 根据 TestPlan Expected 与运行 Evidence 判定 PASS/FAIL。"
	if strings.EqualFold(probeEv.Value, "FAIL") {
		probeNote = "命令/协议已就绪。旧式 AI_SMOKE 返回了功能性 FAIL：" + probeEv.Raw + "\r\n该信息仅作为测试提示，不会回滚 Harness；接下来正式 Test Case 才产生功能判定。"
	}
	uiResultState("READY", "AI 生成测试能力已就绪", fmt.Sprintf("Capability  %s\r\nDriver      %s\r\nCommand     %s <target> <scenario>\r\nScenarios   %s\r\n\r\n%s", manifest.Capability, manifest.Driver, manifest.TestCommand, strings.Join(manifest.Scenarios, ", "), probeNote))

	newPlan, newProvider, newModel, err := requestAITestPlan(requirement)
	if err != nil {
		return fmt.Errorf("AI re-plan after generated capability became READY: %w", err)
	}
	applyAIPlanToUIForRequirement(newPlan, newProvider, newModel, requirement)
	if newPlan.Route != "run_existing" {
		return fmt.Errorf("generated capability is READY, but re-plan returned %s: %s", newPlan.Route, newPlan.Reason)
	}
	uiText(lblRunState, "State    Generated capability READY; executing original requirement...")
	return runAIPlanSync(newPlan, newProvider, newModel, requirement)
}

func startAISILEngineer() {
	if engineerRunning.Load() {
		message("AI SIL Engineer", "AI SIL Engineer is already running.", MB_OK|MB_ICONINFORMATION)
		return
	}
	currentPlanMu.Lock()
	plan := currentPlan
	requirement := currentPlanRequirement
	currentPlanMu.Unlock()
	if plan.Route != "capability_missing" {
		message("AI SIL Engineer", "先生成一个 CAPABILITY MISSING 的 TestPlan。只有缺失的新测试能力才需要 AI 生成代码。", MB_OK|MB_ICONINFORMATION)
		return
	}
	text := fmt.Sprintf("AI 将为 %s / %s 生成隔离测试代码，并持续自动 Build / 修复。\r\n\r\nWorkbench 会在 Build 前强校验 test_command、MSH_CMD_EXPORT、smoke_command、AI_SMOKE/GEN_RESULT capability 字段必须完全一致；若不一致会自动要求 AI 修复，不需要手工改 C。\r\n\r\nBuild 成功后还会自动启动 QEMU 做命令/协议就绪检查。如果出现 command not found、AI_SMOKE_TIMEOUT 或 capability mismatch，且已确认 Build/QEMU/串口链路正常，会进入“命令/协议自动修复 → 重新 Build → 重新 Probe”循环。\r\n\r\n允许自动修改的范围仍仅限 applications/ai_sil_ai_*.c/.h；原始 driver、main.c、rtconfig.h 不会被 AI 直接修改，也不会放宽正式功能测试规则。\r\n\r\n随后才执行正式 Test Case，由 Rule Engine 判定 PASS/FAIL。\r\n\r\n是否继续？", plan.RequestedDriver, plan.RequestedCapability)
	if messageResult("AI SIL 工程师", text, MB_YESNO|MB_ICONQUESTION) != IDYES {
		return
	}
	engineerStopRequested.Store(false)
	engineerRunning.Store(true)
	setBusy(true)
	go func() {
		defer engineerRunning.Store(false)
		defer setBusy(false)
		if err := runAISILEngineerSync(plan, requirement); err != nil {
			uiText(lblRunState, "State    AI SIL Engineer stopped")
			uiResultState("ERROR", "AI SIL 工程师基础设施未完成", err.Error()+"\r\n\r\n请查看 Build Output / Agent Events。这里只表示生成代码 Build、QEMU 启动、MSH 命令注册或 @SIL 协议链路尚未就绪；正式驱动功能测试的 PASS/FAIL 不会触发 Harness 回滚。")
			logLine("ENGINEER", "STOP: "+err.Error())
		}
	}()
}

func extendCapabilityAndBuild(plan aiTestPlan) (string, error) {
	root := strings.TrimSpace(getText(edtProject))
	qemu := strings.TrimSpace(getText(edtQemu))
	ctx, err := detectProject(root)
	if err != nil {
		return "", err
	}
	capability := normalizeRequestedCapability(plan.RequestedDriver, plan.RequestedCapability)
	if plan.RequestedDriver != "gpio" || capability != "gpio_input_readback" {
		return "", fmt.Errorf("automatic extension is not available for this requirement\r\n\r\n%s", capabilityBlockerDetails(plan, ctx))
	}
	uiText(lblRunState, "State    Generating GPIO input SIL capability...")
	postUI(func() {
		setPipelinePrepCapability("正在安装 gpio_input_readback", "active")
	})
	uiCapabilityBadge(ctx.Root, "building")
	uiResultState("BUILDING", "正在安装 GPIO Input SIL Capability", "阶段 1/3  生成受控 GPIO Input 测试模板\r\n阶段 2/3  增量 Build RT-Thread Firmware\r\n阶段 3/3  重新路由原始需求并执行")
	logLine("BUILDER", "Applying validated template gpio_input_readback to "+ctx.Root)
	if err := generateGPIOInputCapability(ctx, plan.Target); err != nil {
		return "", err
	}
	uiText(lblCodegenState, "CodeGen  ● GPIO OUT+IN")
	uiText(edtTestcase, "CAPABILITY BUILDER\r\n========================================\r\nGenerated: gpio_input_readback\r\nDriver path: rt_pin_mode/read -> drivers/drv_gpio.c -> virtual external-input boundary\r\nMSH command: ai_test_gpio_input <pin>\r\n\r\nmain.c was not modified.\r\n\r\nRunning RT-Thread Studio incremental Build...")
	if session.running.Load() {
		logLine("BUILDER", "Stopping QEMU before rebuilding firmware.")
		session.stop()
		time.Sleep(300 * time.Millisecond)
	}
	uiText(lblBuildState, "Build    ◐ Studio")
	ctx, fw, err := studioBuildSync(root, qemu)
	if err != nil {
		return "", err
	}
	currentProjectMu.Lock()
	currentProject = ctx
	currentProjectMu.Unlock()
	uiText(edtFirmware, fw)
	uiText(lblBuildState, "Build    ● Ready")
	postUI(func() { setPipelinePrepCapability("gpio_input_readback · READY", "done") })
	uiCapabilityBadge(ctx.Root, "")
	uiResultState("READY", "GPIO Input SIL Capability 已安装", "gpio_input_readback 已写入受控测试模板并完成 Firmware Build。\r\n\r\n接下来 Workbench 会重新规划原始需求；新的 TestPlan 将通过 ai_test_gpio_input <pin> 执行。")
	logLine("BUILDER", "Capability gpio_input_readback installed and firmware rebuilt: "+fw)
	return fw, nil
}

func extendCurrentCapability() {
	currentPlanMu.Lock()
	plan := currentPlan
	currentPlanMu.Unlock()
	if plan.Route != "capability_missing" {
		message("No missing capability", "Generate a requirement that routes to CAPABILITY MISSING first.", MB_OK|MB_ICONINFORMATION)
		return
	}
	setBusy(true)
	go func() {
		defer setBusy(false)
		fw, err := extendCapabilityAndBuild(plan)
		if err != nil {
			currentProjectMu.Lock()
			root := currentProject.Root
			currentProjectMu.Unlock()
			uiCapabilityBadge(root, "error")
			uiText(lblRunState, "State    Capability extension blocked/failed")
			uiResultState("ERROR", "GPIO Input Capability 扩展失败", "CAPABILITY BUILDER STOPPED\r\n\r\n"+err.Error())
			return
		}
		uiText(lblRunState, "State    Capability installed; re-routing requirement...")
		req := strings.TrimSpace(getText(edtPrompt))
		newPlan, provider, model, err := requestAITestPlan(req)
		if err != nil {
			uiText(lblRunState, "State    Capability built; AI re-plan failed")
			uiMessage("Re-plan failed", err.Error(), MB_OK|MB_ICONERROR)
			return
		}
		applyAIPlanToUI(newPlan, provider, model)
		if newPlan.Route == "run_existing" {
			uiText(edtResult, renderAIPlan(newPlan)+"\r\n\r\nCAPABILITY BUILD COMPLETE\r\nFirmware: "+fw+"\r\nThe original requirement is now executable. Click 运行测试 to execute the current plan.")
		}
	}()
}

func executePlanLifecycleSync(plan aiTestPlan, provider, model, requirement string) error {
	requirement = strings.TrimSpace(requirement)
	if plan.Route == "capability_missing" {
		if !canAutoExtend(plan) {
			currentProjectMu.Lock()
			ctx := currentProject
			currentProjectMu.Unlock()
			uiText(edtResult, renderCapabilityDecision(plan)+"\r\n\r\nAI SIL ENGINEER\r\n"+capabilityBlockerDetails(plan, ctx)+"\r\n\r\n如果该驱动源码存在，可以点击 TestPlan 下方的「AI SIL 工程师 · 生成/修复代码」尝试生成隔离测试 Harness、自动 Build/修复并运行 QEMU 命令/协议就绪检查。")
			uiText(lblRunState, "State    Missing capability · AI SIL Engineer available")
			return nil
		}
		uiText(lblRunState, "State    Current TestPlan needs an auto-extendable capability; generating + building...")
		if _, err := extendCapabilityAndBuild(plan); err != nil {
			currentProjectMu.Lock()
			root := currentProject.Root
			currentProjectMu.Unlock()
			uiCapabilityBadge(root, "error")
			uiText(lblRunState, "State    Capability auto-extension failed")
			uiResultState("ERROR", "GPIO Input Capability 自动扩展失败", "CAPABILITY AUTO-EXTENSION FAILED\r\n\r\n"+err.Error())
			return err
		}
		// Capability changes the executable surface, so re-route the SAME requirement once.
		newPlan, newProvider, newModel, err := requestAITestPlan(requirement)
		if err != nil {
			uiText(lblRunState, "State    Capability built; AI re-plan failed")
			return fmt.Errorf("AI re-plan after capability build: %w", err)
		}
		plan, provider, model = newPlan, newProvider, newModel
		applyAIPlanToUIForRequirement(plan, provider, model, requirement)
	}
	if plan.Route != "run_existing" {
		uiText(lblRunState, "State    Current TestPlan is not executable")
		return nil
	}
	return runAIPlanSync(plan, provider, model, requirement)
}

func startCurrentPlanExecution(plan aiTestPlan, provider, model, requirement string) {
	setBusy(true)
	uiText(lblRunState, "State    Running current TestPlan...")
	logLine("PLAN", "Running the currently displayed TestPlan without regenerating it.")
	go func() {
		defer setBusy(false)
		if err := executePlanLifecycleSync(plan, provider, model, requirement); err != nil {
			uiText(lblRunState, "State    Current TestPlan run failed")
			uiMessage("TestPlan run failed", err.Error(), MB_OK|MB_ICONERROR)
		}
	}()
}

func generateAndRunRequirement(requirement string) {
	requirement = strings.TrimSpace(requirement)
	setBusy(true)
	uiText(lblRunState, "State    No current TestPlan; generating one before execution...")
	logLine("AI", "No reusable TestPlan found; generating a new TestPlan before execution.")
	go func(req string) {
		defer setBusy(false)
		plan, provider, model, err := generateAIPlanForRequirement(req)
		if err != nil {
			uiText(lblRunState, "State    AI planning failed")
			uiMessage("AI planning failed", err.Error(), MB_OK|MB_ICONERROR)
			return
		}
		applyAIPlanToUIForRequirement(plan, provider, model, req)
		if err := executePlanLifecycleSync(plan, provider, model, req); err != nil {
			uiText(lblRunState, "State    Plan + Run failed")
			uiMessage("Plan + Run failed", err.Error(), MB_OK|MB_ICONERROR)
		}
	}(requirement)
}

func runAIPlan() {
	currentPlanMu.Lock()
	plan := currentPlan
	provider := currentPlanProvider
	model := currentPlanModel
	requirement := currentPlanRequirement
	currentPlanMu.Unlock()
	if strings.TrimSpace(plan.Route) == "" {
		message("No AI TestPlan", "Generate a TestPlan first, or use 运行测试 to generate and execute automatically.", MB_OK|MB_ICONINFORMATION)
		return
	}
	startCurrentPlanExecution(plan, provider, model, requirement)
}

func aiGenerateAndRun() {
	requirement := strings.TrimSpace(getText(edtPrompt))
	if requirement == "" {
		message("测试需求为空", "请先输入测试需求。", MB_OK|MB_ICONINFORMATION)
		return
	}

	currentPlanMu.Lock()
	plan := currentPlan
	provider := currentPlanProvider
	model := currentPlanModel
	planRequirement := strings.TrimSpace(currentPlanRequirement)
	currentPlanMu.Unlock()

	// No plan yet: Run means Plan + Run.
	if strings.TrimSpace(plan.Route) == "" {
		generateAndRunRequirement(requirement)
		return
	}

	// Same requirement: Run means execute exactly the currently displayed plan.
	if requirement == planRequirement {
		startCurrentPlanExecution(plan, provider, model, planRequirement)
		return
	}

	// The requirement changed after the current plan was generated. Never silently replace it.
	choice := messageResult(
		"测试需求已变化",
		"当前 TestPlan 是基于旧测试需求生成的。\r\n\r\n"+
			"是（Yes）：根据新需求重新生成 TestPlan，并运行新计划\r\n"+
			"否（No）：保持当前 TestPlan，直接运行当前计划\r\n"+
			"取消（Cancel）：返回，不执行\r\n\r\n"+
			"当前计划需求：\r\n"+planRequirement+"\r\n\r\n"+
			"当前输入需求：\r\n"+requirement,
		MB_YESNOCANCEL|MB_ICONQUESTION,
	)
	switch choice {
	case IDYES:
		generateAndRunRequirement(requirement)
	case IDNO:
		startCurrentPlanExecution(plan, provider, model, planRequirement)
	case IDCANCEL:
		return
	default:
		return
	}
}

func aiDiagnosisSchema() map[string]any {
	return map[string]any{
		"type": "object",
		"properties": map[string]any{
			"summary": map[string]any{"type": "string"},
			"evidence": map[string]any{
				"type": "array", "minItems": 1, "maxItems": 8,
				"items": map[string]any{"type": "string"},
			},
			"suspected_layer": map[string]any{"type": "string"},
			"possible_causes": map[string]any{
				"type": "array", "minItems": 0, "maxItems": 8,
				"items": map[string]any{"type": "string"},
			},
			"recommended_checks": map[string]any{
				"type": "array", "minItems": 1, "maxItems": 8,
				"items": map[string]any{"type": "string"},
			},
		},
		"required":             []string{"summary", "evidence", "suspected_layer", "possible_causes", "recommended_checks"},
		"additionalProperties": false,
	}
}

func trimList(in []string, max int) []string {
	out := make([]string, 0, len(in))
	for _, v := range in {
		v = strings.TrimSpace(v)
		if v == "" {
			continue
		}
		if len(v) > 500 {
			v = v[:500] + "..."
		}
		out = append(out, v)
		if len(out) >= max {
			break
		}
	}
	return out
}

func validateDiagnosis(d *aiDiagnosis) error {
	d.Summary = strings.TrimSpace(d.Summary)
	d.SuspectedLayer = strings.TrimSpace(d.SuspectedLayer)
	d.Evidence = trimList(d.Evidence, 8)
	d.PossibleCauses = trimList(d.PossibleCauses, 8)
	d.RecommendedChecks = trimList(d.RecommendedChecks, 8)
	if d.Summary == "" {
		return fmt.Errorf("diagnosis summary is empty")
	}
	if len(d.Evidence) == 0 {
		return fmt.Errorf("diagnosis evidence is empty")
	}
	if d.SuspectedLayer == "" {
		return fmt.Errorf("suspected_layer is empty")
	}
	if len(d.RecommendedChecks) == 0 {
		return fmt.Errorf("recommended_checks is empty")
	}
	return nil
}

func parseDiagnosisJSON(textOut string) (aiDiagnosis, error) {
	t := strings.TrimSpace(textOut)
	if strings.HasPrefix(t, "```") {
		lines := strings.Split(t, "\n")
		if len(lines) >= 2 {
			lines = lines[1:]
			if len(lines) > 0 && strings.TrimSpace(lines[len(lines)-1]) == "```" {
				lines = lines[:len(lines)-1]
			}
			t = strings.TrimSpace(strings.Join(lines, "\n"))
		}
	}
	var d aiDiagnosis
	if err := json.Unmarshal([]byte(t), &d); err != nil {
		first, last := strings.Index(t, "{"), strings.LastIndex(t, "}")
		if first >= 0 && last > first {
			if err2 := json.Unmarshal([]byte(t[first:last+1]), &d); err2 == nil {
				if err := validateDiagnosis(&d); err != nil {
					return aiDiagnosis{}, err
				}
				return d, nil
			}
		}
		return aiDiagnosis{}, fmt.Errorf("model output was not valid diagnosis JSON: %w", err)
	}
	if err := validateDiagnosis(&d); err != nil {
		return aiDiagnosis{}, err
	}
	return d, nil
}

func diagnosisPayload(run aiRunSnapshot) map[string]any {
	cases := make([]map[string]any, 0, len(run.Rows))
	for _, row := range run.Rows {
		m := map[string]any{
			"case_id":                     row.Case.ID,
			"description":                 row.Case.Description,
			"injected_fault":              row.Case.Fault,
			"expected_functional_verdict": row.Case.Expected,
			"timeout":                     row.Timeout,
			"protocol_error":              row.ProtocolError,
		}
		if !row.Timeout && row.ProtocolError == "" {
			m["observed_functional_verdict"] = row.Result.Verdict
			if run.Plan.RequestedCapability == "gpio_input_readback" {
				m["external_high_stimulus"] = 1
				m["high_observed"] = row.Result.High
				m["external_low_stimulus"] = 0
				m["low_observed"] = row.Result.Low
			} else {
				m["high_requested"] = 1
				m["high_observed"] = row.Result.High
				m["low_requested"] = 0
				m["low_observed"] = row.Result.Low
			}
			m["driver_calls"] = map[string]any{"mode": row.Result.ModeCalls, "write": row.Result.WriteCalls, "read": row.Result.ReadCalls}
			m["hal_mode"] = row.Result.HALMode
			m["pull"] = row.Result.Pull
			m["errors"] = row.Result.Errors
			m["failed_rules"] = row.Result.Failed
		}
		cases = append(cases, m)
	}
	return map[string]any{
		"requirement":    run.Requirement,
		"project":        map[string]any{"name": run.Project.ProjectName, "mcu": run.Project.MCU, "rt_thread": run.Project.RTThread},
		"driver":         "drivers/drv_gpio.c",
		"target":         run.Plan.Target,
		"capability":     run.Plan.RequestedCapability,
		"backend":        map[bool]string{true: "virtual_gpio_external_input", false: "virtual_gpio"}[run.Plan.RequestedCapability == "gpio_input_readback"],
		"plan_verdict":   run.Verdict,
		"cases":          cases,
		"grounding_note": "injected_fault is a controlled SIL condition, not a claim about a real hardware root cause",
	}
}

func aiDiagnosisPrompts(run aiRunSnapshot) (string, string) {
	payload, _ := json.MarshalIndent(diagnosisPayload(run), "", "  ")
	systemPrompt := `You are an evidence-grounded embedded software-in-the-loop test diagnostician. Analyze only the execution evidence supplied by the host. The injected_fault field is a controlled SIL stimulus, not proof of a real physical defect. Never invent DMA, ADC, interrupts, timing, register writes, or other mechanisms not present in the evidence. Preserve the deterministic rule-engine verdict; do not re-grade PASS/FAIL. Explain observed behavior, cite concrete evidence, identify the software/hardware boundary implicated by the evidence, list plausible real-world analogs as possibilities only, and recommend focused checks. Return JSON only with exactly: summary, evidence, suspected_layer, possible_causes, recommended_checks. Keep the response concise and use the user's language where practical.`
	userPrompt := fmt.Sprintf("Execution evidence:\n%s\n\nReturn a grounded diagnosis JSON only.", string(payload))
	return systemPrompt, userPrompt
}

func requestGPTDiagnosis(p aiProviderConfig, model, key, systemPrompt, userPrompt string) (aiDiagnosis, error) {
	body := map[string]any{
		"model": model,
		"input": []map[string]any{{"role": "system", "content": systemPrompt}, {"role": "user", "content": userPrompt}},
		"text":  map[string]any{"format": map[string]any{"type": "json_schema", "name": "gpio_sil_diagnosis", "strict": true, "schema": aiDiagnosisSchema()}},
	}
	raw, status, err := httpPostJSON(p.Endpoint, key, body)
	if err != nil {
		return aiDiagnosis{}, fmt.Errorf("%s network error: %w", p.Label, err)
	}
	if status < 200 || status >= 300 {
		return aiDiagnosis{}, apiHTTPError(p.Label, status, raw)
	}
	var out struct {
		Status string `json:"status"`
		Error  *struct {
			Message string `json:"message"`
		} `json:"error"`
		Output []struct {
			Content []struct {
				Type    string `json:"type"`
				Text    string `json:"text"`
				Refusal string `json:"refusal"`
			} `json:"content"`
		} `json:"output"`
	}
	if err := json.Unmarshal(raw, &out); err != nil {
		return aiDiagnosis{}, fmt.Errorf("%s returned invalid response JSON: %w", p.Label, err)
	}
	if out.Error != nil && out.Error.Message != "" {
		return aiDiagnosis{}, fmt.Errorf("%s API: %s", p.Label, out.Error.Message)
	}
	textOut := ""
	for _, item := range out.Output {
		for _, c := range item.Content {
			if c.Type == "output_text" {
				textOut += c.Text
			}
			if c.Type == "refusal" && c.Refusal != "" {
				return aiDiagnosis{}, fmt.Errorf("%s model refusal: %s", p.Label, c.Refusal)
			}
		}
	}
	if strings.TrimSpace(textOut) == "" {
		return aiDiagnosis{}, fmt.Errorf("%s returned no diagnosis output_text (status=%s)", p.Label, out.Status)
	}
	return parseDiagnosisJSON(textOut)
}

func requestChatDiagnosis(p aiProviderConfig, model, key, systemPrompt, userPrompt string) (aiDiagnosis, error) {
	body := map[string]any{
		"model":      model,
		"messages":   []map[string]any{{"role": "system", "content": systemPrompt}, {"role": "user", "content": userPrompt}},
		"stream":     false,
		"max_tokens": 2048,
	}
	if p.ID == "deepseek" {
		body["response_format"] = map[string]any{"type": "json_object"}
		body["thinking"] = map[string]any{"type": "disabled"}
	} else if p.ID == "glm" {
		body["temperature"] = 0.1
	}
	raw, status, err := httpPostJSON(p.Endpoint, key, body)
	if err != nil {
		return aiDiagnosis{}, fmt.Errorf("%s network error: %w", p.Label, err)
	}
	if status < 200 || status >= 300 {
		return aiDiagnosis{}, apiHTTPError(p.Label, status, raw)
	}
	var out struct {
		Choices []struct {
			Message struct {
				Content any `json:"content"`
			} `json:"message"`
		} `json:"choices"`
		Error *struct {
			Message string `json:"message"`
		} `json:"error"`
	}
	if err := json.Unmarshal(raw, &out); err != nil {
		return aiDiagnosis{}, fmt.Errorf("%s returned invalid response JSON: %w", p.Label, err)
	}
	if out.Error != nil && out.Error.Message != "" {
		return aiDiagnosis{}, fmt.Errorf("%s API: %s", p.Label, out.Error.Message)
	}
	if len(out.Choices) == 0 {
		return aiDiagnosis{}, fmt.Errorf("%s returned no choices", p.Label)
	}
	var textOut string
	switch v := out.Choices[0].Message.Content.(type) {
	case string:
		textOut = v
	case nil:
		textOut = ""
	default:
		b, _ := json.Marshal(v)
		textOut = string(b)
	}
	if strings.TrimSpace(textOut) == "" {
		return aiDiagnosis{}, fmt.Errorf("%s returned empty diagnosis content", p.Label)
	}
	return parseDiagnosisJSON(textOut)
}

func requestAIDiagnosis(run aiRunSnapshot) (aiDiagnosis, string, string, error) {
	p := selectedAIProvider()
	p.Endpoint = currentAIEndpoint(p)
	key := providerAPIKey(p)
	if key == "" {
		return aiDiagnosis{}, p.Label, "", fmt.Errorf("%s API key is empty. Configure it under 设置 → AI 服务 or set %s", p.Label, strings.Join(p.EnvKeys, " / "))
	}
	model := currentRoleModel("diagnosis", p)
	systemPrompt, userPrompt := aiDiagnosisPrompts(run)
	var d aiDiagnosis
	var err error
	switch p.APIStyle {
	case "responses_schema":
		d, err = requestGPTDiagnosis(p, model, key, systemPrompt, userPrompt)
	case "chat_json", "chat_prompt_json":
		d, err = requestChatDiagnosis(p, model, key, systemPrompt, userPrompt)
	default:
		err = fmt.Errorf("unsupported AI provider adapter: %s", p.ID)
	}
	return d, p.Label, model, err
}

func renderDiagnosis(d aiDiagnosis, provider, model string, run aiRunSnapshot) string {
	var b strings.Builder
	b.WriteString("AI DIAGNOSIS\r\n")
	b.WriteString("========================================\r\n")
	b.WriteString("Provider : " + provider + "\r\n")
	b.WriteString("Model    : " + model + "\r\n")
	b.WriteString("Target   : " + run.Plan.Target + "\r\n")
	b.WriteString("Verdict  : " + run.Verdict + " (rule engine)\r\n\r\n")
	b.WriteString("Summary\r\n" + d.Summary + "\r\n\r\n")
	b.WriteString("Evidence\r\n")
	for _, v := range d.Evidence {
		b.WriteString("- " + v + "\r\n")
	}
	b.WriteString("\r\nSuspected layer\r\n- " + d.SuspectedLayer + "\r\n")
	b.WriteString("\r\nPossible real-world causes\r\n")
	if len(d.PossibleCauses) == 0 {
		b.WriteString("- None asserted from current evidence\r\n")
	} else {
		for _, v := range d.PossibleCauses {
			b.WriteString("- " + v + "\r\n")
		}
	}
	b.WriteString("\r\nRecommended checks\r\n")
	for _, v := range d.RecommendedChecks {
		b.WriteString("- " + v + "\r\n")
	}
	b.WriteString("\r\nNote: PASS/FAIL remains deterministic. AI explains evidence; it does not override the rule engine.")
	return b.String()
}

func diagnoseLastRun() {
	lastRunMu.Lock()
	run := lastRun
	lastRunMu.Unlock()
	if len(run.Rows) == 0 {
		message("No execution evidence", "Run an AI TestPlan first. Diagnosis is generated only from completed execution evidence.", MB_OK|MB_ICONINFORMATION)
		return
	}
	setBusy(true)
	uiText(lblRunState, "State    AI diagnosing evidence...")
	logLine("AI", "Requesting evidence-grounded diagnosis (rule verdict will not be changed).")
	go func() {
		defer setBusy(false)
		d, provider, model, err := requestAIDiagnosis(run)
		if err != nil {
			uiText(lblRunState, "State    AI diagnosis failed")
			uiMessage("AI Diagnosis failed", err.Error(), MB_OK|MB_ICONERROR)
			logLine("AI", "Diagnosis failed: "+err.Error())
			return
		}
		lastRunMu.Lock()
		lastDiagnosis = d
		lastDiagnosisProvider = provider
		lastDiagnosisModel = model
		lastRunMu.Unlock()
		uiText(edtResult, renderDiagnosis(d, provider, model, run))
		uiText(lblRunState, "State    AI diagnosis ready")
		logLine("AI", fmt.Sprintf("Grounded diagnosis ready: provider=%s model=%s", provider, model))
	}()
}

func htmlReportTemplate() string {
	return `<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>AI SIL Test Report</title>
<style>
body{font-family:Segoe UI,Arial,sans-serif;margin:0;background:#f4f6f8;color:#1f2937}.wrap{max-width:1100px;margin:32px auto;padding:0 20px}.card{background:#fff;border:1px solid #d9dee5;border-radius:10px;padding:22px;margin:16px 0;box-shadow:0 1px 3px rgba(0,0,0,.04)}h1{margin:0 0 6px}h2{margin-top:0;font-size:20px}.meta{color:#596579}.pass{color:#087f23;font-weight:700}.fail{color:#b42318;font-weight:700}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:9px 10px;border-bottom:1px solid #e5e7eb}th{background:#f8fafc}code,pre{font-family:Consolas,monospace}pre{white-space:pre-wrap;background:#0f172a;color:#e2e8f0;padding:14px;border-radius:8px;overflow:auto}.note{background:#f8fafc;border-left:4px solid #64748b;padding:10px 12px}.small{font-size:13px;color:#667085}ul{margin-top:6px}
</style></head><body><div class="wrap">
<div class="card"><h1>AI SIL Test Report</h1><div class="meta">Generated {{.GeneratedAt}}</div><p><strong>Requirement:</strong> {{.Run.Requirement}}</p><p><strong>Project:</strong> {{.Run.Project.ProjectName}} &nbsp; <strong>MCU:</strong> {{.Run.Project.MCU}} &nbsp; <strong>RT-Thread:</strong> {{.Run.Project.RTThread}}</p><p><strong>Driver:</strong> drivers/drv_gpio.c &nbsp; <strong>Capability:</strong> {{.Run.Plan.RequestedCapability}} &nbsp; <strong>Target:</strong> {{.Run.Plan.Target}} &nbsp; <strong>Backend:</strong> {{if eq .Run.Plan.RequestedCapability "gpio_input_readback"}}virtual_gpio_external_input{{else}}virtual_gpio{{end}}</p><p><strong>Plan:</strong> {{.Run.Provider}} / {{.Run.Model}} &nbsp; <strong>Verdict:</strong> <span class="{{if eq .Run.Verdict "PASS"}}pass{{else}}fail{{end}}">{{.Run.Verdict}}</span></p></div>
<div class="card"><h2>Execution matrix</h2><table><thead><tr><th>Case</th><th>Fault</th><th>HIGH</th><th>LOW</th><th>Observed</th><th>Expected</th><th>Detection</th></tr></thead><tbody>{{range .Rows}}<tr><td>{{.Case.ID}}</td><td>{{.Case.Fault}}</td>{{if .ProtocolError}}<td>--</td><td>--</td><td>PROTOCOL</td><td>{{.Case.Expected}}</td><td class="fail">{{.ProtocolError}}</td>{{else if .Timeout}}<td>--</td><td>--</td><td>TIMEOUT</td><td>{{.Case.Expected}}</td><td class="fail">MISSING</td>{{else}}<td>{{.Result.High}}</td><td>{{.Result.Low}}</td><td>{{.Result.Verdict}}</td><td>{{.Case.Expected}}</td><td>{{if eq .Result.Verdict .Case.Expected}}OK{{else}}MISMATCH{{end}}</td>{{end}}</tr>{{end}}</tbody></table><p class="note">Injected-fault cases intentionally produce functional FAIL. The plan passes when the expected faults are detected.</p></div>
<div class="card"><h2>AI diagnosis</h2>{{if .HasDiagnosis}}<p><strong>Provider:</strong> {{.DiagnosisProvider}} / {{.DiagnosisModel}}</p><p>{{.Diagnosis.Summary}}</p><h3>Evidence</h3><ul>{{range .Diagnosis.Evidence}}<li>{{.}}</li>{{end}}</ul><h3>Suspected layer</h3><p>{{.Diagnosis.SuspectedLayer}}</p><h3>Possible real-world causes</h3>{{if .Diagnosis.PossibleCauses}}<ul>{{range .Diagnosis.PossibleCauses}}<li>{{.}}</li>{{end}}</ul>{{else}}<p>None asserted from current evidence.</p>{{end}}<h3>Recommended checks</h3><ul>{{range .Diagnosis.RecommendedChecks}}<li>{{.}}</li>{{end}}</ul>{{else}}<p>No AI diagnosis generated yet. Rule-engine results are still authoritative.</p>{{end}}<p class="small">AI diagnosis is explanatory only and does not override deterministic PASS/FAIL.</p></div>
<div class="card"><h2>Build / firmware</h2><p><strong>Firmware:</strong> {{.Run.Firmware}}</p><p><strong>Build status:</strong> {{.BuildStatus}}</p></div>
<div class="card"><h2>Structured TestPlan</h2><pre>{{.PlanJSON}}</pre></div>
<div class="card"><h2>Artifacts</h2><p>testplan.json · execution.json · diagnosis.json (if generated) · build.log · uart.log · agent.log</p></div>
</div></body></html>`
}

func buildStatusFromLog(log string) string {
	if strings.Contains(log, "Build Failed") || strings.Contains(log, "terminated with exit code") {
		return "FAIL"
	}
	if strings.Contains(log, "Build Finished. 0 errors") || strings.Contains(log, "SUCCESS ->") {
		return "PASS"
	}
	return "Unknown / not captured in this session"
}

func exportHTMLReport() {
	lastRunMu.Lock()
	run := lastRun
	d := lastDiagnosis
	dProvider := lastDiagnosisProvider
	dModel := lastDiagnosisModel
	lastRunMu.Unlock()
	if len(run.Rows) == 0 {
		message("No execution evidence", "Run an AI TestPlan first, then export the report.", MB_OK|MB_ICONINFORMATION)
		return
	}
	buildLog := getText(edtBuildConsole)
	uartLog := getText(edtUartConsole)
	agentLog := getText(edtAgentConsole)
	root := run.Project.Root
	if strings.TrimSpace(root) == "" {
		root = appDir()
	}
	stamp := time.Now().Format("20060102_150405")
	pinSafe := strings.NewReplacer(".", "", "/", "_", "\\", "_").Replace(run.Plan.Target)
	dir := filepath.Join(root, "ai_sil_reports", stamp+"_GPIO_"+pinSafe)
	if err := os.MkdirAll(dir, 0755); err != nil {
		message("Export failed", err.Error(), MB_OK|MB_ICONERROR)
		return
	}
	planJSON, _ := json.MarshalIndent(run.Plan, "", "  ")
	execJSON, _ := json.MarshalIndent(run, "", "  ")
	_ = os.WriteFile(filepath.Join(dir, "testplan.json"), planJSON, 0644)
	_ = os.WriteFile(filepath.Join(dir, "execution.json"), execJSON, 0644)
	_ = os.WriteFile(filepath.Join(dir, "build.log"), []byte(buildLog), 0644)
	_ = os.WriteFile(filepath.Join(dir, "uart.log"), []byte(uartLog), 0644)
	_ = os.WriteFile(filepath.Join(dir, "agent.log"), []byte(agentLog), 0644)
	hasDiagnosis := strings.TrimSpace(d.Summary) != ""
	if hasDiagnosis {
		dj, _ := json.MarshalIndent(d, "", "  ")
		_ = os.WriteFile(filepath.Join(dir, "diagnosis.json"), dj, 0644)
	}
	data := struct {
		GeneratedAt       string
		Run               aiRunSnapshot
		Rows              []aiPlanRunRow
		Diagnosis         aiDiagnosis
		HasDiagnosis      bool
		DiagnosisProvider string
		DiagnosisModel    string
		BuildStatus       string
		PlanJSON          string
	}{
		GeneratedAt: time.Now().Format("2006-01-02 15:04:05"), Run: run, Rows: run.Rows,
		Diagnosis: d, HasDiagnosis: hasDiagnosis, DiagnosisProvider: dProvider, DiagnosisModel: dModel,
		BuildStatus: buildStatusFromLog(buildLog), PlanJSON: string(planJSON),
	}
	var buf bytes.Buffer
	t, err := template.New("report").Parse(htmlReportTemplate())
	if err != nil {
		message("Export failed", err.Error(), MB_OK|MB_ICONERROR)
		return
	}
	if err := t.Execute(&buf, data); err != nil {
		message("Export failed", err.Error(), MB_OK|MB_ICONERROR)
		return
	}
	reportPath := filepath.Join(dir, "report.html")
	if err := os.WriteFile(reportPath, buf.Bytes(), 0644); err != nil {
		message("Export failed", err.Error(), MB_OK|MB_ICONERROR)
		return
	}
	setText(lblRunState, "State    Report exported")
	logLine("REPORT", "Exported: "+reportPath)
	message("Report exported", "HTML report and raw evidence were written to:\r\n\r\n"+dir, MB_OK|MB_ICONINFORMATION)
}

func quickDrop() {
	currentCaseMu.Lock()
	currentCase.Fault = "stuck_low"
	tc := currentCase
	currentCaseMu.Unlock()
	setText(edtTestcase, renderCase(tc))
	setText(lblRunState, "State    Fault injected: GPIO stuck LOW")
	logLine("PLAN", "gpio_fault = stuck_low")
}

func appDir() string {
	p, e := os.Executable()
	if e != nil {
		return ""
	}
	return filepath.Dir(p)
}
func resolveExe(p string) string {
	p = strings.TrimSpace(strings.Trim(p, `"`))
	if p == "" || filepath.IsAbs(p) {
		return p
	}
	c := filepath.Join(appDir(), p)
	if _, e := os.Stat(c); e == nil {
		if a, e2 := filepath.Abs(c); e2 == nil {
			return a
		}
		return c
	}
	if strings.ContainsAny(p, `\\/`) {
		if a, e := filepath.Abs(p); e == nil {
			return a
		}
	}
	return p
}
func resolveData(p string) string {
	p = strings.TrimSpace(strings.Trim(p, `"`))
	if p == "" || filepath.IsAbs(p) {
		return p
	}
	c := filepath.Join(appDir(), p)
	if _, e := os.Stat(c); e == nil {
		if a, e2 := filepath.Abs(c); e2 == nil {
			return a
		}
		return c
	}
	if a, e := filepath.Abs(p); e == nil {
		return a
	}
	return p
}

func reserveLocalTCPPort() (int, error) {
	ln, err := net.Listen("tcp4", "127.0.0.1:0")
	if err != nil {
		return 0, err
	}
	defer ln.Close()
	return ln.Addr().(*net.TCPAddr).Port, nil
}

func connectSerialTCP(port int, timeout time.Duration) (net.Conn, error) {
	deadline := time.Now().Add(timeout)
	addr := fmt.Sprintf("127.0.0.1:%d", port)
	var last error
	for time.Now().Before(deadline) {
		c, err := net.DialTimeout("tcp4", addr, 250*time.Millisecond)
		if err == nil {
			return c, nil
		}
		last = err
		time.Sleep(60 * time.Millisecond)
	}
	if last == nil {
		last = fmt.Errorf("serial TCP timeout")
	}
	return nil, last
}

func (s *qemuSession) start(cfg qemuConfig) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.running.Load() {
		return fmt.Errorf("QEMU is already running")
	}
	exe := resolveExe(cfg.Exe)
	fw := resolveData(cfg.Firmware)
	if exe == "" {
		return fmt.Errorf("QEMU executable is empty")
	}
	base := strings.ToLower(filepath.Base(exe))
	isMock := strings.Contains(base, "mock_qemu")
	if !isMock && fw == "" {
		return fmt.Errorf("firmware path is empty")
	}

	if isMock {
		cmd := exec.Command(exe)
		cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true}
		stdin, err := cmd.StdinPipe()
		if err != nil {
			return err
		}
		stdout, err := cmd.StdoutPipe()
		if err != nil {
			return err
		}
		stderr, err := cmd.StderrPipe()
		if err != nil {
			return err
		}
		if err = cmd.Start(); err != nil {
			return err
		}
		s.cmd, s.stdin = cmd, stdin
		s.isMock = true
		s.running.Store(true)
		s.ready.Store(false)
		s.silReady.Store(false)
		s.partial = ""
		logLine("QEMU", "Started mock console")
		uiText(lblQemuState, "QEMU     ● Running")
		uiText(lblRTState, "RT-Thread  ○ Waiting")
		go s.read(stdout, true)
		go s.read(stderr, false)
		go s.waitProcess(cmd)
		return nil
	}

	// Do not use QEMU's multiplexed -nographic stdio as the RT-Thread console.
	// Give UART0 its own raw TCP character device and disable display/monitor
	// separately, so UART bytes never share stdin/stdout with QEMU itself.
	port, err := reserveLocalTCPPort()
	if err != nil {
		return fmt.Errorf("reserve serial TCP port: %w", err)
	}
	serialSpec := fmt.Sprintf("tcp:127.0.0.1:%d,server", port)
	args := []string{"-M", "stm32f407-atk-explorer", "-display", "none", "-monitor", "none", "-serial", serialSpec, "-kernel", fw}
	cmd := exec.Command(exe, args...)
	cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true}
	stdout, err := cmd.StdoutPipe()
	if err != nil {
		return err
	}
	stderr, err := cmd.StderrPipe()
	if err != nil {
		return err
	}
	if err = cmd.Start(); err != nil {
		return err
	}

	conn, err := connectSerialTCP(port, 6*time.Second)
	if err != nil {
		_ = cmd.Process.Kill()
		return fmt.Errorf("QEMU started but the dedicated serial channel did not open: %w", err)
	}
	s.cmd = cmd
	s.stdin = conn
	s.isMock = false
	s.running.Store(true)
	s.ready.Store(false)
	s.silReady.Store(false)
	s.partial = ""
	logLine("QEMU", fmt.Sprintf("Started %s with dedicated UART TCP channel 127.0.0.1:%d", filepath.Base(exe), port))
	uiText(lblQemuState, "QEMU     ● Running")
	uiText(lblRTState, "RT-Thread  ○ Waiting")
	go s.read(conn, true)
	go s.read(stdout, false)
	go s.read(stderr, false)
	go s.waitProcess(cmd)
	return nil
}

func (s *qemuSession) waitProcess(cmd *exec.Cmd) {
	e := cmd.Wait()
	s.running.Store(false)
	s.ready.Store(false)
	s.silReady.Store(false)
	logLine("QEMU", fmt.Sprintf("Exited: %v", e))
	uiText(lblQemuState, "QEMU     ○ Stopped")
	uiText(lblRTState, "RT-Thread  ○ Waiting")
	uiText(lblSILState, "SIL Runtime  ○ Waiting")
}

func (s *qemuSession) stop() {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.stdin != nil {
		_ = s.stdin.Close()
		s.stdin = nil
	}
	s.isMock = false
	if s.cmd != nil && s.cmd.Process != nil && s.running.Load() {
		_ = s.cmd.Process.Kill()
	}
}

func (s *qemuSession) writeCommandLocked(line string, pace time.Duration) error {
	if s.stdin == nil {
		return fmt.Errorf("serial channel is not open")
	}
	payload := []byte(line + "\r")
	if s.isMock || pace <= 0 {
		_, err := s.stdin.Write(payload)
		return err
	}
	// The STM32 UART model can lose characters when a whole command is injected
	// into the TCP chardev in one burst. Pace each byte so the guest UART/FinSH
	// receive path has time to consume it. Commands are short ASCII MSH lines,
	// so a few milliseconds per byte is negligible compared with a SIL case.
	for _, b := range payload {
		if _, err := s.stdin.Write([]byte{b}); err != nil {
			return err
		}
		if pace > 0 {
			time.Sleep(pace)
		}
	}
	return nil
}

func (s *qemuSession) sendWithPace(line string, pace time.Duration) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if !s.running.Load() || s.stdin == nil {
		return fmt.Errorf("QEMU is not running")
	}
	line = strings.TrimSpace(line)
	if line == "" {
		return nil
	}
	logLine("AGENT", "> "+line)
	return s.writeCommandLocked(line, pace)
}

func (s *qemuSession) send(line string) error {
	// Mock_QEMU is a normal pipe and does not need throttling. Real QEMU uses a
	// raw TCP-backed UART and gets a conservative 2 ms/byte pacing by default.
	s.mu.Lock()
	isMock := s.isMock
	s.mu.Unlock()
	if isMock {
		return s.sendWithPace(line, 0)
	}
	return s.sendWithPace(line, 2*time.Millisecond)
}
func (s *qemuSession) read(r io.Reader, parse bool) {
	b := make([]byte, 1024)
	for {
		n, e := r.Read(b)
		if n > 0 {
			t := string(b[:n])
			if parse {
				uiAppendUart(t)
				s.feed(t)
			} else {
				uiAppendAgent(t)
			}
		}
		if e != nil {
			return
		}
	}
}
func emitCommandEcho(command string) {
	command = strings.TrimSpace(command)
	if command == "" {
		return
	}
	select {
	case commandEchoCh <- command:
	default:
		logLine("UART", "command echo queue full; dropped: "+command)
	}
}

func extractMSHCommandEcho(line string) (string, bool) {
	for _, marker := range []string{"msh />", "msh >"} {
		if idx := strings.LastIndex(line, marker); idx >= 0 {
			tail := strings.TrimSpace(line[idx+len(marker):])
			if tail == "" || strings.HasPrefix(tail, "@SIL,") {
				return "", false
			}
			if proto := strings.Index(tail, "@SIL,"); proto >= 0 {
				tail = strings.TrimSpace(tail[:proto])
			}
			if tail != "" {
				return tail, true
			}
		}
	}
	return "", false
}

func (s *qemuSession) feed(chunk string) {
	s.partialMu.Lock()
	defer s.partialMu.Unlock()
	combined := s.partial + chunk
	// RT-Thread console builds vary between CRLF, LF and occasional CR-only
	// output. Normalize them before parsing command echoes and @SIL frames.
	combined = strings.ReplaceAll(combined, "\r\n", "\n")
	combined = strings.ReplaceAll(combined, "\r", "\n")
	if strings.Contains(combined, "msh />") || strings.Contains(combined, "msh >") {
		if !s.ready.Load() {
			s.ready.Store(true)
			uiAppendUart("\r\n")
			logLine("AGENT", "RT-Thread MSH detected; console input is ready")
			uiText(lblRTState, "RT-Thread  ● Ready")
			uiText(lblRunState, "State    MSH ready - type a command below or click AI Run")
		}
	}
	parts := strings.Split(combined, "\n")
	if len(parts) == 1 {
		s.partial = combined
		return
	}
	s.partial = parts[len(parts)-1]
	for _, raw := range parts[:len(parts)-1] {
		line := strings.TrimSpace(raw)
		if echo, ok := extractMSHCommandEcho(line); ok {
			emitCommandEcho(echo)
			logLine("UART", "echo "+echo)
		}
		// RT-Thread/MSH and the mock console can leave the prompt on the same
		// physical line as the protocol frame (for example "msh >@SIL,...").
		// Parse from the protocol marker instead of requiring it at column zero.
		if idx := strings.Index(line, "@SIL,"); idx >= 0 {
			handleSIL(line[idx:])
		}
	}
}
func emitSILProtocolEvent(ev silProtocolEvent) {
	select {
	case silProtocolEventCh <- ev:
	default:
		logLine("PROTO", "protocol event queue full; dropped: "+ev.Raw)
	}
}

func handleSIL(line string) {
	f := strings.Split(line, ",")
	if len(f) < 2 {
		return
	}
	if f[1] == "AI_SMOKE" && len(f) >= 4 {
		emitSILProtocolEvent(silProtocolEvent{Type: "AI_SMOKE", Kind: f[2], Value: strings.ToUpper(strings.TrimSpace(f[3])), Raw: line})
		logLine("PROTO", "AI_SMOKE "+line)
		return
	}
	if f[1] == "GEN_RESULT" && len(f) >= 6 {
		emitSILProtocolEvent(silProtocolEvent{Type: "GEN_RESULT", Kind: f[2], Pin: f[3], Fault: f[4], Value: strings.ToUpper(strings.TrimSpace(f[5])), Raw: line})
		logLine("PROTO", "GEN_RESULT "+line)
		return
	}
	if f[1] == "RESET" && len(f) >= 4 {
		emitSILProtocolEvent(silProtocolEvent{Type: "RESET", Kind: f[2], Value: f[3], Raw: line})
		logLine("PROTO", "ACK "+line)
		return
	}
	if f[1] == "FAULT" && len(f) >= 4 {
		emitSILProtocolEvent(silProtocolEvent{Type: "FAULT", Kind: f[2], Fault: f[3], Value: f[3], Raw: line})
		logLine("PROTO", "ACK "+line)
		return
	}
	if f[1] == "CASE" && len(f) >= 3 {
		ev := silProtocolEvent{Type: "CASE", Value: f[2], Raw: line}
		if strings.HasPrefix(f[2], "GPIO_INPUT") {
			ev.Kind = "GPIO_INPUT"
		} else if strings.HasPrefix(f[2], "GPIO") {
			ev.Kind = "GPIO"
		}
		for _, field := range f[3:] {
			if strings.HasPrefix(field, "pin=") {
				ev.Pin = strings.TrimPrefix(field, "pin=")
			}
			if strings.HasPrefix(field, "fault=") {
				ev.Fault = strings.TrimPrefix(field, "fault=")
			}
		}
		emitSILProtocolEvent(ev)
		logLine("PROTO", "CASE "+line)
		return
	}
	if f[1] == "RUNTIME" && len(f) >= 4 && f[2] == "READY" {
		session.silReady.Store(true)
		uiText(lblSILState, "SIL Runtime  ● Ready")
		logLine("SIL", "Runtime ready: "+strings.Join(f[3:], ","))
		return
	}
	if f[1] == "PONG" {
		session.silReady.Store(true)
		uiText(lblSILState, "SIL Runtime  ● Ready")
		logLine("SIL", "Handshake OK: "+strings.Join(f[2:], ","))
		return
	}
	if f[1] == "RESULT" && len(f) >= 11 && (f[2] == "GPIO" || f[2] == "GPIO_INPUT") {
		kind := f[2]
		pin := f[3]
		high, _ := strconv.Atoi(f[4])
		low, _ := strconv.Atoi(f[5])
		modeCalls, _ := strconv.Atoi(f[6])
		writeCalls, _ := strconv.Atoi(f[7])
		readCalls, _ := strconv.Atoi(f[8])
		halMode, pull := -1, -1
		faultIndex, errorIndex := 9, 10
		if len(f) >= 13 {
			halMode, _ = strconv.Atoi(f[9])
			pull, _ = strconv.Atoi(f[10])
			faultIndex, errorIndex = 11, 12
		}
		fault := f[faultIndex]
		errs, _ := strconv.Atoi(f[errorIndex])

		failed := []string{}
		if kind == "GPIO_INPUT" {
			if high != 1 {
				failed = append(failed, "INPUT_HIGH_READBACK")
			}
			if low != 0 {
				failed = append(failed, "INPUT_LOW_READBACK")
			}
			if modeCalls < 1 {
				failed = append(failed, "DRV_GPIO_MODE_PATH")
			}
			if readCalls < 2 {
				failed = append(failed, "DRV_GPIO_READ_PATH")
			}
		} else {
			if high != 1 {
				failed = append(failed, "WRITE_HIGH_READBACK")
			}
			if low != 0 {
				failed = append(failed, "WRITE_LOW_READBACK")
			}
			if modeCalls < 1 {
				failed = append(failed, "DRV_GPIO_MODE_PATH")
			}
			if writeCalls < 2 {
				failed = append(failed, "DRV_GPIO_WRITE_PATH")
			}
			if readCalls < 2 {
				failed = append(failed, "DRV_GPIO_READ_PATH")
			}
		}
		if errs != 0 && len(failed) == 0 {
			failed = append(failed, "GPIO_SIL_ERROR")
		}
		verdict := "PASS"
		if len(failed) > 0 || errs != 0 {
			verdict = "FAIL"
		}
		result := gpioResult{Kind: kind, Pin: pin, Fault: fault, High: high, Low: low, ModeCalls: modeCalls, WriteCalls: writeCalls, ReadCalls: readCalls, HALMode: halMode, Pull: pull, Errors: errs, Verdict: verdict, Failed: append([]string(nil), failed...)}
		select {
		case matrixResultCh <- result:
		default:
		}

		failedText := "None"
		if len(failed) > 0 {
			failedText = strings.Join(failed, " / ")
		}
		modeDetail := "(legacy runtime)"
		if halMode >= 0 {
			modeDetail = fmt.Sprintf("HAL mode=%d, pull=%d", halMode, pull)
		}
		var out, diag string
		if kind == "GPIO_INPUT" {
			diag = "External input HIGH/LOW stimuli matched and RT-Thread PIN reads traversed drivers/drv_gpio.c."
			if fault == "stuck_low" {
				diag = "Virtual input is forced LOW. The external HIGH stimulus cannot be observed; this is the expected stuck-low signature."
			}
			if fault == "stuck_high" {
				diag = "Virtual input is forced HIGH. The external LOW stimulus cannot be observed; this is the expected stuck-high signature."
			}
			out = fmt.Sprintf("VERDICT  %s\r\n\r\nCapability    gpio_input_readback\r\nDriver        drivers/drv_gpio.c\r\nPin           %s\r\nBackend       virtual_gpio_external_input\r\nFault         %s\r\n\r\nExternal HIGH / Read  %d\r\nExternal LOW  / Read  %d\r\nMode mapping  %s\r\n\r\nDriver calls\r\nMode          %d\r\nWrite         %d\r\nRead          %d\r\nErrors        %d\r\n\r\nFailed rules\r\n%s\r\n\r\nDiagnosis (local)\r\n%s", verdict, pin, fault, high, low, modeDetail, modeCalls, writeCalls, readCalls, errs, failedText, diag)
		} else {
			diag = "GPIO write/readback matched and the RT-Thread PIN calls traversed drivers/drv_gpio.c."
			if fault == "stuck_low" {
				diag = "Virtual GPIO is forced LOW. A HIGH write cannot be observed on readback; this is the expected stuck-low fault signature."
			}
			if fault == "stuck_high" {
				diag = "Virtual GPIO is forced HIGH. A LOW write cannot be observed on readback; this is the expected stuck-high fault signature."
			}
			out = fmt.Sprintf("VERDICT  %s\r\n\r\nCapability    gpio_output_readback\r\nDriver        drivers/drv_gpio.c\r\nPin           %s\r\nBackend       virtual_gpio\r\nFault         %s\r\n\r\nWrite HIGH / Read  %d\r\nWrite LOW  / Read  %d\r\nMode mapping  %s\r\n\r\nDriver calls\r\nMode          %d\r\nWrite         %d\r\nRead          %d\r\nErrors        %d\r\n\r\nFailed rules\r\n%s\r\n\r\nDiagnosis (local)\r\n%s", verdict, pin, fault, high, low, modeDetail, modeCalls, writeCalls, readCalls, errs, failedText, diag)
		}
		if !matrixRunning.Load() {
			uiText(edtResult, out)
			uiText(lblRunState, "State    Finished: "+verdict)
		}
		logLine("RULE", verdict+" "+kind+" "+pin+" fault="+fault)
	}
}

func waitReady(d time.Duration) bool {
	end := time.Now().Add(d)
	for time.Now().Before(end) {
		if session.ready.Load() {
			return true
		}
		if !session.running.Load() {
			return false
		}
		time.Sleep(80 * time.Millisecond)
	}
	return false
}
func captureConfig() qemuConfig {
	return qemuConfig{Exe: getText(edtQemu), Firmware: getText(edtFirmware)}
}

func isMockExe(p string) bool {
	return strings.Contains(strings.ToLower(filepath.Base(strings.TrimSpace(strings.Trim(p, `"`)))), "mock_qemu")
}

func preflightTarget() {
	cfg := captureConfig()
	setBusy(true)
	uiText(lblRunState, "State    Preflight...")
	go func() {
		defer setBusy(false)
		exe := resolveExe(cfg.Exe)
		fw := resolveData(cfg.Firmware)
		if exe == "" {
			uiText(lblRunState, "State    Preflight failed")
			uiMessage("Preflight failed", "QEMU executable is empty.", MB_OK|MB_ICONERROR)
			return
		}
		if _, err := os.Stat(exe); err != nil {
			if _, lookErr := exec.LookPath(exe); lookErr != nil {
				uiText(lblRunState, "State    Preflight failed")
				uiMessage("Preflight failed", "QEMU executable was not found:\r\n"+exe, MB_OK|MB_ICONERROR)
				return
			}
		}
		if isMockExe(exe) {
			logLine("CHECK", "Mock QEMU selected; executable check passed.")
			uiText(lblRunState, "State    Preflight OK (mock)")
			return
		}
		if fw == "" {
			uiText(lblRunState, "State    Preflight failed")
			uiMessage("Preflight failed", "Firmware path is empty.", MB_OK|MB_ICONERROR)
			return
		}
		if st, err := os.Stat(fw); err != nil || st.IsDir() {
			uiText(lblRunState, "State    Preflight failed")
			uiMessage("Preflight failed", "RT-Thread firmware was not found:\r\n"+fw, MB_OK|MB_ICONERROR)
			return
		}
		cmd := exec.Command(exe, "-M", "help")
		cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true}
		out, err := cmd.CombinedOutput()
		if err != nil && len(out) == 0 {
			uiText(lblRunState, "State    Preflight failed")
			uiMessage("Preflight failed", "Unable to query QEMU machines:\r\n"+err.Error(), MB_OK|MB_ICONERROR)
			return
		}
		text := string(out)
		if !strings.Contains(text, "stm32f407-atk-explorer") {
			logLine("CHECK", "Warning: stm32f407-atk-explorer was not listed by QEMU -M help.")
			uiText(lblRunState, "State    QEMU found; machine not confirmed")
			uiMessage("Preflight warning", "QEMU and firmware were found, but 'stm32f407-atk-explorer' was not listed by -M help.\r\n\r\nThis may mean you selected a different QEMU build than the one bundled with RT-Thread Studio.", MB_OK|MB_ICONINFORMATION)
			return
		}
		logLine("CHECK", "QEMU executable OK")
		logLine("CHECK", "Machine stm32f407-atk-explorer supported")
		logLine("CHECK", "Firmware found: "+fw)
		uiText(lblRunState, "State    Preflight OK")
	}()
}

func waitSILReady(d time.Duration) bool {
	end := time.Now().Add(d)
	for time.Now().Before(end) {
		if session.silReady.Load() {
			return true
		}
		if !session.running.Load() {
			return false
		}
		time.Sleep(80 * time.Millisecond)
	}
	return false
}

func verifySILRuntime() {
	cfg := captureConfig()
	setBusy(true)
	uiText(lblRunState, "State    Verifying SIL runtime...")
	go func() {
		defer setBusy(false)
		if !session.running.Load() {
			if e := session.start(cfg); e != nil {
				uiText(lblRunState, "State    QEMU start failed")
				uiMessage("Start QEMU failed", e.Error(), MB_OK|MB_ICONERROR)
				return
			}
		}
		if !waitReady(10 * time.Second) {
			uiText(lblRunState, "State    MSH timeout")
			uiMessage("RT-Thread not ready", "QEMU started but msh /> was not detected within 10 seconds.", MB_OK|MB_ICONERROR)
			return
		}
		if session.silReady.Load() {
			uiText(lblRunState, "State    SIL runtime ready")
			return
		}
		if e := session.send("sil_ping"); e != nil {
			uiMessage("SIL verify failed", e.Error(), MB_OK|MB_ICONERROR)
			return
		}
		if !waitSILReady(3 * time.Second) {
			uiText(lblRunState, "State    SIL runtime not detected")
			uiMessage("SIL runtime not detected", "RT-Thread is running, but the AI SIL runtime did not answer 'sil_ping'.\r\n\r\nAdd the files in rtthread_sil/ to the RT-Thread Studio project, rebuild rtthread.bin, then try again.", MB_OK|MB_ICONERROR)
			return
		}
		uiText(lblRunState, "State    SIL runtime verified")
	}()
}

func runCurrent() {
	cfg := captureConfig()
	currentCaseMu.Lock()
	tc := currentCase
	currentCaseMu.Unlock()
	setBusy(true)
	setText(lblRunState, "State    Starting GPIO test...")
	go func() {
		defer setBusy(false)
		if !session.running.Load() {
			if e := session.start(cfg); e != nil {
				uiText(lblRunState, "State    QEMU start failed")
				uiMessage("Start QEMU failed", e.Error(), MB_OK|MB_ICONERROR)
				return
			}
		}
		if !waitReady(10 * time.Second) {
			uiText(lblRunState, "State    MSH timeout")
			uiMessage("RT-Thread not ready", "QEMU started but msh > was not detected within 10 seconds.", MB_OK|MB_ICONERROR)
			return
		}
		if !session.silReady.Load() {
			_ = session.send("sil_ping")
			if !waitSILReady(2 * time.Second) {
				uiText(lblRunState, "State    SIL runtime not detected")
				uiMessage("SIL runtime not detected", "RT-Thread MSH is ready, but the GPIO SIL runtime did not answer sil_ping. Generate the GPIO MSH test and rebuild the firmware.", MB_OK|MB_ICONERROR)
				return
			}
		}
		uiText(edtResult, "RUNNING\r\n\r\nGPIO driver path: rt_pin_* -> drivers/drv_gpio.c -> virtual_gpio\r\nWaiting for @SIL,RESULT ...")
		faultCmd := "sil_gpio_fault_none"
		if tc.Fault == "stuck_low" {
			faultCmd = "sil_gpio_fault_stuck_low"
		}
		if tc.Fault == "stuck_high" {
			faultCmd = "sil_gpio_fault_stuck_high"
		}
		result := executeSILCase(tc.Pin, tc.Fault, "GPIO", faultCmd, fmt.Sprintf("ai_test_gpio %s", tc.Pin))
		switch {
		case result.ProtocolError != "":
			uiText(lblRunState, "State    GPIO transport/protocol error")
			uiText(edtResult, "PROTOCOL ERROR\r\n\r\n"+result.ProtocolError)
			logLine("PROTO", result.ProtocolError)
		case result.Timeout:
			uiText(lblRunState, "State    GPIO result timeout")
			uiText(edtResult, "TIMEOUT\r\n\r\nRESET、Fault 与命令回显均已确认，但没有收到匹配的 @SIL,RESULT。")
		default:
			uiText(lblRunState, "State    GPIO testcase completed")
		}
	}()
}
func drainMatrixResults() {
	for {
		select {
		case <-matrixResultCh:
			continue
		default:
			return
		}
	}
}

func drainSILProtocolEvents() {
	for {
		select {
		case <-silProtocolEventCh:
			continue
		default:
			return
		}
	}
}

func drainCommandEchoes() {
	for {
		select {
		case <-commandEchoCh:
			continue
		default:
			return
		}
	}
}

func (s *qemuSession) mockMode() bool {
	s.mu.Lock()
	defer s.mu.Unlock()
	return s.isMock
}

func waitCommandEcho(expected string, timeout time.Duration) (string, bool) {
	timer := time.NewTimer(timeout)
	defer timer.Stop()
	select {
	case echo := <-commandEchoCh:
		return strings.TrimSpace(echo), true
	case <-timer.C:
		return "", false
	}
}

func sendVerifiedCommand(line string) string {
	line = strings.TrimSpace(line)
	if line == "" {
		return ""
	}
	// The mock console is a pipe and intentionally does not echo stdin. Its
	// scanner already receives complete lines reliably, so echo verification is
	// only required for the real QEMU UART path.
	if session.mockMode() {
		if err := session.sendWithPace(line, 0); err != nil {
			return "SEND_FAILED: " + err.Error()
		}
		return ""
	}

	drainCommandEchoes()
	if err := session.sendWithPace(line, 2*time.Millisecond); err != nil {
		return "SEND_FAILED: " + err.Error()
	}
	echo, ok := waitCommandEcho(line, 1500*time.Millisecond)
	if !ok {
		return fmt.Sprintf("COMMAND_ECHO_TIMEOUT: expected %q but no MSH echo was observed", line)
	}
	if echo == line {
		logLine("UART", "echo verified: "+line)
		return ""
	}

	// A differing echo means the command was already submitted to MSH with
	// corrupted characters. Give the shell a moment to finish that command,
	// clear any resulting protocol frames, then retry once at a slower rate.
	logLine("UART", fmt.Sprintf("echo mismatch: expected=%q received=%q; retrying at 5ms/byte", line, echo))
	time.Sleep(120 * time.Millisecond)
	drainCommandEchoes()
	drainSILProtocolEvents()
	drainMatrixResults()
	if err := session.sendWithPace(line, 5*time.Millisecond); err != nil {
		return "COMMAND_RETRY_SEND_FAILED: " + err.Error()
	}
	retryEcho, retryOK := waitCommandEcho(line, 2*time.Second)
	if !retryOK {
		return fmt.Sprintf("COMMAND_ECHO_TIMEOUT_AFTER_RETRY: expected %q; first echo was %q", line, echo)
	}
	if retryEcho != line {
		return fmt.Sprintf("COMMAND_ECHO_MISMATCH: expected %q; received %q; retry received %q", line, echo, retryEcho)
	}
	logLine("UART", "echo verified after retry: "+line)
	return ""
}

func waitResetAck(timeout time.Duration) string {
	timer := time.NewTimer(timeout)
	defer timer.Stop()
	for {
		select {
		case ev := <-silProtocolEventCh:
			if ev.Type != "RESET" {
				continue
			}
			if strings.EqualFold(ev.Kind, "GPIO") && strings.EqualFold(ev.Value, "OK") {
				return ""
			}
			return fmt.Sprintf("RESET_ACK_MISMATCH: expected @SIL,RESET,GPIO,OK; received %s", ev.Raw)
		case <-timer.C:
			return "RESET_ACK_TIMEOUT: no @SIL,RESET,GPIO,OK received"
		}
	}
}

func waitFaultAck(expectedFault string, timeout time.Duration) string {
	timer := time.NewTimer(timeout)
	defer timer.Stop()
	for {
		select {
		case ev := <-silProtocolEventCh:
			if ev.Type != "FAULT" {
				continue
			}
			if strings.EqualFold(ev.Kind, "gpio") && ev.Fault == expectedFault {
				return ""
			}
			return fmt.Sprintf("FAULT_ACK_MISMATCH: expected fault=%s; received %s", expectedFault, ev.Raw)
		case <-timer.C:
			return fmt.Sprintf("FAULT_ACK_TIMEOUT: no @SIL,FAULT,gpio,%s received", expectedFault)
		}
	}
}

func waitMatrixResultKindDetailed(pin, fault, kind string, timeout time.Duration) silCaseExecResult {
	timer := time.NewTimer(timeout)
	defer timer.Stop()
	select {
	case r := <-matrixResultCh:
		if strings.EqualFold(r.Pin, pin) && r.Fault == fault && (kind == "" || r.Kind == kind) {
			return silCaseExecResult{Result: r}
		}
		return silCaseExecResult{ProtocolError: fmt.Sprintf(
			"RESULT_MISMATCH: expected kind=%s pin=%s fault=%s; received kind=%s pin=%s fault=%s",
			kind, pin, fault, r.Kind, r.Pin, r.Fault)}
	case <-timer.C:
		return silCaseExecResult{Timeout: true}
	}
}

func executeSILCase(pin, fault, kind, faultCmd, testCmd string) silCaseExecResult {
	// Begin every case from a clean host-side observation window.  The firmware
	// MSH is single-threaded, and RESET/FAULT ACKs provide the ordering barrier
	// that fixed sleeps could not guarantee.
	drainSILProtocolEvents()
	drainMatrixResults()

	if detail := sendVerifiedCommand("sil_reset"); detail != "" {
		return silCaseExecResult{ProtocolError: "RESET_" + detail}
	}
	if detail := waitResetAck(2 * time.Second); detail != "" {
		return silCaseExecResult{ProtocolError: detail}
	}

	// Any RESULT that predates the RESET ACK belongs to an earlier case.
	drainMatrixResults()
	if detail := sendVerifiedCommand(faultCmd); detail != "" {
		return silCaseExecResult{ProtocolError: "FAULT_" + detail}
	}
	if detail := waitFaultAck(fault, 2*time.Second); detail != "" {
		return silCaseExecResult{ProtocolError: detail}
	}

	// Start the test only after the requested fault state has been acknowledged.
	drainMatrixResults()
	if detail := sendVerifiedCommand(testCmd); detail != "" {
		return silCaseExecResult{ProtocolError: "TEST_" + detail}
	}
	return waitMatrixResultKindDetailed(pin, fault, kind, 4*time.Second)
}

func waitGeneratedProtocolEvent(eventType, capability, target, scenario string, timeout time.Duration) (silProtocolEvent, bool, string) {
	timer := time.NewTimer(timeout)
	defer timer.Stop()
	for {
		select {
		case ev := <-silProtocolEventCh:
			if ev.Type != eventType {
				continue
			}
			if !strings.EqualFold(ev.Kind, capability) {
				return ev, false, fmt.Sprintf("%s_MISMATCH: expected capability=%s; received %s", eventType, capability, ev.Raw)
			}
			if eventType == "GEN_RESULT" {
				if ev.Pin != target || !strings.EqualFold(ev.Fault, scenario) {
					return ev, false, fmt.Sprintf("GEN_RESULT_MISMATCH: expected target=%s scenario=%s; received %s", target, scenario, ev.Raw)
				}
			}
			return ev, true, ""
		case <-timer.C:
			return silProtocolEvent{}, false, eventType + "_TIMEOUT"
		}
	}
}

func executeGeneratedCase(m generatedCapabilityManifest, target, scenario string) silCaseExecResult {
	drainSILProtocolEvents()
	cmd := strings.TrimSpace(m.TestCommand) + " " + target + " " + scenario
	if detail := sendVerifiedCommand(cmd); detail != "" {
		return silCaseExecResult{ProtocolError: "TEST_" + detail}
	}
	ev, ok, detail := waitGeneratedProtocolEvent("GEN_RESULT", m.Capability, target, scenario, 6*time.Second)
	if !ok {
		if strings.HasSuffix(detail, "_TIMEOUT") {
			return silCaseExecResult{Timeout: true}
		}
		return silCaseExecResult{ProtocolError: detail}
	}
	verdict := strings.ToUpper(strings.TrimSpace(ev.Value))
	if verdict != "PASS" && verdict != "FAIL" {
		return silCaseExecResult{ProtocolError: "GEN_RESULT_INVALID_VERDICT: " + ev.Raw}
	}
	return silCaseExecResult{Result: gpioResult{Kind: "GENERIC", Pin: target, Fault: scenario, Verdict: verdict}}
}

func waitMatrixResult(pin, fault string, timeout time.Duration) (gpioResult, bool) {
	out := waitMatrixResultKindDetailed(pin, fault, "GPIO", timeout)
	return out.Result, !out.Timeout && out.ProtocolError == ""
}

func matrixSummary(pin string, rows []gpioResult, timedOut []string) (string, bool) {
	var b strings.Builder
	b.WriteString("GPIO FAULT MATRIX\r\n\r\n")
	b.WriteString("Driver   drivers/drv_gpio.c\r\n")
	b.WriteString("Pin      " + pin + "\r\n")
	b.WriteString("Backend  virtual_gpio\r\n\r\n")
	b.WriteString("Case  Fault        HIGH  LOW   Observed  Expected  Detection\r\n")
	b.WriteString("----  -----------  ----  ----  --------  --------  ---------\r\n")
	allOK := true
	for i, r := range rows {
		expected := "FAIL"
		if r.Fault == "none" {
			expected = "PASS"
		}
		detection := "OK"
		if r.Verdict != expected {
			detection = "MISMATCH"
			allOK = false
		}
		fmt.Fprintf(&b, "%02d    %-11s  %-4d  %-4d  %-8s  %-8s  %s\r\n", i+1, r.Fault, r.High, r.Low, r.Verdict, expected, detection)
	}
	for _, fault := range timedOut {
		allOK = false
		fmt.Fprintf(&b, "--    %-11s  --    --    TIMEOUT   --        MISSING RESULT\r\n", fault)
	}
	b.WriteString("\r\n")
	if allOK && len(rows) == 3 {
		b.WriteString("MATRIX VERDICT  PASS\r\n")
		b.WriteString("3/3 expected behaviors observed. Normal GPIO passes; stuck-low and stuck-high faults are detected.\r\n")
	} else {
		b.WriteString("MATRIX VERDICT  FAIL\r\n")
		fmt.Fprintf(&b, "%d/3 result(s) received; at least one expected behavior was missing or mismatched.\r\n", len(rows))
	}
	b.WriteString("\r\nNote: individual injected-fault cases intentionally produce functional FAIL; the matrix passes when those faults are correctly detected.")
	return b.String(), allOK && len(rows) == 3
}

func runFaultMatrix() {
	startedAt := time.Now()
	currentCaseMu.Lock()
	pin := currentCase.Pin
	currentCaseMu.Unlock()
	if strings.TrimSpace(pin) == "" {
		pin = "PB.0"
	}
	cfg := captureConfig()
	setBusy(true)
	matrixRunning.Store(true)
	drainMatrixResults()
	uiText(lblRunState, "State    Starting GPIO fault matrix...")
	uiRunSummary(3, "运行中", -1, 0)
	uiResultState("RUNNING", "正在准备 GPIO Fault Matrix", "Preparing QEMU / RT-Thread...")
	matrixStatus("GPIO Fault Matrix · 正在准备 QEMU / RT-Thread...")
	go func() {
		defer setBusy(false)
		defer matrixRunning.Store(false)
		if !session.running.Load() {
			if e := session.start(cfg); e != nil {
				uiText(lblRunState, "State    QEMU start failed")
				uiMessage("Start QEMU failed", e.Error(), MB_OK|MB_ICONERROR)
				return
			}
		}
		if !waitReady(10 * time.Second) {
			uiText(lblRunState, "State    MSH timeout")
			uiMessage("RT-Thread not ready", "QEMU started but msh > was not detected within 10 seconds.", MB_OK|MB_ICONERROR)
			return
		}
		if !session.silReady.Load() {
			_ = session.send("sil_ping")
			if !waitSILReady(2 * time.Second) {
				uiText(lblRunState, "State    SIL runtime not detected")
				uiMessage("SIL runtime not detected", "RT-Thread MSH is ready, but the GPIO SIL runtime did not answer sil_ping.", MB_OK|MB_ICONERROR)
				return
			}
		}

		cases := []struct{ fault, cmd string }{
			{"none", "sil_gpio_fault_none"},
			{"stuck_low", "sil_gpio_fault_stuck_low"},
			{"stuck_high", "sil_gpio_fault_stuck_high"},
		}
		rows := make([]gpioResult, 0, len(cases))
		timedOut := []string{}
		for i, c := range cases {
			uiText(lblRunState, fmt.Sprintf("State    Matrix %d/%d: %s", i+1, len(cases), c.fault))
			progress := fmt.Sprintf("GPIO FAULT MATRIX\r\n\r\nPin %s\r\nRunning %d/%d: %s\r\n\r\nOne firmware, no rebuild between cases.", pin, i+1, len(cases), c.fault)
			uiResultState("RUNNING", fmt.Sprintf("Matrix %d/%d · %s", i+1, len(cases), c.fault), progress)
			matrixStatus(fmt.Sprintf("Matrix %d/%d · %s", i+1, len(cases), c.fault))
			drainMatrixResults()
			for _, cmd := range []string{"sil_reset", c.cmd, fmt.Sprintf("ai_test_gpio %s", pin)} {
				if err := session.send(cmd); err != nil {
					uiMessage("Matrix send failed", err.Error(), MB_OK|MB_ICONERROR)
					return
				}
				time.Sleep(120 * time.Millisecond)
			}
			if r, ok := waitMatrixResult(pin, c.fault, 4*time.Second); ok {
				rows = append(rows, r)
			} else {
				timedOut = append(timedOut, c.fault)
			}
		}
		summary, ok := matrixSummary(pin, rows, timedOut)
		matrixRows, selectIndex := gpioRowsForMatrix(pin, rows, timedOut)
		setMatrixViewRows(matrixRows, selectIndex)
		if ok {
			uiResultState("PASS", "GPIO Fault Matrix 通过 · 预期故障均被检出", summary)
		} else {
			uiResultState("FAIL", "GPIO Fault Matrix 存在缺失或不一致结果", summary)
		}
		issues := len(timedOut)
		for _, r := range rows {
			expected := "FAIL"
			if r.Fault == "none" {
				expected = "PASS"
			}
			if r.Verdict != expected {
				issues++
			}
		}
		verdict := "FAIL"
		if ok {
			verdict = "PASS"
		}
		uiRunSummary(3, verdict, issues, time.Since(startedAt))
		if ok {
			uiText(lblRunState, "State    GPIO fault matrix PASS")
			logLine("MATRIX", "PASS GPIO "+pin+" 3/3 expected behaviors")
		} else {
			uiText(lblRunState, "State    GPIO fault matrix FAIL")
			logLine("MATRIX", fmt.Sprintf("FAIL GPIO %s results=%d timeouts=%d", pin, len(rows), len(timedOut)))
		}
	}()
}

func aiRun() { aiGenerateAndRun() }
func startQemuOnly() {
	showLogView("uart")
	uiText(edtUartConsole, "")
	cfg := captureConfig()
	setBusy(true)
	go func() {
		defer setBusy(false)
		if e := session.start(cfg); e != nil {
			uiMessage("Start QEMU failed", e.Error(), MB_OK|MB_ICONERROR)
			return
		}
		uiText(lblRunState, "State    QEMU started")
	}()
}

func sendMSHCommand() {
	showLogView("uart")
	line := strings.TrimSpace(getText(edtMshInput))
	if line == "" {
		return
	}
	if !session.running.Load() {
		message("QEMU is not running", "Start QEMU first, wait for the msh > prompt, then send an MSH command.", MB_OK|MB_ICONINFORMATION)
		return
	}
	setText(edtMshInput, "")
	go func(cmd string) {
		if err := session.send(cmd); err != nil {
			uiMessage("Send MSH failed", err.Error(), MB_OK|MB_ICONERROR)
			return
		}
		uiText(lblRunState, "State    MSH sent: "+cmd)
	}(line)
}

type aiSettingsSnapshot struct {
	ProviderIndex  int
	Provider       aiProviderConfig
	Endpoint       string
	APIKey         string
	PlannerModel   string
	CodegenModel   string
	RepairModel    string
	DiagnosisModel string
}

type aiConnectionTestResult struct {
	OK          bool
	Message     string
	Latency     time.Duration
	Models      []string
	Fingerprint string
}

func settingsSnapshotFromControls() aiSettingsSnapshot {
	idx := comboSelected(cmbSettingsProvider)
	p := aiProviderByIndex(idx)
	return aiSettingsSnapshot{
		ProviderIndex:  idx,
		Provider:       p,
		Endpoint:       strings.TrimSpace(getText(edtSettingsEndpoint)),
		APIKey:         strings.TrimSpace(getText(edtSettingsAPIKey)),
		PlannerModel:   strings.TrimSpace(getText(cmbSettingsPlannerModel)),
		CodegenModel:   strings.TrimSpace(getText(cmbSettingsCodegenModel)),
		RepairModel:    strings.TrimSpace(getText(cmbSettingsRepairModel)),
		DiagnosisModel: strings.TrimSpace(getText(cmbSettingsDiagnosisModel)),
	}
}

func defaultRoleModels(p aiProviderConfig) (string, string, string, string) {
	switch p.ID {
	case "gpt":
		return "gpt-5.6-luna", "gpt-5.6-sol", "gpt-5.6-sol", "gpt-5.6-luna"
	case "deepseek":
		return "deepseek-flash", "deepseek-v4-pro", "deepseek-v4-pro", "deepseek-flash"
	default:
		return p.DefaultModel, p.DefaultModel, p.DefaultModel, p.DefaultModel
	}
}

func replaceComboItems(hwnd uintptr, items []string, selected string) {
	if hwnd == 0 {
		return
	}
	procSendMessageW.Call(hwnd, CB_RESETCONTENT, 0, 0)
	seen := map[string]bool{}
	for _, item := range items {
		item = strings.TrimSpace(item)
		if item == "" || seen[item] {
			continue
		}
		seen[item] = true
		procSendMessageW.Call(hwnd, CB_ADDSTRING, 0, uintptr(unsafe.Pointer(utf16(item))))
	}
	if strings.TrimSpace(selected) != "" {
		setText(hwnd, selected)
	} else if len(items) > 0 {
		procSendMessageW.Call(hwnd, CB_SETCURSEL, 0, 0)
	}
}

func populateSettingsModels(models []string, preserve bool) {
	p := aiProviderByIndex(comboSelected(cmbSettingsProvider))
	items := models
	if len(items) == 0 {
		items = providerModelPresets(p)
	}
	planner, codegen, repair, diagnosis := defaultRoleModels(p)
	if preserve {
		if t := strings.TrimSpace(getText(cmbSettingsPlannerModel)); t != "" {
			planner = t
		}
		if t := strings.TrimSpace(getText(cmbSettingsCodegenModel)); t != "" {
			codegen = t
		}
		if t := strings.TrimSpace(getText(cmbSettingsRepairModel)); t != "" {
			repair = t
		}
		if t := strings.TrimSpace(getText(cmbSettingsDiagnosisModel)); t != "" {
			diagnosis = t
		}
	}
	replaceComboItems(cmbSettingsPlannerModel, items, planner)
	replaceComboItems(cmbSettingsCodegenModel, items, codegen)
	replaceComboItems(cmbSettingsRepairModel, items, repair)
	replaceComboItems(cmbSettingsDiagnosisModel, items, diagnosis)
}

func modelListEndpoint(p aiProviderConfig, endpoint string) string {
	e := strings.TrimRight(strings.TrimSpace(endpoint), "/")
	for _, suffix := range []string{"/responses", "/chat/completions", "/completions"} {
		if strings.HasSuffix(e, suffix) {
			return strings.TrimSuffix(e, suffix) + "/models"
		}
	}
	if strings.HasSuffix(e, "/v1") || strings.HasSuffix(e, "/v4") {
		return e + "/models"
	}
	if p.ID == "deepseek" && e == "https://api.deepseek.com" {
		return e + "/models"
	}
	return e + "/models"
}

func fetchAIModels(p aiProviderConfig, endpoint, key string) ([]string, error) {
	url := modelListEndpoint(p, endpoint)
	req, err := http.NewRequest("GET", url, nil)
	if err != nil {
		return nil, err
	}
	req.Header.Set("Authorization", "Bearer "+key)
	client := &http.Client{Timeout: 15 * time.Second}
	resp, err := client.Do(req)
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()
	raw, err := io.ReadAll(io.LimitReader(resp.Body, 2*1024*1024))
	if err != nil {
		return nil, err
	}
	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return nil, apiHTTPError(p.Label, resp.StatusCode, raw)
	}
	var out struct {
		Data []struct {
			ID string `json:"id"`
		} `json:"data"`
	}
	if err := json.Unmarshal(raw, &out); err != nil {
		return nil, err
	}
	models := make([]string, 0, len(out.Data))
	seen := map[string]bool{}
	for _, m := range out.Data {
		id := strings.TrimSpace(m.ID)
		if id != "" && !seen[id] {
			seen[id] = true
			models = append(models, id)
		}
	}
	return models, nil
}

func minimalInferenceTest(snap aiSettingsSnapshot) error {
	p := snap.Provider
	p.Endpoint = snap.Endpoint
	model := snap.PlannerModel
	if model == "" {
		model = p.DefaultModel
	}
	var body map[string]any
	if p.APIStyle == "responses_schema" {
		body = map[string]any{"model": model, "input": "Reply with exactly OK.", "max_output_tokens": 16}
	} else {
		body = map[string]any{"model": model, "messages": []map[string]any{{"role": "user", "content": "Reply with exactly OK."}}, "max_tokens": 16}
	}
	raw, status, err := httpPostJSON(p.Endpoint, snap.APIKey, body)
	if err != nil {
		return err
	}
	if status < 200 || status >= 300 {
		return apiHTTPError(p.Label, status, raw)
	}
	return nil
}

func runAIConnectionTest(snap aiSettingsSnapshot) aiConnectionTestResult {
	if strings.TrimSpace(snap.Endpoint) == "" {
		return aiConnectionTestResult{Message: "Endpoint 不能为空"}
	}
	if strings.TrimSpace(snap.APIKey) == "" {
		for _, env := range snap.Provider.EnvKeys {
			if v := strings.TrimSpace(os.Getenv(env)); v != "" {
				snap.APIKey = v
				break
			}
		}
	}
	if strings.TrimSpace(snap.APIKey) == "" {
		return aiConnectionTestResult{Message: "API Key 为空（也未找到 Provider 环境变量）"}
	}
	if strings.TrimSpace(snap.PlannerModel) == "" {
		return aiConnectionTestResult{Message: "Planner Model 不能为空"}
	}
	start := time.Now()
	models, modelErr := fetchAIModels(snap.Provider, snap.Endpoint, snap.APIKey)
	if len(models) > 0 {
		available := map[string]bool{}
		for _, m := range models {
			available[m] = true
		}
		for role, model := range map[string]string{"Planner": snap.PlannerModel, "CodeGen": snap.CodegenModel, "Repair": snap.RepairModel, "Diagnosis": snap.DiagnosisModel} {
			if strings.TrimSpace(model) != "" && !available[strings.TrimSpace(model)] {
				return aiConnectionTestResult{Message: fmt.Sprintf("%s Model %q 不在当前 Key 可用模型列表中", role, model), Latency: time.Since(start), Models: models}
			}
		}
	}
	if err := minimalInferenceTest(snap); err != nil {
		return aiConnectionTestResult{Message: err.Error(), Latency: time.Since(start), Models: models}
	}
	msg := "连接成功 · Planner 推理验证通过"
	if modelErr != nil {
		msg += " · 模型列表接口不可用，可手动填写 Model ID"
	}
	fp := aiSettingsFingerprint(snap.Provider.ID, snap.Endpoint, snap.APIKey, snap.PlannerModel, snap.CodegenModel, snap.RepairModel, snap.DiagnosisModel)
	return aiConnectionTestResult{OK: true, Message: msg, Latency: time.Since(start), Models: models, Fingerprint: fp}
}

func applySettingsProviderDefaults() {
	idx := comboSelected(cmbSettingsProvider)
	p := aiProviderByIndex(idx)
	setText(edtSettingsEndpoint, p.Endpoint)
	planner, codegen, repair, diagnosis := defaultRoleModels(p)
	replaceComboItems(cmbSettingsPlannerModel, providerModelPresets(p), planner)
	replaceComboItems(cmbSettingsCodegenModel, providerModelPresets(p), codegen)
	replaceComboItems(cmbSettingsRepairModel, providerModelPresets(p), repair)
	replaceComboItems(cmbSettingsDiagnosisModel, providerModelPresets(p), diagnosis)
	settingsVerifiedFingerprint = ""
	setText(lblSettingsStatus, "○ 未验证 · 请测试连接")
	setText(lblSettingsModels, "可用模型：使用预设；测试连接后会尝试从 Provider 获取")
}

func saveAISettings() {
	snap := settingsSnapshotFromControls()
	if snap.ProviderIndex < 0 {
		snap.ProviderIndex = 0
		snap.Provider = aiProviders[0]
	}
	procSendMessageW.Call(cmbAIProvider, CB_SETCURSEL, uintptr(snap.ProviderIndex), 0)
	setText(edtAIModel, snap.PlannerModel)
	setText(edtAPIKey, snap.APIKey)
	aiConfigMu.Lock()
	aiEndpointOverride = snap.Endpoint
	aiCodegenModel = snap.CodegenModel
	aiRepairModel = snap.RepairModel
	aiDiagnosisModel = snap.DiagnosisModel
	fingerprintKey := snap.APIKey
	if strings.TrimSpace(fingerprintKey) == "" {
		for _, env := range snap.Provider.EnvKeys {
			if v := strings.TrimSpace(os.Getenv(env)); v != "" {
				fingerprintKey = v
				break
			}
		}
	}
	fp := aiSettingsFingerprint(snap.Provider.ID, snap.Endpoint, fingerprintKey, snap.PlannerModel, snap.CodegenModel, snap.RepairModel, snap.DiagnosisModel)
	aiConnectionVerified = fp != "" && fp == settingsVerifiedFingerprint
	if aiConnectionVerified {
		aiConnectionStatus = "已连接"
	} else {
		aiConnectionStatus = "未验证"
		aiConnectionLatency = 0
	}
	aiAvailableModels = append([]string(nil), settingsDiscoveredModels...)
	aiConfigMu.Unlock()
	updateAIProviderUI(false)
	updateAISummary()
	logLine("AI", fmt.Sprintf("AI settings saved: provider=%s planner=%s codegen=%s repair=%s diagnosis=%s verified=%v", snap.Provider.Label, snap.PlannerModel, snap.CodegenModel, snap.RepairModel, snap.DiagnosisModel, fp == settingsVerifiedFingerprint))
}

func closeAISettings() {
	if hwndAISettings != 0 {
		procDestroyWindow.Call(hwndAISettings)
	}
}

func openAISettings() {
	if hwndAISettings != 0 {
		procSetForegroundWindow.Call(hwndAISettings)
		return
	}
	p := selectedAIProvider()
	planner := currentRoleModel("planner", p)
	codegen := currentRoleModel("codegen", p)
	repair := currentRoleModel("repair", p)
	diagnosis := currentRoleModel("diagnosis", p)
	endpoint := currentAIEndpoint(p)
	key := providerAPIKey(p)
	hInst, _, _ := procGetModuleHandleW.Call(0)
	style := uintptr(WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU)
	cls := utf16(settingsClassName)
	h, _, _ := procCreateWindowExW.Call(0, uintptr(unsafe.Pointer(cls)), uintptr(unsafe.Pointer(utf16("设置 · AI 服务"))), style, CW_USEDEFAULT, CW_USEDEFAULT, 650, 615, hwndMain, 0, hInst, 0)
	if h == 0 {
		message("AI 服务", "无法创建 AI 服务设置窗口。", MB_OK|MB_ICONERROR)
		return
	}
	hwndAISettings = h
	settingsLabel(h, "AI 服务", 28, 24, 180, 32, false)
	settingsLabel(h, "Provider / Key / Endpoint 与任务模型统一在这里配置；API Key 只保存在当前进程内存。", 28, 58, 570, 22, true)
	settingsLabel(h, "Provider", 28, 100, 110, 20, true)
	labels := []string{}
	for _, x := range aiProviders {
		labels = append(labels, x.Label)
	}
	cmbSettingsProvider = settingsCombo(h, labels, "", 160, 94, 420, 120, idAISettingsProvider, false)
	procSendMessageW.Call(cmbSettingsProvider, CB_SETCURSEL, uintptr(comboSelected(cmbAIProvider)), 0)
	settingsLabel(h, "API Endpoint", 28, 142, 110, 20, true)
	edtSettingsEndpoint = settingsEdit(h, endpoint, 160, 136, 420, 28, false)
	settingsLabel(h, "API Key", 28, 184, 110, 20, true)
	edtSettingsAPIKey = settingsEdit(h, key, 160, 178, 420, 28, true)
	procSendMessageW.Call(edtSettingsAPIKey, EM_SETLIMITTEXT, 1024, 0)
	settingsLabel(h, "Planner Model", 28, 238, 110, 20, true)
	cmbSettingsPlannerModel = settingsCombo(h, providerModelPresets(p), planner, 160, 232, 420, 160, 0, true)
	settingsLabel(h, "CodeGen Model", 28, 280, 110, 20, true)
	cmbSettingsCodegenModel = settingsCombo(h, providerModelPresets(p), codegen, 160, 274, 420, 160, 0, true)
	settingsLabel(h, "Repair Model", 28, 322, 110, 20, true)
	cmbSettingsRepairModel = settingsCombo(h, providerModelPresets(p), repair, 160, 316, 420, 160, 0, true)
	settingsLabel(h, "Diagnosis Model", 28, 364, 110, 20, true)
	cmbSettingsDiagnosisModel = settingsCombo(h, providerModelPresets(p), diagnosis, 160, 358, 420, 160, 0, true)
	btnSettingsTest = settingsButton(h, "测试连接并获取模型", idAISettingsTest, 28, 414, 190, 34, true)
	lblSettingsStatus = settingsLabel(h, "○ 未验证", 232, 420, 348, 24, true)
	lblSettingsModels = settingsLabel(h, "可用模型：测试连接后尝试获取；下拉框仍允许手动输入 Model ID", 28, 460, 552, 38, true)
	settingsLabel(h, "模型分工：Planner 生成 TestPlan；CodeGen 生成 SIL Harness；Repair 根据 Validator/编译错误修复；Diagnosis 只解释证据。", 28, 503, 552, 40, true)
	settingsButton(h, "保存", idAISettingsSave, 386, 548, 92, 34, true)
	settingsButton(h, "取消", idAISettingsCancel, 488, 548, 92, 34, false)
	settingsVerifiedFingerprint = ""
	settingsDiscoveredModels = nil
	aiConfigMu.Lock()
	if aiConnectionVerified {
		settingsVerifiedFingerprint = aiSettingsFingerprint(p.ID, endpoint, key, planner, codegen, repair, diagnosis)
		settingsDiscoveredModels = append([]string(nil), aiAvailableModels...)
		setText(lblSettingsStatus, fmt.Sprintf("● 已连接 · %.0f ms", aiConnectionLatency.Seconds()*1000))
		if len(settingsDiscoveredModels) > 0 {
			populateSettingsModels(settingsDiscoveredModels, true)
		}
	}
	aiConfigMu.Unlock()
	procShowWindow.Call(h, SW_SHOW)
	procUpdateWindow.Call(h)
}

func settingsWndProc(hwnd uintptr, msgID uint32, wParam, lParam uintptr) uintptr {
	switch msgID {
	case WM_DRAWITEM:
		if lParam != 0 {
			var dis drawItemStruct
			procRtlMoveMemory.Call(uintptr(unsafe.Pointer(&dis)), lParam, unsafe.Sizeof(dis))
			return drawModernButton(&dis)
		}
		return 0
	case WM_CTLCOLORSTATIC:
		if t, ok := controlThemes[lParam]; ok {
			procSetTextColor.Call(wParam, uintptr(t.fg))
			procSetBkColor.Call(wParam, uintptr(t.bg))
			return t.brush
		}
		procSetBkMode.Call(wParam, TRANSPARENT)
		return hBrushWhite
	case WM_CTLCOLOREDIT, WM_CTLCOLORLISTBOX:
		if t, ok := controlThemes[lParam]; ok {
			procSetTextColor.Call(wParam, uintptr(t.fg))
			procSetBkColor.Call(wParam, uintptr(t.bg))
			return t.brush
		}
		return hBrushField
	case WM_COMMAND:
		cmdID := loword(wParam)
		notifyCode := hiword(wParam)
		if cmdID == idAISettingsProvider && notifyCode == CBN_SELCHANGE {
			applySettingsProviderDefaults()
			return 0
		}
		if notifyCode != BN_CLICKED {
			return 0
		}
		switch cmdID {
		case idAISettingsTest:
			snap := settingsSnapshotFromControls()
			setText(lblSettingsStatus, "● 正在测试连接...")
			procEnableWindow.Call(btnSettingsTest, 0)
			go func(target uintptr, cfg aiSettingsSnapshot) {
				res := runAIConnectionTest(cfg)
				settingsTestMu.Lock()
				settingsLastTest = res
				settingsTestMu.Unlock()
				procPostMessageW.Call(target, WM_APP_AI_TEST_DONE, 0, 0)
			}(hwnd, snap)
		case idAISettingsSave:
			saveAISettings()
			closeAISettings()
		case idAISettingsCancel:
			closeAISettings()
		}
		return 0
	case WM_APP_AI_TEST_DONE:
		settingsTestMu.Lock()
		res := settingsLastTest
		settingsTestMu.Unlock()
		procEnableWindow.Call(btnSettingsTest, 1)
		if res.OK {
			logLine("AI", fmt.Sprintf("AI connection test PASS: latency=%s models=%d", res.Latency.Round(time.Millisecond), len(res.Models)))
			settingsVerifiedFingerprint = res.Fingerprint
			settingsDiscoveredModels = append([]string(nil), res.Models...)
			populateSettingsModels(res.Models, true)
			setText(lblSettingsStatus, fmt.Sprintf("● 已连接 · %.0f ms", res.Latency.Seconds()*1000))
			if len(res.Models) > 0 {
				setText(lblSettingsModels, fmt.Sprintf("可用模型：已获取 %d 个，可从下拉框选择；也可手动输入 Model ID", len(res.Models)))
			} else {
				setText(lblSettingsModels, "连接成功，但模型列表接口不可用；可继续使用当前/手动填写的 Model ID")
			}
		} else {
			logLine("AI", "AI connection test FAIL: "+res.Message)
			settingsVerifiedFingerprint = ""
			setText(lblSettingsStatus, "× 连接失败 · "+res.Message)
		}
		return 0
	case WM_CLOSE:
		procDestroyWindow.Call(hwnd)
		return 0
	case WM_DESTROY:
		if hwndAISettings == hwnd {
			hwndAISettings = 0
		}
		return 0
	}
	r, _, _ := procDefWindowProcW.Call(hwnd, uintptr(msgID), wParam, lParam)
	return r
}

func wndProc(hwnd uintptr, msgID uint32, wParam, lParam uintptr) uintptr {
	switch msgID {
	case WM_DRAWITEM:
		if lParam != 0 {
			var dis drawItemStruct
			procRtlMoveMemory.Call(uintptr(unsafe.Pointer(&dis)), lParam, unsafe.Sizeof(dis))
			return drawModernButton(&dis)
		}
		return 0
	case WM_CTLCOLORSTATIC:
		if t, ok := controlThemes[lParam]; ok {
			procSetTextColor.Call(wParam, uintptr(t.fg))
			procSetBkColor.Call(wParam, uintptr(t.bg))
			return t.brush
		}
		procSetBkMode.Call(wParam, TRANSPARENT)
		return hBrushBg
	case WM_CTLCOLOREDIT, WM_CTLCOLORLISTBOX:
		if t, ok := controlThemes[lParam]; ok {
			procSetTextColor.Call(wParam, uintptr(t.fg))
			procSetBkColor.Call(wParam, uintptr(t.bg))
			return t.brush
		}
		procSetTextColor.Call(wParam, uintptr(colorRef(25, 39, 62)))
		procSetBkColor.Call(wParam, uintptr(colorRef(255, 255, 255)))
		return hBrushField
	case WM_SIZE:
		clientW := int32(uint16(lParam & 0xffff))
		clientH := int32(uint16((lParam >> 16) & 0xffff))
		layoutWorkbench(clientW, clientH)
		return 0
	case WM_COMMAND:
		cmdID := loword(wParam)
		notifyCode := hiword(wParam)
		if cmdID == idMatrixList && notifyCode == LBN_SELCHANGE {
			handleMatrixSelection()
			return 0
		}
		if cmdID == idAIProvider && notifyCode == CBN_SELCHANGE {
			updateAIProviderUI(true)
			setText(edtAPIKey, "")
			return 0
		}
		if cmdID == idPrompt {
			if notifyCode == EN_CHANGE {
				refreshTestActionUI()
			}
			// EDIT controls also emit EN_UPDATE and other notifications while typing.
			// They must never fall through into button command dispatch.
			return 0
		}
		// All controls handled below are push buttons.  Dispatch them only for
		// BN_CLICKED so notifications from EDIT/LIST/COMBO controls can never
		// accidentally trigger an action even if a future ID is reused.
		if notifyCode != BN_CLICKED {
			return 0
		}
		switch cmdID {
		case idAIRun:
			aiRun()
		case idGenerate:
			generateCase()
		case idRun:
			runCurrent()
		case idInjectDrop:
			quickDrop()
		case idRunMatrix:
			runFaultMatrix()
		case idAIGeneratePlan:
			generateAIPlan()
		case idRunAIPlan:
			runAIPlan()
		case idAIDiagnose:
			diagnoseLastRun()
		case idExportReport:
			exportHTMLReport()
		case idExtendCapability:
			extendCurrentCapability()
		case idAISILEngineer:
			startAISILEngineer()
		case idSettingsOpen:
			openAISettings()
		case idStartQemu:
			startQemuOnly()
		case idStop:
			if engineerRunning.Load() {
				engineerStopRequested.Store(true)
				setText(lblRunState, "State    Stopping AI SIL Engineer after current operation...")
			}
			session.stop()
			if !engineerRunning.Load() {
				setText(lblRunState, "State    Stopped")
			}
		case idClearLog:
			clearActiveLog()
		case idPreflight:
			preflightTarget()
		case idVerifySIL:
			verifySILRuntime()
		case idBrowseQemu:
			browseQemu()
		case idBrowseFirmware:
			browseFirmware()
		case idBrowseProject:
			browseProject()
		case idAnalyzeProject:
			analyzeSelectedProject()
		case idGenerateCode:
			generateTestCode()
		case idBuildFirmware:
			buildSILFirmware()
		case idDetectFirmware:
			detectFirmwareAction()
		case idSendMsh:
			sendMSHCommand()
		case idShowBuild:
			showLogView("build")
		case idShowUart:
			showLogView("uart")
		case idShowAgent:
			showLogView("agent")
		case idPlanStructured:
			showPlanStructured()
		case idPlanJSON:
			showPlanJSON()
		}
		return 0
	case WM_APP_DRAIN_UI:
		drainUI()
		return 0
	case WM_DESTROY:
		session.stop()
		procPostQuitMessage.Call(0)
		return 0
	}
	r, _, _ := procDefWindowProcW.Call(hwnd, uintptr(msgID), wParam, lParam)
	return r
}

func buildUI() {
	// v0.9 modern operator workbench. Business logic is unchanged; the UI is
	// organized around Engineering Preparation -> Build -> QEMU -> Execute -> Result Analysis.
	mainBg := colorRef(245, 247, 251)
	white := colorRef(255, 255, 255)
	side := colorRef(15, 35, 62)
	sideActive := colorRef(31, 78, 140)
	textDark := colorRef(21, 34, 54)
	textMuted := colorRef(102, 116, 139)
	accent := colorRef(37, 99, 235)
	okColor := colorRef(22, 163, 74)
	warnColor := colorRef(217, 119, 6)
	soft := colorRef(241, 245, 249)

	// Sidebar: navigation/context only.
	panel(0, 0, 195, 960, side, hBrushSidebar)
	logo := themedLabel("AI SIL", 26, 24, 140, 31, colorRef(255, 255, 255), side, hBrushSidebar)
	setControlFont(logo, hFontSection)
	themedSmallLabel("Test Workbench", 26, 56, 145, 18, colorRef(172, 194, 220), side, hBrushSidebar)
	navActive := themedLabel("  ◇  测试工作台", 14, 105, 166, 40, colorRef(245, 249, 255), sideActive, hBrushSidebarActive)
