)

type testCase struct {
	Target string `json:"target"`
	Pin    string `json:"pin"`
	Fault  string `json:"fault"`
}

// aiTestPlan is the only object the LLM is allowed to produce for execution.
// The Workbench validates every field before compiling it into fixed MSH commands.
type aiTestPlan struct {
	Version             string       `json:"version"`
	Route               string       `json:"route"`
	RequestedDriver     string       `json:"requested_driver"`
	RequestedCapability string       `json:"requested_capability"`
	Reason              string       `json:"reason"`
	Driver              string       `json:"driver"`
	Target              string       `json:"target"`
	Cases               []aiPlanCase `json:"cases"`
}

type aiPlanCase struct {
	ID          string `json:"id"`
	Fault       string `json:"fault"`
	Expected    string `json:"expected"`
	Description string `json:"description"`
}

type aiPlanRunRow struct {
	Case    aiPlanCase `json:"case"`
	Result  gpioResult `json:"result"`
	Timeout bool       `json:"timeout"`
}

