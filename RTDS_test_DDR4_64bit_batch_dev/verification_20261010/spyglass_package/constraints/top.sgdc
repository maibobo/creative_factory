# Conservative initial clock setup for the unmodified TOP hierarchy.
# Distinct IP clocks remain separate even when their nominal frequencies match.
current_design TOP
clock -name clk_p -period 10 -edge {0 5}
clock -name clk_250m -period 4 -edge {0 2}
clock -name clk_100m -period 10 -edge {0 5}
clock -name clk_156m -period 6.4 -edge {0 3.2}
clock -name init_clk_25m -period 40 -edge {0 20}
clock -name aurora_user_clk -period 6.4 -edge {0 3.2}
clock -name aurora1g_user_clk -period 32 -edge {0 16}
clock -name u_pcie.design_1_wrapper_inst.design_1_i.xdma_0.axi_aclk -period 4 -edge {0 2}
clock -name u_pcie.u_rtds_ddr4_backend.ui_clk -period 3.333333 -edge {0 1.666666}
reset -name sys_rst -async -value 1
reset -name pcie_rst_n -async -value 0
reset -name aurora_user_rstn -async -value 0
reset -name aurora1g_user_reset -async -value 1
reset -name u_pcie.u_rtds_ddr4_backend.ui_clk_sync_rst -async -value 1

# Reviewed interface clock domains; IP interiors remain outside coverage.
abstract_port -module xpm_fifo_async -ports {din wr_en full prog_full wr_data_count overflow wr_rst_busy almost_full wr_ack} -clock wr_clk -reset rst -combo no
abstract_port -module xpm_fifo_async -ports {rd_en dout empty prog_empty rd_data_count underflow rd_rst_busy almost_empty data_valid sbiterr dbiterr} -clock rd_clk -reset rst -combo no
abstract_port -module xpm_fifo_async -ports {rst sleep injectsbiterr injectdbiterr} -clock wr_clk -combo no
abstract_port -module aurora_64b66b_top -ports {tx_d tx_sof tx_eof tx_rem tx_src_vld tx_dst_rdy rx_d rx_sof rx_eof rx_rem rx_src_vld rx_dst_rdy channel_up lane_up} -clock user_clk -reset sys_rst -combo no
abstract_port -module aurora_64b66b_top -ports {user_rstn} -clock user_clk -combo no
abstract_port -module aurora_8b10b_1p25g_design -ports {tx_data tx_rem tx_sof tx_eof tx_valid tx_ready rx_data rx_rem rx_sof rx_eof rx_valid channel_up rx_crc_error} -clock user_clk_out -reset reset -combo no
